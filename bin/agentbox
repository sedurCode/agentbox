# `local_model`: an agent in the sandbox using a model served on the host. Only Ollama + opencode for now;
# `provider` is there so other servers (and agents) can be added without changing the key.
# Claude profiles' `permission_mode`: Claude Code's auto mode (its classifier approves routine actions and
# blocks risky ones, a second layer inside the sandbox), or "bypass", which skips every permission check.
# Headless argv (`run`) and the interactive one (`up`, `resume`; `=` form, after sbx's `--`).
PERMISSION_MODES = {"auto": (["--permission-mode", "auto"], ["--permission-mode=auto"]),
                    "bypass": (["--dangerously-skip-permissions"], ["--dangerously-skip-permissions"])}
PERMISSION_MODE_AGENTS = {"claude"}

LOCAL_MODEL_PROVIDERS = {"ollama": 11434}    # provider -> default port
LOCAL_MODEL_AGENTS = {"opencode"}
LOCAL_MODEL_KEYS = {"provider", "model", "port", "context"}
# Ollama model names ("gemma4:12b", "hf.co/user/repo:Q4_K_M"): no spaces, quotes, `$`, `;`... It ends up
# in a JSON file and in an argv (always after `--model=`), never in a shell command.
LOCAL_MODEL_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,63}(/[A-Za-z0-9][A-Za-z0-9._-]{0,63}){0,3}"
                            r"(:[A-Za-z0-9][A-Za-z0-9._-]{0,63})?$")
LOCAL_MODEL_MIN_CONTEXT = 32768             # below this an agent's system prompt + tools + a few files don't fit
OPENCODE_PROVIDER = "ollama"                # provider id in the generated opencode config
VM_HOME = "/home/agent"                    # the agent user (uid 1000) in every sbx template
OPENCODE_CONFIG_VM = f"{VM_HOME}/.agentbox/opencode.json"


# ----------------------------------------------------------------- helpers
# Exit codes (documented in the README): scripts can rely on these.
EXIT_OK, EXIT_FAIL, EXIT_USAGE, EXIT_NO_SANDBOX = 0, 1, 2, 3
EXIT_TIMEOUT, EXIT_LOST = 4, 5          # `wait`: --timeout expired / the job's process is gone


# Text that came out of the VM (file names, git config values, agent output, sbx stderr) is
# agent-controlled. Printed raw on the host terminal, an escape sequence could rewrite the
# screen, set the title, or write the clipboard (OSC 52). safe_text() makes it visible instead.
UNSAFE_CHARS = re.compile("[\x00-\x08\x0b-\x1f\x7f-\x9f\u2028\u2029\u202a-\u202e\u2066-\u2069]")


def safe_text(s) -> str:
    """Escape C0 controls (except \\t and \\n, so ESC and CR too), DEL, C1 controls and the
    line-separator / bidi-override characters as \\xNN / \\uNNNN."""
    return UNSAFE_CHARS.sub(lambda m: f"\\x{ord(m.group()):02x}" if ord(m.group()) < 256
                            else f"\\u{ord(m.group()):04x}", str(s))


def die(msg: str, code: int = EXIT_FAIL):
    print(f"agentbox: {safe_text(msg)}", file=sys.stderr)
    sys.exit(code)


def info(msg: str):
    print(f"agentbox: {safe_text(msg)}", file=sys.stderr)


# ------------------------------------------------------ platform shim
# Everything that differs between POSIX and Windows hosts lives here; POSIX behaviour is unchanged.
IS_WIN = sys.platform == "win32"


def owner_only(path: str | Path, is_dir: bool = False):
    """Restrict a file or directory to the current user (chmod on POSIX, icacls on Windows)."""
    if not IS_WIN:
        os.chmod(path, 0o700 if is_dir else 0o600)
        return
    user = os.environ.get("USERNAME") or os.getlogin()
    perm = "(OI)(CI)F" if is_dir else "F"
    r = subprocess.run(["icacls", str(path), "/inheritance:r", "/grant:r", f"{user}:{perm}"],
                       capture_output=True, text=True)
    if r.returncode != 0:
        raise OSError(f"icacls failed on {path}: {r.stdout.strip() or r.stderr.strip()}")


def owned_by_me(path: Path) -> bool:
    """False only when we can tell the path belongs to someone else. Windows ownership is a SID, so
    there the check is best-effort: the directory is under the user's profile and locked down by
    owner_only()."""
    if IS_WIN:
        return True
    return path.stat().st_uid == os.getuid()


def detached_popen_kwargs() -> dict:
    """Popen kwargs that detach a child from this process and its terminal."""
    if not IS_WIN:
        return {"start_new_session": True}
    return {"creationflags": subprocess.CREATE_NEW_PROCESS_GROUP | subprocess.DETACHED_PROCESS
            | subprocess.CREATE_NO_WINDOW}


def process_cmdline(pid: int) -> list[str]:
    """The command line of a running process as a list of tokens, [] if there is no such process."""
    if not IS_WIN:
        return subprocess.run(["ps", "-p", str(pid), "-o", "command="],
                              capture_output=True, text=True).stdout.split()
    ps = f"(Get-CimInstance Win32_Process -Filter 'ProcessId={int(pid)}').CommandLine"
    return subprocess.run(["powershell", "-NoProfile", "-NonInteractive", "-Command", ps],
                          capture_output=True, text=True).stdout.replace('"', " ").split()


def terminate(pid: int):
    """Ask a process to stop: SIGTERM on POSIX; Windows has no SIGTERM, so end the process tree."""
    if not IS_WIN:
        os.kill(pid, signal.SIGTERM)
        return
    subprocess.run(["taskkill", "/PID", str(int(pid)), "/T", "/F"], capture_output=True)


def on_sigterm(handler):
    """Install a SIGTERM handler where the platform has SIGTERM semantics (not Windows)."""
    if not IS_WIN:
        signal.signal(signal.SIGTERM, handler)


# Environment passed to agentbox's own background children (bridge, keepalive): an allow-list, so that
# API keys and tokens in the user's environment never reach them. Windows has no HOME and Python and sbx
# need SystemRoot, USERPROFILE, LOCALAPPDATA and TEMP to start at all.
CHILD_ENV_KEYS = ("PATH", "HOME", "LANG", "USER", "AGENTBOX_CONFIG_DIR")
CHILD_ENV_KEYS_WIN = ("USERPROFILE", "HOMEDRIVE", "HOMEPATH", "SystemRoot", "SystemDrive", "TEMP", "TMP",
                      "APPDATA", "LOCALAPPDATA", "USERNAME", "PATHEXT", "ComSpec")


def child_env() -> dict:
    if not IS_WIN:
        return {k: v for k, v in os.environ.items() if k in CHILD_ENV_KEYS}
    keys = {k.upper() for k in CHILD_ENV_KEYS + CHILD_ENV_KEYS_WIN}          # env names are case-insensitive here
    return {k: v for k, v in os.environ.items() if k.upper() in keys}


def vm_path(p) -> str:
    r"""A host path as the Linux microVM sees it. sbx mounts D:\Neural\x at /d/Neural/x: the drive
    letter is lowercased, the rest is kept as is, backslashes become slashes. POSIX hosts: unchanged."""
    s = str(p)
    if not IS_WIN:
        return s
    m = re.match(r"^([A-Za-z]):(?:[\\/]+(.*))?$", s)
    if not m:
        die(f"cannot map {s} into the sandbox: only drive-letter paths are supported on Windows", EXIT_USAGE)
    return "/" + m.group(1).lower() + ("/" + m.group(2).replace("\\", "/") if m.group(2) else "")


def host_path(s: str) -> Path:
    r"""The host path for a path the agent gave us (the inverse of vm_path). The VM sees D:\x as /d/x. On
    Windows: /d/x -> D:\x, a drive-letter path and a relative path pass through, and any other absolute
    POSIX path (/etc/passwd, //server/share) is refused with ValueError: it is not a mounted host path.
    Callers still check the result against the workspace roots; this only does the mapping. POSIX hosts: as is."""
    if not IS_WIN:
        return Path(s)
    if re.match(r"^[A-Za-z]:", s):
        return Path(s)
    m = re.match(r"^/([A-Za-z])(?:/(.*))?$", s)
    if m:
        return Path(m.group(1).upper() + ":/" + (m.group(2) or ""))
    if s.startswith(("/", "\\")):
        raise ValueError(f"{s} is not a path on a mounted host drive")
    return Path(s)


def tool_base_env() -> dict:
    """The environment a host tool starts with: minimal, no inherited secrets. Per-tool `env` adds to it."""
    if not IS_WIN:
        return {"PATH": HOST_TOOL_PATH,
                "HOME": str(HOME), "LANG": os.environ.get("LANG", "en_US.UTF-8")}
    root = os.environ.get("SystemRoot", r"C:\Windows")
    env = {"PATH": f"{root}\\System32;{root}", "SystemRoot": root, "PATHEXT": ".COM;.EXE;.BAT;.CMD",
           "ComSpec": os.environ.get("ComSpec", f"{root}\\System32\\cmd.exe"), "USERPROFILE": str(HOME)}
    for k in ("SystemDrive", "TEMP", "TMP", "APPDATA", "LOCALAPPDATA", "ProgramData", "ProgramFiles",
              "ProgramFiles(x86)", "USERNAME", "NUMBER_OF_PROCESSORS", "PROCESSOR_ARCHITECTURE"):
        if k in os.environ:
            env[k] = os.environ[k]
    return env


def resolve_exe(exe: Path) -> Path:
    """exe itself, or on Windows exe plus a PATHEXT suffix (CreateProcess adds .exe, so `cc21k` means cc21k.exe)."""
    if IS_WIN and not exe.exists() and not exe.suffix:
        for ext in (".exe", ".com"):
            if exe.with_suffix(ext).exists():
                return exe.with_suffix(ext)
    return exe


def run_tool(argv: list, cwd, env: dict, timeout: int) -> tuple[int, bytes, bytes]:
    """Run a host tool; (exit code, stdout, stderr). On timeout the tool AND its children are stopped: cc21k and
    openocd start helper processes, and subprocess.run() only kills the direct child (on Windows)."""
    if not IS_WIN:
        try:
            p = subprocess.run(argv, cwd=cwd, env=env, capture_output=True, timeout=timeout,
                               stdin=subprocess.DEVNULL)
            return p.returncode, p.stdout, p.stderr
        except subprocess.TimeoutExpired as e:
            return 124, e.stdout or b"", (e.stderr or b"") + f"\n[agentbox] timed out after {timeout}s".encode()
    p = subprocess.Popen(argv, cwd=cwd, env=env, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                         stderr=subprocess.PIPE, creationflags=subprocess.CREATE_NO_WINDOW)
    try:
        out, err = p.communicate(timeout=timeout)
        return p.returncode, out, err
    except subprocess.TimeoutExpired:
        terminate(p.pid)
        out, err = p.communicate()
        return 124, out or b"", (err or b"") + f"\n[agentbox] timed out after {timeout}s".encode()


def xp(p: str | Path) -> Path:
    return Path(os.path.expandvars(os.path.expanduser(str(p)))).resolve()


def is_within(p: Path, root: Path) -> bool:
    return p == root or root in p.parents


def parse_workspace_spec(spec: str) -> tuple[Path, bool]:
    """'path', 'path:ro' or 'path:rw' -> (resolved path, read_only)."""
    ro = False
    if spec.endswith(":ro"):
        spec, ro = spec[:-3], True
    elif spec.endswith(":rw"):
        spec = spec[:-3]
    return xp(spec), ro


def sha256_file(p: Path) -> str:
    h = hashlib.sha256()
    with open(p, "rb") as f:
        for chunk in iter(lambda: f.read(65536), b""):
            h.update(chunk)
    return h.hexdigest()


# ------------------------------------------------------------------ config
class Config:
    def __init__(self):
        if not CONFIG_FILE.exists():
            die(f"no config at {CONFIG_FILE} - run install.sh or copy agentbox.example.toml there", EXIT_USAGE)
        self.raw = tomllib.loads(CONFIG_FILE.read_text())
        self.settings = {**DEFAULT_SETTINGS, **self.raw.get("settings", {})}
        self.tools = self.raw.get("tools", {})
        self.skillsets = self.raw.get("skillsets", {})
        for n, spec in self.skillsets.items():
            if not NAME_RE.match(n) or not isinstance(spec, dict):
                die(f"[skillsets.{n}]: the name must match {NAME_RE.pattern} and the entry must be a table", EXIT_USAGE)
        self.state_root = xp(self.settings["state_dir"])

    def profile_names(self):
        return sorted(self.raw.get("profiles", {}).keys())

    def profile(self, name: str) -> "Profile":
        return Profile(self, name, self.merged(name))

    def merged(self, name: str) -> dict:
        """The profile's settings: built-ins, then [defaults], then the profile (lists are unioned)."""
        profs = self.raw.get("profiles", {})
        if name not in profs:
            die(f"unknown profile '{name}'. Known: {', '.join(self.profile_names()) or '(none)'}", EXIT_USAGE)
        if not NAME_RE.match(name):
            die(f"profile name '{name}' must match {NAME_RE.pattern}", EXIT_USAGE)
        defaults = self.raw.get("defaults", {})
        merged = {**DEFAULT_PROFILE, **defaults, **profs[name]}
        for key in MERGED_LISTS:
            seen, out = set(), []
            for v in list(defaults.get(key, [])) + list(profs[name].get(key, [])):
                if v not in seen:
                    seen.add(v)
                    out.append(v)
            merged[key] = out
        return merged

    def host_tools_ports(self) -> dict[int, list[str]]:
        """Every host_tools_port in the file -> where it is set ("defaults" or profile names)."""
        out: dict[int, list[str]] = {}
        tables = [("defaults", self.raw.get("defaults", {}))] + list(self.raw.get("profiles", {}).items())
        for where, t in tables:
            v = t.get("host_tools_port") if isinstance(t, dict) else None
            if isinstance(v, int) and not isinstance(v, bool) and v:
                out.setdefault(v, []).append(where)
        return out


def local_model_problems(cfg: Config, d: dict) -> list[str]:
    """What is wrong with a profile's `local_model` (empty if it is fine or not set)."""
    lm = d.get("local_model")
    if lm is None:
        return []
    if not isinstance(lm, dict):
        return ["local_model must be a table: local_model = { provider = \"ollama\", model = \"...\", port = 11434 }"]
    out = []
    extra = sorted(set(lm) - LOCAL_MODEL_KEYS)
    if extra:
        out.append(f"local_model: unknown key(s) {', '.join(map(str, extra))} (known: {', '.join(sorted(LOCAL_MODEL_KEYS))})")
    provider = lm.get("provider")
    if provider not in LOCAL_MODEL_PROVIDERS:
        out.append(f"local_model.provider must be one of: {', '.join(LOCAL_MODEL_PROVIDERS)} (got {provider!r})")
    model = lm.get("model")
    if not isinstance(model, str) or not LOCAL_MODEL_RE.match(model):
        out.append(f"local_model.model must be a model name like \"gemma4:12b\" (letters, digits and . _ - / :),"
                   f" got {model!r}")
    port = lm.get("port", LOCAL_MODEL_PROVIDERS.get(provider, 0))
    if not isinstance(port, int) or isinstance(port, bool) or not 1 <= port <= 65535:
        out.append(f"local_model.port must be a number from 1 to 65535 (got {port!r})")
    else:
        users = cfg.host_tools_ports().get(port, [])
        if users:
            out.append(f"local_model.port {port} is also host_tools_port in {', '.join(users)}: the host-tool bridge"
                       " and the model server need different ports")
    ctx = lm.get("context", LOCAL_MODEL_MIN_CONTEXT)
    if not isinstance(ctx, int) or isinstance(ctx, bool) or not 2048 <= ctx <= 10_000_000:
        out.append(f"local_model.context must be a number of tokens from 2048 to 10000000 (got {ctx!r})")
    agent = d.get("agent")
    if agent not in LOCAL_MODEL_AGENTS:
        out.append(f"local_model is only supported with agent = \"opencode\" for now (this profile's agent is"
                   f" {agent!r}); remove local_model or switch the agent")
    return out


def permission_mode_problems(cfg: Config, name: str, d: dict) -> list[str]:
    """What is wrong with a profile's `permission_mode` (empty if fine or not set). A value from
    [defaults] applies to Claude profiles only; set in a non-Claude profile's own table it is an error."""
    out = []
    pm = d.get("permission_mode")
    if pm is not None and not (isinstance(pm, str) and pm in PERMISSION_MODES):
        out.append(f"permission_mode must be \"auto\" (the default: Claude Code's auto mode) or \"bypass\""
                   f" (--dangerously-skip-permissions), got {pm!r}")
    own = cfg.raw.get("profiles", {}).get(name)
    if isinstance(own, dict) and "permission_mode" in own and d.get("agent") not in PERMISSION_MODE_AGENTS:
        out.append(f"permission_mode is only for agent = \"claude\" (this profile's agent is {d.get('agent')!r});"
                   " remove it (opencode's --auto is unrelated and always on)")
    return out


class Profile:
    def __init__(self, cfg: Config, name: str, d: dict):
        self.cfg, self.name, self.d = cfg, name, d
        if not d.get("workspace"):
            die(f"profile '{name}' needs `workspace = \"...\"`", EXIT_USAGE)
        self.sandbox = f"{cfg.settings['name_prefix']}-{name}"
        self.state = cfg.state_root / self.sandbox
        self.primary = xp(d["workspace"])
        self.extras: list[tuple[Path, bool]] = [parse_workspace_spec(spec) for spec in d["extra_workspaces"]]
        skills = d["skills"]
        if not isinstance(skills, list) or not all(isinstance(x, str) for x in skills):
            die(f"profile '{name}': skills must be a list of skill set names", EXIT_USAGE)
        for sk in skills:
            if sk not in cfg.skillsets:
                die(f"profile '{name}': unknown skill set '{sk}'. Known: {', '.join(cfg.skillsets) or '(none)'}", EXIT_USAGE)
        self._skillsets: list[SkillSet] | None = None
        if d["mode"] not in ("direct", "clone"):
            die(f"profile '{name}': mode must be 'direct' or 'clone'", EXIT_USAGE)
        if not isinstance(d["enabled"], bool):
            die(f"profile '{name}': enabled must be true or false", EXIT_USAGE)
        self.enabled = d["enabled"]
        sa = d["stall_after"]
        if not isinstance(sa, int) or isinstance(sa, bool) or sa < 1:
            die(f"profile '{name}': stall_after must be a positive number of seconds", EXIT_USAGE)
        problems = local_model_problems(cfg, d) + permission_mode_problems(cfg, name, d)
        if problems:
            die(f"profile '{name}': " + "\n  ".join(problems), EXIT_USAGE)

    # all host paths the sandbox can see (and so the agent can write to, unless :ro)
    @property
    def roots(self) -> list[Path]:
        return [self.primary] + [p for p, _ in self.extras]

    @property
    def writable_roots(self) -> list[Path]:
        return [self.primary] + [p for p, ro in self.extras if not ro]

    @property
    def tool_names(self) -> list[str]:
        return list(self.d["host_tools"])

    @property
    def port(self) -> int:
        p = int(self.d.get("host_tools_port") or 0)
        if self.tool_names and not p:
            die(f"profile '{self.name}' lists host_tools but has no host_tools_port", EXIT_USAGE)
        return p

    @property
    def permission_mode(self) -> str | None:
        """"auto" or "bypass" for a Claude profile; None for any other agent."""
        return (self.d.get("permission_mode") or "auto") if self.d["agent"] in PERMISSION_MODE_AGENTS else None

    def mode_args(self, interactive: bool) -> list[str]:
        """The agent arguments that select the permission mode (none for agents without one)."""
        pm = self.permission_mode
        return list(PERMISSION_MODES[pm][1 if interactive else 0]) if pm else []

    @property
    def local_model(self) -> dict | None:
        """The validated `local_model`, with defaults filled in; None when the profile has none."""
        lm = self.d.get("local_model")
        if lm is None:
            return None
        return {"provider": lm["provider"], "model": lm["model"],
                "port": lm.get("port", LOCAL_MODEL_PROVIDERS[lm["provider"]]),
                "context": lm.get("context", LOCAL_MODEL_MIN_CONTEXT)}

    def agent_ref(self) -> str:
        a = self.d["agent"]
        if a in BUILTIN_AGENTS:
            return a
        return str(resolve_kit(a))

    def kit_paths(self) -> list[Path]:
        return [resolve_kit(k) for k in self.d["kits"]]

    @property
    def skillsets(self) -> "list[SkillSet]":
        """The profile's skill sets, inspected on the host (read-only; cached per Profile)."""
        if self._skillsets is None:
            self._skillsets = [inspect_skillset(self.cfg, n) for n in self.d["skills"]]
        return self._skillsets

    def skill_mounts(self) -> list[Path]:
        """Host paths mounted read-only for the skill sets (cheap: no filesystem walk)."""
        out: list[Path] = []
        for n in self.d["skills"]:
            p = skillset_path(self.cfg.skillsets[n])
            if p and p not in out:
                out.append(p)
        return out

    def skill_problems(self) -> list[str]:
        problems, owner = [], {}
        for ss in self.skillsets:
            problems += [f"skill set '{ss.name}': {p}" for p in ss.problems]
            for sk in ss.skills:
                if owner.setdefault(sk, ss.name) != ss.name:
                    problems.append(f"skill '{sk}' is in both set '{owner[sk]}' and set '{ss.name}'")
        return problems

    def require_skills(self):
        """Die unless every skill set passes. Always looks at the folders again: the host can change
        them (and the mount shows that at once) after this Profile was built."""
        self._skillsets = None
        problems = self.skill_problems()
        if problems:
            die(f"profile '{self.name}': skill sets refused:\n  - " + "\n  - ".join(problems), EXIT_USAGE)

    def skill_links(self) -> list[tuple[str, str]]:
        """(skill, VM path of its folder) for every skill of every set; the mount keeps the host path."""
        return [(sk, f"{vm_path(ss.path)}/{ss.folders[sk]}") for ss in self.skillsets for sk in ss.skills]


KIT_SYNTAX = "# syntax=docker/sandbox-kit:3"


def kit_descriptor(d: Path) -> Path:
    """A v3 kit directory's descriptor: <dir>/<dir name>.yaml (sbx names the kit after the directory)."""
    return d / f"{d.name}.yaml"


def is_kit_dir(d: Path) -> bool:
    return kit_descriptor(d).is_file()


def is_v2_kit_dir(d: Path) -> bool:
    """A kit in the old v2 grammar: sbx refuses to mix it with the v3 built-in agents. sbx reads a
    spec.yaml first, so a directory holding one is v2 even beside a v3 descriptor."""
    return (d / "spec.yaml").is_file()


def resolve_kit(ref: str) -> Path:
    """A kit is a name under ~/.config/agentbox/kits or a path. Kits live outside
    workspaces on purpose: a kit in the repo is agent-writable."""
    cand = KITS_DIR / ref
    p = cand if cand.is_dir() else xp(ref)
    if is_v2_kit_dir(p):
        hint = (f"move spec.yaml out of {p} (sbx reads it before {kit_descriptor(p).name})" if is_kit_dir(p)
                else f"rewrite it as {kit_descriptor(p).name} (kit spec v3), or reinstall agentbox to update the"
                     " bundled kits")
        die(f"kit '{ref}' ({p}) uses the v2 kit grammar (spec.yaml). sbx now ships its agents as v3 kits and"
            f" will not mix the two: {hint}. See README, \"Kits\".", EXIT_USAGE)
    if not is_kit_dir(p):
        die(f"kit '{ref}' not found (looked for {kit_descriptor(cand)} and {kit_descriptor(p)})", EXIT_USAGE)
    return p


# ------------------------------------------------------------- skill sets
# A skill set is ONE git work tree on the HOST (a fork of a skills repo), mounted read-only as a
# whole into the sandbox. `include` picks the folders that are skills; those are symlinked into
# ~/.claude/skills. Skills are instructions the agent follows, so a set the agent could write to
# would let one sandbox plant instructions for every other one. Nothing is copied.
# Everything below reads the folder with Python only (lstat, os.walk without following links).
class SkillSet:
    def __init__(self, name: str, path: Path | None = None, description: str = ""):
        self.name, self.path, self.description = name, path, description
        self.skills: list[str] = []             # skill names (last component of the folder)
        self.folders: dict[str, str] = {}       # skill name -> folder relative to the set root
        self.include: list[str] | None = None   # None = every immediate subfolder is a skill
        self.ref: str | None = None             # the pinned commit (40 hex), if any
        self.commit: str | None = None          # 40 hex, "unknown", or None when the folder is not a git work tree
        self.branch: str | None = None          # checked-out branch; None = detached or not a git work tree
        self.problems: list[str] = []
        self.allow_scripts: bool | list[str] = False


def skillset_path(spec: dict) -> Path | None:
    raw = spec.get("path")
    return xp(raw) if isinstance(raw, str) and raw.strip() else None


def writable_workspace_roots(cfg: Config) -> list[Path]:
    """Every host folder the agent can WRITE, from every profile (disabled ones too), read leniently
    from the raw config: a direct-mode primary workspace and any extra without :ro. A clone-mode
    primary does not count (sbx mounts the source read-only; the agent works on its own clone)."""
    roots = []
    defaults = cfg.raw.get("defaults", {})
    tables = [defaults] + list(cfg.raw.get("profiles", {}).values())
    for t in tables:
        if not isinstance(t, dict):
            continue
        mode = t.get("mode", defaults.get("mode", "direct") if isinstance(defaults, dict) else "direct")
        if isinstance(t.get("workspace"), str) and mode != "clone":
            roots.append(xp(t["workspace"]))
        for x in t.get("extra_workspaces", []):
            if isinstance(x, str):
                p, ro = parse_workspace_spec(x)
                if not ro:
                    roots.append(p)
    return roots


def skillset_location_problems(cfg: Config, path: Path) -> list[str]:
    """Where a skill set may live. `path` is resolved. Overlap is checked both ways: a writable
    workspace inside the set is as writable by the agent as a set inside a writable workspace."""
    problems = []
    for r in writable_workspace_roots(cfg):
        if is_within(path, r) or is_within(r, path):
            problems.append(f"overlaps workspace {r} (agent-writable)")
    if is_within(path, CONFIG_DIR.resolve()):
        problems.append(f"is inside the config dir {CONFIG_DIR}")
    for what, p in (("config file", CONFIG_FILE), ("kits dir", KITS_DIR), ("state dir", cfg.state_root)):
        if is_within(p.resolve(), path):
            problems.append(f"contains the {what} {p}")
    claude = (HOME / ".claude").resolve()
    if is_within(path, claude) or is_within(claude, path):
        problems.append(f"overlaps {HOME / '.claude'}")
    return problems


def _hex40(s: str) -> bool:
    return re.fullmatch(r"[0-9a-f]{40}", s) is not None


def _commit(v) -> str | None:
    """v if it is a full commit id (40 lowercase hex characters), else None."""
    return v if isinstance(v, str) and _hex40(v) else None


def git_head_of(root: Path) -> tuple[str | None, str | None]:
    """(commit, branch) of a git work tree's HEAD, read as text - never runs git.
    (None, None) = not a git repo. commit is "unknown" when HEAD cannot be resolved;
    branch is None for a detached HEAD."""
    g = root / ".git"
    if g.is_symlink():
        return None, None
    gd = git_dir_of(root)
    if gd is None:
        return None, None
    branch = None
    try:
        head = (gd / "HEAD").read_text().strip()
        if _hex40(head):
            return head, None
        m = re.fullmatch(r"ref:\s*(refs/[A-Za-z0-9._/-]+)", head)
        if m and ".." not in m.group(1):
            ref, common = m.group(1), gd
            branch = ref.removeprefix("refs/heads/")
            if (gd / "commondir").is_file():                 # linked worktree: refs live in the main git dir
                common = (gd / (gd / "commondir").read_text().strip()).resolve()
            for base in (gd, common):
                f = base / ref
                if f.is_file() and not f.is_symlink() and _hex40(f.read_text().strip()):
                    return f.read_text().strip(), branch
            if (common / "packed-refs").is_file():
                for line in (common / "packed-refs").read_text().splitlines():
                    parts = line.split()
                    if len(parts) == 2 and parts[1] == ref and _hex40(parts[0]):
                        return parts[0], branch
    except (OSError, ValueError):
        pass
    return "unknown", branch


def _capped(names: list[str], limit: int = 20) -> str:
    return ", ".join(names[:limit]) + (f" ... and {len(names) - limit} more" if len(names) > limit else "")


def check_include_path(root: Path, raw) -> tuple[str | None, str]:
    """(normalised relative path, "") or (None, why not) for one `include` entry: relative, no "..",
    every component an existing real directory (lstat, so a symlink at ANY level is refused)."""
    if not isinstance(raw, str) or not raw.strip():
        return None, "include entries must be non-empty strings"
    if IS_WIN:
        # Windows treats both separators alike and has drive letters: `C:\x` is absolute and `a\..\..\b` climbs out
        # of the set, though PurePosixPath sees neither (one odd component, no ".."). A colon is a drive letter
        # or an NTFS alternate data stream (`dir:stream`): never part of a plain folder path.
        if ":" in raw:
            return None, f"include path '{raw}' must be relative to the set"
        raw = raw.replace("\\", "/")
    rel = PurePosixPath(raw)
    if rel.is_absolute():
        return None, f"include path '{raw}' must be relative to the set"
    if ".." in rel.parts:
        return None, f"include path '{raw}' must not contain '..'"
    if not rel.parts:
        return None, f"include path '{raw}' names the set itself, not a folder in it"
    cur = root
    for part in rel.parts:
        cur = cur / part
        try:
            st = os.lstat(cur)
        except (OSError, ValueError):
            return None, f"include path '{raw}' does not exist"
        if stat.S_ISLNK(st.st_mode):
            return None, f"include path '{raw}' goes through a symlink ({cur.relative_to(root).as_posix()})"
        if not stat.S_ISDIR(st.st_mode):
            return None, f"include path '{raw}' is not a directory"
    if not is_within(cur.resolve(), root):
        return None, f"include path '{raw}' resolves outside the set"
    return rel.as_posix(), ""


def inspect_skillset(cfg: Config, name: str) -> SkillSet:
    """Check a [skillsets.<name>] against every rule and describe it. Never dies and never
    raises on the folder's content: problems are returned for the caller to refuse or report."""
    spec = cfg.skillsets[name]
    ss = SkillSet(name, description=str(spec.get("description", "")))
    raw = spec.get("path")
    if not isinstance(raw, str) or not raw.strip():
        ss.problems.append("needs `path = \"...\"`")
        return ss
    scripts = spec.get("allow_scripts", False)
    if isinstance(scripts, bool) or (isinstance(scripts, list) and all(isinstance(x, str) for x in scripts)):
        ss.allow_scripts = scripts
    else:
        ss.problems.append("allow_scripts must be true, false or a list of included paths")
        return ss
    ref = spec.get("ref")
    if ref is not None:
        if isinstance(ref, str) and _hex40(ref.lower()):
            ss.ref = ref.lower()
        else:
            ss.problems.append("ref must be a full commit: 40 hex characters")
    lit = Path(os.path.expandvars(os.path.expanduser(raw)))
    ss.path = lit
    if not lit.is_absolute():
        ss.problems.append(f"path {raw} must be absolute (or start with ~)")
    elif lit.is_symlink():
        ss.problems.append(f"{lit} is a symlink - point `path` at the real folder")
    elif not lit.exists():
        ss.problems.append(f"{lit} does not exist")
    elif not lit.is_dir():
        ss.problems.append(f"{lit} is not a directory")
    if ss.problems:
        return ss
    ss.path = path = lit.resolve()
    ss.problems += skillset_location_problems(cfg, path)
    ss.commit, ss.branch = git_head_of(path)
    if ss.ref and ss.commit != ss.ref:
        ss.problems.append(f"HEAD is {ss.commit or 'not a git work tree'} but ref pins {ss.ref}: check out the"
                           " pinned commit, or review the changes and update `ref`")

    folders = _select_skill_folders(spec, ss, path)          # {skill name: relative folder}
    links, bad_text = [], []
    for skill, rel in folders.items():
        specials: list[str] = []
        covered = ss.allow_scripts if isinstance(ss.allow_scripts, bool) else rel in ss.allow_scripts
        links += _walk_set(path / rel, path, covered, bad_text, specials)
        if specials:
            ss.problems.append(f"special files (not regular files): {_capped(specials)}")
        if not SKILL_NAME_RE.match(skill):
            ss.problems.append(f"folder '{rel}': a skill name must match {SKILL_NAME_RE.pattern}")
        elif skill in BUILTIN_SKILLS:
            ss.problems.append(f"skill '{skill}' would shadow a built-in Claude Code skill")
        elif not (path / rel / "SKILL.md").is_file() or (path / rel / "SKILL.md").is_symlink():
            ss.problems.append(f"skill '{skill}' has no SKILL.md")
        else:
            ss.skills.append(skill)
            ss.folders[skill] = rel
    links += _top_level_links(path) if ss.include is None else []
    if links:
        ss.problems.append(f"symlinks are not allowed: {_capped(links)}")
    if bad_text:
        ss.problems.append("files that are not plain text (allowed: .md .txt .json .yaml .yml LICENSE*, none executable;"
                           f" set allow_scripts to accept others): {_capped(bad_text)}")
    return ss


def _select_skill_folders(spec: dict, ss: SkillSet, path: Path) -> dict[str, str]:
    """{skill name: folder relative to the set} - the `include` list, or every immediate subfolder
    when there is none. Problems go to ss.problems. Files outside these folders are never looked at."""
    inc = spec.get("include")
    allow = ss.allow_scripts
    if inc is None:
        if isinstance(allow, list):
            ss.problems.append("allow_scripts as a list names included paths, but there is no `include`")
        out = {}
        for entry in sorted(os.listdir(path)):
            st = os.lstat(path / entry)
            if stat.S_ISDIR(st.st_mode) and not entry.startswith("."):      # .git etc. are not skills
                out[entry] = entry
        return out
    if not isinstance(inc, list) or not inc or not all(isinstance(x, str) for x in inc):
        ss.problems.append("include must be a non-empty list of relative folder paths")
        return {}
    ss.include, out = [], {}
    for raw in inc:
        rel, why = check_include_path(path, raw)
        if rel is None:
            ss.problems.append(why)
            continue
        ss.include.append(rel)
        leaf = PurePosixPath(rel).name
        if leaf in out:
            ss.problems.append(f"include has two folders named '{leaf}': {out[leaf]} and {rel}")
        else:
            out[leaf] = rel
    if isinstance(allow, list):
        norm = [PurePosixPath(x).as_posix() for x in allow]
        for raw, n in zip(allow, norm):
            if n not in ss.include:
                ss.problems.append(f"allow_scripts names '{raw}', which is not in include")
        ss.allow_scripts = norm
    return out


def _top_level_links(path: Path) -> list[str]:
    """Symlinks directly in a flat set (a set without `include` has no business holding any)."""
    return [e for e in sorted(os.listdir(path)) if stat.S_ISLNK(os.lstat(path / e).st_mode)]


def _walk_set(top: Path, root: Path, allow_other: bool, bad_text: list, specials: list) -> list[str]:
    """Walk one folder of a set without following links. Returns the symlinks found (relative to the
    set); appends non-text / executable files to bad_text and non-regular files to specials."""
    links = []
    for dirpath, dirnames, filenames in os.walk(top, followlinks=False):
        for n in dirnames + filenames:
            full = Path(dirpath) / n
            rel = full.relative_to(root).as_posix()      # repo-relative: always "/", like `include` entries
            st = os.lstat(full)
            if stat.S_ISLNK(st.st_mode):
                links.append(rel)
            elif stat.S_ISDIR(st.st_mode):
                continue
            elif not stat.S_ISREG(st.st_mode):
                specials.append(rel)
            elif not allow_other and (st.st_mode & 0o111
                                      or not (n.lower().endswith(SKILL_TEXT_SUFFIXES) or n.startswith("LICENSE"))):
                bad_text.append(rel)
    return links


SKILL_HEADS_FILE = "skills.heads"      # in the profile's state dir: each set's HEAD when the sandbox was created


def recorded_skill_heads(prof: Profile) -> dict:
    try:
        v = json.loads((prof.state / SKILL_HEADS_FILE).read_text())
    except (OSError, ValueError):
        return {}
    return v if isinstance(v, dict) else {}


def record_skill_heads(prof: Profile):
    (prof.state / SKILL_HEADS_FILE).write_text(
        json.dumps({ss.name: {"commit": ss.commit, "branch": ss.branch} for ss in prof.skillsets}))


def skill_drift(prof: Profile, ss: SkillSet) -> tuple[str, list[str]]:
    """(state, warnings). state: pinned | mismatch (ref set) or unchanged | changed | unrecorded.
    A pinned set cannot drift: a HEAD that is not `ref` is a refusal, not a warning."""
    if ss.ref:
        return ("pinned" if ss.commit == ss.ref else "mismatch"), []
    rec = recorded_skill_heads(prof).get(ss.name)
    if not isinstance(rec, dict):
        return "unrecorded", []
    warns, old, new = [], rec.get("commit"), ss.commit
    live = "The mount is live, so running sandboxes already see the new content."
    if old != new:
        w = f"skill set {ss.name}: HEAD of {ss.path} was {old} when the sandbox was created and is now {new}. {live}"
        if isinstance(old, str) and isinstance(new, str) and _hex40(old) and _hex40(new):
            paths = ss.include if ss.include is not None else ["."]
            w += f" Review: git -C {shlex.quote(str(ss.path))} diff {old} {new} -- {' '.join(map(shlex.quote, paths))}"
        warns.append(w)
    if rec.get("branch") != ss.branch:
        warns.append(f"skill set {ss.name}: the checked-out branch of {ss.path} was {rec.get('branch') or '(detached)'}"
                     f" when the sandbox was created and is now {ss.branch or '(detached)'}. {live}")
    return ("changed" if warns else "unchanged"), warns


def warn_skill_drift(prof: Profile):
    for ss in prof.skillsets:
        for w in skill_drift(prof, ss)[1]:
            info("WARNING: " + w)


# --------------------------------------------------------------- sbx shell
NO_SSH_AGENT_SOCK = r"C:\agentbox-no-ssh-agent"      # deliberately nonexistent


def sbx_env(cfg: Config) -> dict:
    env = dict(os.environ)
    if not cfg.settings["forward_ssh_agent"]:
        # sbx forwards the host SSH agent when SSH_AUTH_SOCK is set; that would
        # let the agent authenticate as you anywhere your keys work.
        if IS_WIN:
            # Unset is NOT safe on Windows: sbx then falls back to the Windows OpenSSH agent (named
            # pipe) and the sandbox can use its keys. Any path, even a dead one, forwards nothing.
            env["SSH_AUTH_SOCK"] = NO_SSH_AGENT_SOCK
        else:
            env.pop("SSH_AUTH_SOCK", None)
    return env


SECRET_FLAGS = {"--value", "--token", "-t", "--password"}


def redact(cmd: list[str]) -> str:
    """For logs and error messages: hide the argument after any value-carrying flag."""
    out, hide = [], False
    for a in cmd:
        if hide:
            out.append("<redacted>")
            hide = False
            continue
        flag, eq, _ = a.partition("=")
        if flag in SECRET_FLAGS:
            if eq:
                out.append(f"{flag}=<redacted>")
            else:
                out.append(a)
                hide = True
            continue
        out.append(a)
    return shlex.join(out)


def sbx(cfg: Config, *args, check=True, capture=False, stdin=None):
    cmd = [cfg.settings["sbx"], *[str(a) for a in args]]
    if any(a.partition("=")[0] in SECRET_FLAGS for a in cmd[1:]):
        # Belt and braces: agentbox itself never passes secret values on argv
        # (visible to `ps` and process inspection), so refuse if anything tries to.
        die("internal error: refusing to pass a secret value on the sbx command line")
    if cfg.settings["verbose"]:
        info("+ " + redact(cmd))
    try:
        if stdin is not None:
            # Text mode would turn \n into \r\n on Windows and corrupt scripts and files sent into the
            # Linux VM (a `#!/bin/sh\r` shebang). Send bytes and decode the answer ourselves.
            r = subprocess.run(cmd, env=sbx_env(cfg), check=check, capture_output=capture,
                               input=stdin.encode("utf-8"))
            if capture:
                r.stdout = (r.stdout or b"").decode("utf-8", "replace").replace("\r\n", "\n")
                r.stderr = (r.stderr or b"").decode("utf-8", "replace").replace("\r\n", "\n")
            return r
        return subprocess.run(cmd, env=sbx_env(cfg), check=check, text=True, encoding="utf-8", errors="replace",
                              capture_output=capture)
    except FileNotFoundError:
        die(f"'{cfg.settings['sbx']}' not found - install Docker Sandboxes (macOS: brew trust docker/tap && brew install docker/tap/sbx; Linux: docs.docker.com/sandboxes)")
    except subprocess.CalledProcessError as e:
        err = e.stderr.decode("utf-8", "replace") if isinstance(e.stderr, bytes) else e.stderr
        die(f"`{redact(cmd)}` failed (exit {e.returncode})" + (f"\n{err}" if err else ""))


TRANSIENT_MARKERS = ("context deadline exceeded", "connection reset", "connection refused")


def is_transient(r) -> bool:
    """True if a finished sbx call failed in a way worth retrying (daemon hiccup, not a real answer)."""
    text = ((r.stderr or "") + (r.stdout or "")).lower()
    return r.returncode != 0 and any(m in text for m in TRANSIENT_MARKERS)


def backoff_delay(attempt: int, base: float = 1.0, cap: float = 15.0) -> float:
    return min(cap, base * 2 ** attempt)


def retry_transient(call, attempts: int = 5):
    """Run call() -> CompletedProcess, retrying transient failures with bounded exponential backoff.
    Permanent failures and success return immediately; the last result is returned as is."""
    for i in range(attempts):
        r = call()
        if r.returncode == 0 or not is_transient(r) or i == attempts - 1:
            return r
        delay = backoff_delay(i)
        info(f"sbx daemon error (transient); retrying in {delay:g}s ({i + 1}/{attempts - 1})")
        time.sleep(delay)


def sbx_retry(cfg: Config, *args, stdin=None, attempts: int = 5):
    return retry_transient(lambda: sbx(cfg, *args, check=False, capture=True, stdin=stdin), attempts)


def sandbox_exists(prof: Profile, retry: bool = False) -> bool:
    if retry:       # a daemon hiccup must not read as "no such sandbox"
        return sbx_retry(prof.cfg, "inspect", prof.sandbox).returncode == 0
    r = sbx(prof.cfg, "inspect", prof.sandbox, check=False, capture=True)
    return r.returncode == 0


def sandbox_states(cfg: Config) -> dict | None:
    """{sandbox name: "running" | "stopped" | "unknown"} from one `sbx ls --json`, or None if the
    call failed. Unlike `sbx exec` (which starts a stopped sandbox), asking has no side effects."""
    r = sbx_retry(cfg, "ls", "--json")
    if r.returncode != 0:
        return None
    try:
        rows = json.loads(r.stdout or "[]")
    except ValueError:
        return None
    if not isinstance(rows, list):
        return None
    return {row["name"]: row["status"] if row.get("status") in ("running", "stopped") else "unknown"
            for row in rows if isinstance(row, dict) and isinstance(row.get("name"), str)}


_FETCH = object()      # "ask sbx" (None is taken: it means a listing that failed)


def sandbox_state(prof: Profile, states=_FETCH) -> str:
    """"running" | "stopped" | "missing" | "unknown". Pass the result of sandbox_states() to reuse
    one listing across profiles."""
    if states is _FETCH:
        states = sandbox_states(prof.cfg)
    if states is None:
        return "unknown"
    return states.get(prof.sandbox, "missing")


# ----------------------------------------------------- generated kit (YAML)
def yaml_dump(obj, indent=0) -> str:
    """Tiny YAML emitter; scalars are JSON-quoted (valid YAML)."""
    pad = "  " * indent
    out = []
    if isinstance(obj, dict):
        for k, v in obj.items():
            if isinstance(v, (dict, list)) and v:
                out.append(f"{pad}{k}:")
                out.append(yaml_dump(v, indent + 1))
            else:
                out.append(f"{pad}{k}: {json.dumps(v) if not isinstance(v, (dict, list)) else ('{}' if isinstance(v, dict) else '[]')}")
    elif isinstance(obj, list):
        for v in obj:
            if isinstance(v, dict):
                lines = yaml_dump(v, indent + 1).split("\n")
                out.append(f"{pad}- {lines[0].lstrip()}")
                out.extend(lines[1:])
            else:
                out.append(f"{pad}- {json.dumps(v)}")
    return "\n".join(out)


def tool_summary(cfg: Config, names: list[str]) -> str:
    lines = []
    for n in names:
        t = cfg.tools.get(n, {})
        params = t.get("params", {})
        ps = " ".join(f"{k}=<{v.get('type', 'string')}{'' if v.get('required', 'default' not in v) else '?'}>"
                      for k, v in params.items())
        extra = " [-- extra args]" if t.get("extra_args") else ""
        lines.append(f"- `hosttool {n} {ps}{extra}`".rstrip() + f" - {t.get('description', '')}")
    return "\n".join(lines)


def opencode_config(lm: dict) -> dict:
    """opencode's config for a model on the host: an OpenAI-compatible provider at the host's Ollama
    (`/v1`), and that model as the default (`small_model` too, so session titles stay local). Format:
    opencode 1.x (`provider.<id>.npm/options/models`; checked against opencode 1.19.6 and
    opencode.ai/v1/docs/providers). `limit` tells opencode when to compact; Ollama's own context
    setting has to be at least as large (see `doctor`)."""
    ref = f"{OPENCODE_PROVIDER}/{lm['model']}"
    return {
        "$schema": "https://opencode.ai/config.json",
        "provider": {OPENCODE_PROVIDER: {
            "npm": "@ai-sdk/openai-compatible",
            "name": "Ollama on the host (agentbox)",
            "options": {"baseURL": f"http://host.docker.internal:{lm['port']}/v1"},
            "models": {lm["model"]: {"name": lm["model"], "tool_call": True,
                                     "limit": {"context": lm["context"], "output": min(8192, lm["context"] // 4)}}},
        }},
        "model": ref,
        "small_model": ref,
        "autoupdate": False,
        "share": "disabled",
    }


KIT_ARG_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*$")
LOCAL_KIT_NAME = "agentbox"


def _no_kit_placeholders(prof: "Profile", values: list[str]):
    """sbx expands `${{ ... }}` anywhere in a v3 descriptor, so a profile value holding one would be
    read as a kit reference (and refused). Say so plainly instead of letting sbx fail at create."""
    for v in values:
        if "${{" in str(v):
            die(f"profile '{prof.name}': '${{{{' is reserved by the sbx kit format; remove it from env,"
                " allow/deny or instructions", EXIT_USAGE)


def local_kit_spec(prof: Profile, token: str) -> tuple[dict, dict]:
    """The per-sandbox mixin as a kit spec v3 descriptor (dict), and the files it writes in the VM
    ({VM path: content}; they are inline in the descriptor too)."""
    cfg = prof.cfg
    allow = list(prof.d["allow"])
    if prof.d.get("vscode"):
        allow += [h for h in VSCODE_HOSTS if h not in allow]
    env = {str(k): str(v) for k, v in prof.d["env"].items()}
    env["AGENTBOX_PROFILE"] = prof.name
    instructions = [
        "# Sandbox rules (agentbox)",
        "You are running inside a Docker Sandboxes microVM managed by agentbox.",
        "- Network egress is allow-listed; if a host is blocked, say so and ask the user - do not try to work around it.",
        "- There are no git push credentials or production secrets in here, by design. Commit locally; the user reviews and pushes.",
        "- Do not edit git hooks, CI config, editor task files or anything under .sbx/ unless asked; these are reviewed separately.",
    ]
    startup = []
    files = {}
    if prof.tool_names:
        allow.append(f"localhost:{prof.port}")
        env["HOSTTOOLS_URL"] = f"http://host.docker.internal:{prof.port}"
        env["HOSTTOOLS_TOKEN"] = token
        files[f"{VM_HOME}/.agentbox/hosttool"] = (SHARE_DIR / "hosttool").read_text()
        # Runtime-written files belong to the agent and land after install hooks, so a root
        # startup hook (every boot; idempotent) puts the client on PATH. The sbx agent templates
        # ship python3, which it needs.
        startup.append({
            "command": f"install -m 0755 {VM_HOME}/.agentbox/hosttool /usr/local/bin/hosttool",
            "user": "0",
            "description": "Install agentbox hosttool client",
        })
        instructions += [
            "",
            "## Host tools",
            "Some tools run on the user's host machine (hardware access, licensed tools). Call them with `hosttool`;"
            " run `hosttool list` for details. Run it from inside the workspace - paths are checked against it.",
            tool_summary(cfg, prof.tool_names),
            "Host tools are deliberately narrow. If you need something they don't allow, ask the user.",
        ]
    lm = prof.local_model
    if lm:
        # The one host port this sandbox may reach for the model. Opt-in per profile: sbx's global policy
        # keeps the host's localhost closed otherwise.
        if f"localhost:{lm['port']}" not in allow:
            allow.append(f"localhost:{lm['port']}")
        files[OPENCODE_CONFIG_VM] = json.dumps(opencode_config(lm), indent=2) + "\n"
        env["OPENCODE_CONFIG"] = OPENCODE_CONFIG_VM
        env["OPENCODE_DISABLE_AUTOUPDATE"] = "1"
        env["OPENCODE_DISABLE_MODELS_FETCH"] = "1"     # models.dev isn't on the allow-list; the model is in the config
        instructions += [
            "",
            "## Local model",
            f"You are running on {lm['model']}, served by {lm['provider']} on the user's machine at"
            f" http://host.docker.internal:{lm['port']}/v1. That port is the only one on the host you can reach."
            f" Your context window is about {lm['context']} tokens: read files in parts and keep tool output short.",
        ]
    mounts = prof.skill_mounts()
    if mounts:
        instructions += ["", "## Skill sets",
                         "Read-only skill sets from the user's host are mounted at " + ", ".join(map(vm_path, mounts))
                         + " and linked into ~/.claude/skills. They are read-only: do not try to edit them,"
                           " ask the user. Skills you write yourself go in ~/.claude/skills as normal folders."]
    if prof.d.get("instructions"):
        instructions += ["", prof.d["instructions"]]
    allow = list(dict.fromkeys(allow))
    for name, value in env.items():
        if not KIT_ARG_RE.match(name):
            die(f"profile '{prof.name}': env name '{name}' is not a valid variable name", EXIT_USAGE)
    _no_kit_placeholders(prof, list(env.values()) + allow + list(prof.d["deny"]) + instructions
                         + list(files.values()))
    network = {k: v for k, v in (("allow", allow), ("deny", list(prof.d["deny"]))) if v}
    lifecycle = {}
    if startup:
        lifecycle["startup"] = startup
    if files:
        lifecycle["files"] = [{"path": path, "content": body, "description": "agentbox"}
                              for path, body in files.items()]
    caps = []
    if network:
        caps.append({"type": "com.docker.sandbox/network-policy@1", "config": {"runtime": network}})
    if lifecycle:
        caps.append({"type": "com.docker.sandbox/lifecycle@1", "config": lifecycle})
    caps.append({"type": "com.docker.sandbox/agent-context@2",
                 "config": {"content": "\n".join(instructions) + "\n"}})
    # Kit spec v3, declaration-only (no recipe, so sbx needs no image build). A declaration-only
    # mixin has no image config for ENV: each variable is a create-phase arg exported under its name.
    spec = {
        "schemaVersion": "3",
        "kind": "mixin",
        "version": "1.0.0",
        "displayName": f"agentbox {prof.name}",
        "description": ("agentbox sandbox rules: network, git and host tools. Read before you start any task."),
    }
    if env:
        spec["args"] = {k: {"default": v, "env": k} for k, v in env.items()}
    spec["capabilities"] = caps
    return spec, files


def render_local_kit(prof: Profile, token: str) -> tuple[str, str]:
    """Per-sandbox mixin: network allow/deny, env, host-tool client, instructions.
    Stored in the state dir (not a workspace), so the agent can't edit it."""
    cfg = prof.cfg
    spec, files = local_kit_spec(prof, token)
    text = (KIT_SYNTAX + "\n# generated by agentbox - edit ~/.config/agentbox/agentbox.toml instead\n"
            + yaml_dump(spec) + "\n")
    kit_root = prof.state / "kit"
    if kit_root.exists():
        shutil.rmtree(kit_root)
    kit_dir = kit_root / LOCAL_KIT_NAME         # the directory name is the kit's name inside the sandbox
    kit_dir.mkdir(parents=True)
    kit_descriptor(kit_dir).write_text(text, newline="\n")      # LF on Windows too: these run in the Linux VM
    # `skills` only counts once used, so sandboxes made before skill sets existed don't look changed
    shaped = {k: v for k, v in prof.d.items() if k != "skills" or v}
    # only the path is baked in at creation (the mount); ref/include/allow_scripts apply live, no fresh needed
    skill_defs = json.dumps([[n, cfg.skillsets[n].get("path")] for n in prof.d["skills"]], sort_keys=True, default=str)
    digest = hashlib.sha256((text + json.dumps(files, sort_keys=True) + json.dumps(shaped, sort_keys=True, default=str)
                             + (skill_defs if prof.d["skills"] else "")).encode()).hexdigest()
    return str(kit_dir), digest


def secure_state(cfg: Config):
    """State holds the bridge token (in `token` and in the generated kit's spec.yaml),
    logs and snapshots. Make it owner-only, including anything created by older versions."""
    root = cfg.state_root
    root.mkdir(parents=True, exist_ok=True)
    for dirpath, dirnames, filenames in os.walk(root):
        for d in [dirpath] + [os.path.join(dirpath, n) for n in dirnames]:
            try:
                if not os.path.islink(d):
                    owner_only(d, is_dir=True)
            except OSError:
                pass
        for f in filenames:
            fp = os.path.join(dirpath, f)
            try:
                if not os.path.islink(fp):
                    owner_only(fp)
            except OSError:
                pass
    if not owned_by_me(root):
        die(f"state dir {root} is owned by uid {root.stat().st_uid}, not you - refusing to use it")


def get_token(prof: Profile) -> str:
    tf = prof.state / "token"
    if not tf.exists():
        prof.state.mkdir(parents=True, exist_ok=True)
        tf.write_text(pysecrets.token_urlsafe(32))
        owner_only(tf)
    return tf.read_text().strip()


# -------------------------------------------------------------- audit
# IMPORTANT: nothing in the audit may run git (or any tool) on the host against a
# workspace. An agent controls .git/config in direct mode, and git honours settings
# that execute commands (core.fsmonitor runs on `git status`, textconv/diff drivers on
# `git diff`, hooks on commit, ...). The audit reads files with Python only; git
# status is run inside the sandbox.

# Config keys that make git run a program, change where it runs things from, or
# redirect where it talks to. Patterns are "section.key" or "section.*.key".
RISKY_GIT_KEYS = [
    "core.fsmonitor", "core.hookspath", "core.sshcommand", "core.pager", "core.editor",
    "core.askpass", "core.gitproxy", "core.alternaterefscommand", "core.worktree",
    "core.attributesfile", "core.excludesfile",
    "sequence.editor", "gpg.program", "gpg.*.program", "ssh.variant",
    "credential.helper", "credential.*.helper",
    "diff.external", "diff.*.command", "diff.*.textconv", "merge.*.driver",
    "filter.*.clean", "filter.*.smudge", "filter.*.process",
    "pager.*", "alias.*", "web.browser", "browser.*.cmd", "browser.*.path", "man.*.cmd",
    "difftool.*.cmd", "difftool.*.path", "mergetool.*.cmd", "mergetool.*.path",
    "remote.*.uploadpack", "remote.*.receivepack", "remote.*.vcs", "remote.*.proxy",
    "url.*.insteadof", "url.*.pushinsteadof", "http.proxy", "http.*.proxy",
    "uploadpack.packobjectshook", "interactive.difffilter", "submodule.*.update",
    "include.path", "includeif.*.path", "safe.directory", "sendemail.*",
]


def parse_git_config(path: Path) -> list[tuple[str, str]]:
    """Lenient git-config reader -> [("section[.sub].key", value)]. Never runs git."""
    out, section = [], ""
    try:
        text = path.read_text(errors="replace")
    except OSError:
        return out
    lines = text.splitlines()
    i = 0
    while i < len(lines):
        line = lines[i].strip()
        i += 1
        while line.endswith("\\") and i < len(lines):
            line = line[:-1] + lines[i].strip()
            i += 1
        if not line or line[0] in "#;":
            continue
        m = re.match(r'^\[\s*([A-Za-z0-9.-]+)(?:\s+"((?:[^"\\]|\\.)*)")?\s*\](.*)$', line)
        if m:
            sec, sub = m.group(1).lower(), m.group(2)
            section = f"{sec}.{sub}" if sub is not None else sec
            line = m.group(3).strip()        # `[core] fsmonitor = x` on one line
            if not line or line[0] in "#;":
                continue
        k, _, v = line.partition("=")
        key = k.strip().lower()
        if key:
            out.append((f"{section}.{key}" if section else key, v.strip().strip('"') if _ else "true"))
    return out


def _risky(name: str) -> bool:
    parts = name.split(".")
    if len(parts) < 2:
        return False
    sec, key = parts[0].lower(), parts[-1].lower()
    for pat in RISKY_GIT_KEYS:
        ps = pat.split(".")
        if len(ps) == 2 and ps[0] == sec and len(parts) == 2 and fnmatch.fnmatch(key, ps[1]):
            return True
        if len(ps) == 3 and ps[0] == sec and len(parts) >= 3 and fnmatch.fnmatch(key, ps[2]):
            return True
        if len(ps) == 2 and ps[1] == "*" and ps[0] == sec:      # e.g. alias.*, pager.*
            return True
    return False


def git_dir_of(root: Path) -> Path | None:
    g = root / ".git"
    if g.is_symlink():
        return g                      # reported as a finding by risky_git_config
    if g.is_dir():
        return g
    if g.is_file():                   # worktree / submodule: "gitdir: <path>"
        try:
            m = re.match(r"gitdir:\s*(.+)", g.read_text().strip())
        except OSError:
            return None
        if m:
            p = Path(m.group(1))
            return (root / p).resolve() if not p.is_absolute() else p.resolve()
    return None


def risky_git_config(root: Path) -> list[str]:
    """Findings as printable strings, following include/includeIf paths (max depth 5)."""
    gd = git_dir_of(root)
    if gd is None:
        return []
    findings = []
    if (root / ".git").is_symlink():
        findings.append(f".git is a symlink -> {os.readlink(root / '.git')}")
    elif not (root / ".git").is_dir():
        findings.append(f".git is a file pointing at {gd}")
    seen: set[Path] = set()

    def walk(cfg: Path, depth: int):
        if depth > 5 or cfg in seen:
            return
        seen.add(cfg)
        label = str(cfg.relative_to(root)) if is_within(cfg, root) else str(cfg)
        for name, val in parse_git_config(cfg):
            if _risky(name):
                findings.append(f"{label}: {name} = {val}")
            if name == "include.path" or (name.startswith("includeif.") and name.endswith(".path")):
                p = Path(os.path.expanduser(val))
                walk((cfg.parent / p).resolve() if not p.is_absolute() else p.resolve(), depth + 1)

    for name in ("config", "config.worktree"):
        if (gd / name).is_file():
            walk((gd / name).resolve(), 0)
    return findings


def _scan(root: Path, globs: list[str], skip: list[str]) -> dict[str, str]:
    found: dict[str, str] = {}
    for dirpath, dirnames, filenames in os.walk(root):
        rel_dir = Path(dirpath).relative_to(root)
        if rel_dir.parts and rel_dir.parts[0] == ".git":
            if len(rel_dir.parts) == 1:
                dirnames[:] = [d for d in dirnames if d == "hooks"]
            else:
                dirnames[:] = []
        else:
            dirnames[:] = [d for d in dirnames
                           if not any(fnmatch.fnmatch(d, s) for s in skip)]
        for fn in filenames:
            rel = str(rel_dir / fn) if rel_dir.parts else fn
            if any(fnmatch.fnmatch(rel, g) for g in globs):
                if rel.startswith(".git/hooks/") and rel.endswith(".sample"):
                    continue
                fp = Path(dirpath) / fn
                try:
                    st = fp.lstat()
                except OSError:
                    continue
                # Never follow symlinks or open FIFOs/devices: a symlink could point
                # outside the workspace, a FIFO would hang the audit.
                if fp.is_symlink():
                    found[rel] = "symlink:" + os.readlink(fp)
                    continue
                if not stat_is_regular(st.st_mode):
                    found[rel] = "special-file"
                    continue
                try:
                    found[rel] = sha256_file(fp)
                except OSError:
                    pass
    return found


def stat_is_regular(mode: int) -> bool:
    import stat as _stat
    return _stat.S_ISREG(mode)


def snapshot(prof: Profile) -> dict:
    s = prof.cfg.settings
    return {str(r): _scan(r, s["audit_globs"], s["audit_skip_dirs"])
            for r in prof.writable_roots if r.exists()}


def git_snapshot(prof: Profile) -> dict:
    return {str(r): risky_git_config(r) for r in prof.writable_roots if r.exists()}


def write_snapshot(prof: Profile):
    prof.state.mkdir(parents=True, exist_ok=True)
    (prof.state / "snapshot.json").write_text(json.dumps(
        {"time": time.time(), "files": snapshot(prof), "gitcfg": git_snapshot(prof)}, indent=1))


def sandbox_git_status(prof: Profile, root: str) -> str | None:
    """Run `git status` INSIDE the sandbox (where running repo-controlled code is fine).
    Returns output, or None if the sandbox isn't available."""
    if sandbox_state(prof) != "running":        # `sbx exec` would start a stopped sandbox
        return None
    try:
        r = subprocess.run([prof.cfg.settings["sbx"], "exec", prof.sandbox,
                            "git", "-C", root, "status", "--short"],
                           env=sbx_env(prof.cfg), capture_output=True, text=True, timeout=60)
    except (OSError, subprocess.TimeoutExpired):
        return None
    return r.stdout if r.returncode == 0 else None


def cmd_audit(prof: Profile) -> int:
    snap_file = prof.state / "snapshot.json"
    if not snap_file.exists():
        info("no snapshot for this profile (created before first `up`?)")
        return EXIT_NO_SANDBOX
    old = json.loads(snap_file.read_text())
    new = snapshot(prof)
    when = time.strftime("%Y-%m-%d %H:%M", time.localtime(old["time"]))
    print(f"Changes to sensitive files since sandbox creation ({when}):")
    flagged = 0
    old_git = old.get("gitcfg", {})
    danger = False
    for root, findings in git_snapshot(prof).items():
        if findings:
            before = set(old_git.get(root, []))
            print(f"\n  !! {root}: git config settings that can run commands or redirect git:")
            for f in findings:
                print(f"     {'NEW ' if f not in before else '    '}{safe_text(f)}")
            danger = danger or any(f not in before for f in findings)
    if danger:
        print("\n  !! DO NOT run git (status, diff, commit, push...) on the host in that repo until you've"
              "\n     checked .git/config (and any included files) in a plain text editor.")
    for root, files in new.items():
        before = old["files"].get(root, {})
        added = sorted(set(files) - set(before))
        removed = sorted(set(before) - set(files))
        changed = sorted(k for k in set(files) & set(before) if files[k] != before[k])
        if added or removed or changed:
            print(f"\n  {root}")
            for k in added:
                print(f"    + {safe_text(k)}")
            for k in changed:
                print(f"    ~ {safe_text(k)}")
            for k in removed:
                print(f"    - {safe_text(k)}")
            flagged += len(added) + len(changed) + len(removed)
        hooks = [k for k in files if k.startswith(".git/hooks/")]
        if hooks:
            print(f"  NOTE {root}: active git hooks present: {safe_text(', '.join(hooks))}")
        if (Path(root) / ".git").exists():
            out = sandbox_git_status(prof, root)
            if out is None:
                print("  git status: skipped (sandbox not available; agentbox never runs git on the host here)")
            elif out.strip():
                n = len(out.strip().splitlines())
                print(f"  git status (run in sandbox): {n} changed path(s) - review with"
                      f" `agentbox shell {prof.name}` then `git diff`")
    if not flagged and not danger:
        print("  none")
    else:
        print("\nReview these before running builds, git commands or IDE tasks on the host:"
              " they can execute code outside the sandbox.")
    return 0


# -------------------------------------------------------------- bridge
class ToolError(Exception):
    pass


def _expand_literal(s: str) -> str:
    return os.path.expandvars(os.path.expanduser(s)) if s.startswith(("~", "$")) else s


_WARNED_TOOLS: set[str] = set()     # tools already warned about in this run


class Bridge:
    MAX_OUT = 256 * 1024

    def __init__(self, prof: Profile):
        self.prof = prof
        self.cfg = prof.cfg
        self.roots = [r for r in prof.roots]
        self.token = get_token(prof)
        self.locks: dict[str, threading.Lock] = {}
        self.confirm_lock = threading.Lock()
        self.rate_lock = threading.Lock()
        self.calls: dict[str, list[float]] = {}
        self.log_path = prof.state / "bridge.log"
        self.tools = {}
        for n in prof.tool_names:
            if n not in self.cfg.tools:
                die(f"profile '{prof.name}' references unknown tool '{n}'", EXIT_USAGE)
            self.tools[n] = self.cfg.tools[n]
        self.preflight()

    def preflight(self):
        for r in self.roots:
            if is_within(CONFIG_FILE.resolve(), r) or is_within(KITS_DIR.resolve(), r):
                die(f"config/kits live inside workspace {r}: the agent could grant itself tools. Move them.", EXIT_USAGE)
        for n, t in self.tools.items():
            argv = t.get("argv")
            if not argv or not isinstance(argv, list):
                die(f"tool '{n}': argv must be a non-empty list", EXIT_USAGE)
            exe = Path(_expand_literal(argv[0]))
            if not exe.is_absolute():
                die(f"tool '{n}': argv[0] must be an absolute path (got {argv[0]})", EXIT_USAGE)
            exe = resolve_exe(exe)
            if IS_WIN and exe.suffix.lower() in (".bat", ".cmd"):
                # CreateProcess runs these through cmd.exe, whose quoting rules let an argument inject commands
                die(f"tool '{n}': {exe.name} is a batch file; point argv[0] at an .exe (or a wrapper .exe)", EXIT_USAGE)
            rexe = exe.resolve()
            if (not rexe.exists() or not os.access(rexe, os.X_OK)) and n not in _WARNED_TOOLS:
                _WARNED_TOOLS.add(n)      # once per run, not once per profile that lists it
                info(f"warning: tool '{n}': {exe} is not executable/present - calls will fail")
            for r in self.roots:
                if is_within(rexe, r):
                    die(f"tool '{n}': executable {exe} is inside workspace {r} (agent-writable)", EXIT_USAGE)
            for a in argv[1:]:
                lit = Path(_expand_literal(a))
                if lit.is_absolute() and "{" not in a:
                    for r in self.roots:
                        if is_within(lit.resolve(), r):
                            die(f"tool '{n}': fixed argument {a} points inside workspace {r} (agent-writable)", EXIT_USAGE)

    # ---- validation
    def _root_for(self, p: Path) -> Path | None:
        for r in self.roots:
            if is_within(p, r):
                return r
        return None

    def _param(self, tname: str, pname: str, spec: dict, raw, cwd: Path) -> str:
        typ = spec.get("type", "string")
        if not isinstance(raw, (str, int)):
            raise ToolError(f"{pname}: must be a string")
        raw = str(raw)
        if typ == "path":
            try:
                p = host_path(raw)          # the agent sees /d/x, the host has D:\x
            except ValueError as e:
                raise ToolError(f"{pname}: {e}")
            p = (cwd / p if not p.is_absolute() else p).resolve()
            if not self._root_for(p):
                raise ToolError(f"{pname}: {p} is outside the mounted workspaces")
            if spec.get("must_exist", True) and not p.exists():
                raise ToolError(f"{pname}: {p} does not exist")
            kind = spec.get("kind", "file")
            if p.exists() and kind == "file" and not p.is_file():
                raise ToolError(f"{pname}: {p} is not a file")
            if p.exists() and kind == "dir" and not p.is_dir():
                raise ToolError(f"{pname}: {p} is not a directory")
            suf = spec.get("suffixes")
            if suf and not any(str(p).endswith(s) for s in suf):
                raise ToolError(f"{pname}: must end with one of {suf}")
            return str(p)
        if typ == "int":
            try:
                v = int(raw, 0)
            except ValueError:
                raise ToolError(f"{pname}: not an integer: {raw!r}")
            if "min" in spec and v < int(spec["min"]):
                raise ToolError(f"{pname}: below minimum {spec['min']}")
            if "max" in spec and v > int(spec["max"]):
                raise ToolError(f"{pname}: above maximum {spec['max']}")
            if spec.get("ranges") and not spec.get("span") and not self._in_ranges(spec["ranges"], v, v):
                raise ToolError(f"{pname}: {hex(v)} is outside the allowed ranges: {self._fmt_ranges(spec['ranges'])}")
            return hex(v) if spec.get("format") == "hex" else str(v)
        if typ == "enum":
            vals = [str(v) for v in spec.get("values", [])]
            if raw not in vals:
                raise ToolError(f"{pname}: must be one of {vals}")
            return raw
        if typ == "string":
            pat = spec.get("pattern", r"[A-Za-z0-9_.,:=+/-]{1,128}")
            if not re.fullmatch(pat, raw):
                raise ToolError(f"{pname}: does not match {pat}")
            if raw.startswith("-") and not spec.get("allow_leading_dash"):
                raise ToolError(f"{pname}: may not start with '-'")
            return raw
        raise ToolError(f"tool '{tname}' param '{pname}': unknown type {typ}")

    @staticmethod
    def _ranges(rs) -> list[tuple[int, int, str]]:
        out = []
        for r in rs:
            if isinstance(r, dict):
                out.append((int(r["start"]), int(r["end"]), str(r.get("name", ""))))
            else:
                out.append((int(r[0]), int(r[1]), ""))
        return out

    def _in_ranges(self, rs, lo: int, hi: int) -> bool:
        return any(a <= lo and hi <= b for a, b, _ in self._ranges(rs))

    def _fmt_ranges(self, rs) -> str:
        return ", ".join(f"{n + ' ' if n else ''}{a:#010x}-{b:#010x}" for a, b, n in self._ranges(rs))

    def check_rate(self, tname: str, t: dict):
        n = t.get("max_calls")
        if not n:
            return
        per = float(t.get("per_seconds", 60))
        now = time.monotonic()
        with self.rate_lock:
            q = [x for x in self.calls.get(tname, []) if now - x < per]
            if len(q) >= int(n):
                self.calls[tname] = q
                raise ToolError(f"rate limit: {tname} allows {n} calls per {per:g}s - wait, or ask the user")
            q.append(now)
            self.calls[tname] = q

    def build(self, tname: str, params: dict, extra: list, cwd_s: str):
        t = self.tools.get(tname)
        if not t:
            raise ToolError(f"unknown tool '{tname}'. Available: {', '.join(self.tools)}")
        try:
            cwd = host_path(cwd_s or "/").resolve()
        except ValueError as e:
            raise ToolError(f"cwd: {e}; cd into the project first")
        ws = self._root_for(cwd)
        if not ws:
            raise ToolError(f"cwd {cwd} is not inside a mounted workspace; cd into the project first")
        specs = t.get("params", {})
        unknown = set(params) - set(specs)
        if unknown:
            raise ToolError(f"unknown parameter(s): {', '.join(sorted(unknown))}")
        values = {"workspace": str(ws), "cwd": str(cwd)}
        for pname, spec in specs.items():
            if pname in params:
                values[pname] = self._param(tname, pname, spec, params[pname], cwd)
            elif "default" in spec:
                values[pname] = self._param(tname, pname, spec, spec["default"], cwd)
            elif spec.get("required", True):
                raise ToolError(f"missing required parameter '{pname}'")
        # Range + span check: e.g. addr .. addr + words*4 - 1 must lie inside ONE allowed
        # range, so a read can't start in RAM and run on into peripheral registers.
        for pname, spec in specs.items():
            span = spec.get("span")
            if spec.get("type") == "int" and spec.get("ranges") and span and pname in values:
                start = int(values[pname], 0)
                n = int(values.get(span["param"], "1"), 0)
                end = start + n * int(span.get("scale", 1)) - 1
                if not self._in_ranges(spec["ranges"], start, end):
                    raise ToolError(f"{pname}: {hex(start)}..{hex(end)} is not inside one allowed range:"
                                    f" {self._fmt_ranges(spec['ranges'])}")
        argv = []
        for a in t["argv"]:
            whole = re.fullmatch(r"\{(\w+)\}", a)
            if whole and whole.group(1) not in values:
                continue   # optional param omitted -> drop the argument
            def sub(m):
                k = m.group(1)
                if k not in values:
                    raise ToolError(f"parameter '{k}' needed by this argument")
                return values[k]
            argv.append(re.sub(r"\{(\w+)\}", sub, _expand_literal(a)))
        ea = t.get("extra_args")
        if extra:
            if not ea:
                raise ToolError("this tool takes no extra arguments")
            if len(extra) > int(ea.get("max", 16)):
                raise ToolError("too many extra arguments")
            pat = ea.get("pattern", r"[A-Za-z0-9_.,:=+/-]{1,200}")
            deny = ea.get("deny_prefixes", [])
            for x in extra:
                if not isinstance(x, str) or not re.fullmatch(pat, x):
                    raise ToolError(f"extra argument {x!r} does not match {pat}")
                if any(x.startswith(d) for d in deny):
                    raise ToolError(f"extra argument {x!r} is not allowed")
            argv += extra
        # Default working dir is an empty dir outside every workspace: many tools load
        # config from ./ (OpenOCD reads ./openocd.cfg, gdb ./.gdbinit, make ./Makefile).
        # Opt in per tool with cwd = "{workspace}" or "{cwd}" only if the tool is safe there.
        default_cwd = str(self.safe_cwd)
        run_cwd = re.sub(r"\{(\w+)\}", lambda m: values.get(m.group(1), ""), t.get("cwd", default_cwd))
        return t, argv, run_cwd

    @property
    def safe_cwd(self) -> Path:
        p = self.prof.state / "tool-cwd"
        p.mkdir(parents=True, exist_ok=True)
        return p

    def needs_confirm(self, t: dict) -> bool:
        return bool(t.get("confirm", self.prof.d.get("confirm_host_tools", False)))

    def confirm(self, tname: str, argv: list[str], timeout: int) -> bool:
        """Ask the human on the host: osascript on macOS, zenity or kdialog on Linux, a PowerShell
        message box on Windows; else deny."""
        if IS_WIN:
            return self.confirm_windows(tname, argv, timeout)
        where = "this Mac" if sys.platform == "darwin" else "this machine"
        msg = f"Sandbox {self.prof.sandbox} wants to run on {where}:\n\n" + shlex.join(argv)[:900]
        title = "agentbox host tool"
        if sys.platform == "darwin" and shutil.which("osascript"):
            # argv is passed as an AppleScript run argument, never spliced into the script.
            script = ["-e", "on run argv",
                      "-e", "display dialog (item 1 of argv) with title \"" + title + "\" "
                            "buttons {\"Deny\", \"Allow\"} default button \"Deny\" cancel button \"Deny\" "
                            "with icon caution giving up after " + str(int(timeout)),
                      "-e", "return button returned of result",
                      "-e", "end run"]
            cmd, ok_out = ["osascript", *script, msg], "Allow"
        elif sys.platform.startswith("linux") and shutil.which("zenity") and (
                os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY")):
            # exit 0 = Allow; Deny, close or timeout = non-zero. The text is an argument, never markup-parsed.
            cmd, ok_out = ["zenity", "--question", "--no-markup", "--title", title, "--ok-label", "Allow",
                           "--cancel-label", "Deny", "--default-cancel", "--timeout", str(int(timeout)),
                           "--text", msg], ""
        elif sys.platform.startswith("linux") and shutil.which("kdialog") and (
                os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY")):
            # kdialog renders rich text: escape it so agent-supplied argv can't restyle or hide the command
            cmd, ok_out = ["kdialog", "--title", title, "--yesno", html.escape(msg).replace("\n", "<br>"), "--yes-label", "Allow",
                           "--no-label", "Deny"], ""
        else:
            self.log({"tool": tname, "confirm": "denied", "reason": "no dialog available"
                      " (needs osascript on macOS, zenity/kdialog and a display on Linux, or Windows)"})
            return False
        try:
            r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout + 10)
        except (OSError, subprocess.TimeoutExpired):
            return False
        return r.returncode == 0 and r.stdout.strip() == ok_out

    # Reads the message from the environment, never from the script text: argv is agent-influenced.
    # Deny is the default button, and closing the dialog or timing out is a deny.
    WIN_CONFIRM_PS = (
        "Add-Type -AssemblyName System.Windows.Forms; "
        "$f = New-Object System.Windows.Forms.Form; $f.TopMost = $true; "
        "$r = [System.Windows.Forms.MessageBox]::Show($f, $env:AGENTBOX_CONFIRM_MSG, 'agentbox host tool', "
        "'YesNo', 'Warning', 'Button2'); [Console]::Out.Write($r)")

    def confirm_windows(self, tname: str, argv: list[str], timeout: int) -> bool:
        msg = (f"Sandbox {self.prof.sandbox} wants to run on this PC:\n\n"
               + subprocess.list2cmdline(argv)[:900] + "\n\nAllow?")
        env = {**tool_base_env(), "AGENTBOX_CONFIRM_MSG": msg}
        try:
            code, out, _ = run_tool(["powershell", "-NoProfile", "-NonInteractive", "-STA", "-Command",
                                     self.WIN_CONFIRM_PS], None, env, timeout)
        except OSError:
            self.log({"tool": tname, "confirm": "denied", "reason": "could not start PowerShell"})
            return False
        return code == 0 and out.decode(errors="replace").strip() == "Yes"

    def run(self, tname, params, extra, cwd):
        t, argv, run_cwd = self.build(tname, params, extra, cwd)
        self.check_rate(tname, t)
        env = tool_base_env()
        env.update({k: _expand_literal(str(v)) for k, v in t.get("env", {}).items()})
        lock = self.locks.setdefault(t.get("lock", tname), threading.Lock())
        timeout = int(t.get("timeout", 60))
        if self.needs_confirm(t):
            with self.confirm_lock:          # one dialog at a time
                ok = self.confirm(tname, argv, int(t.get("confirm_timeout", 120)))
            self.log({"tool": tname, "argv": argv, "confirm": "allowed" if ok else "denied"})
            if not ok:
                raise ToolError("denied by the user on the host (or no answer)")
        t0 = time.time()
        with lock:
            try:
                rc, out, err = run_tool(argv, run_cwd, env, timeout)
            except OSError as e:
                rc, out, err = 127, b"", str(e).encode()
        res = {
            "tool": tname, "argv": argv, "exit_code": rc, "seconds": round(time.time() - t0, 2),
            "stdout": out[-self.MAX_OUT:].decode(errors="replace"),
            "stderr": err[-self.MAX_OUT:].decode(errors="replace"),
            "truncated": len(out) > self.MAX_OUT or len(err) > self.MAX_OUT,
        }
        self.log({"tool": tname, "argv": argv, "cwd": run_cwd, "exit_code": rc, "seconds": res["seconds"]})
        return res

    def log(self, rec):
        rec["time"] = time.strftime("%Y-%m-%dT%H:%M:%S")
        with open(self.log_path, "a") as f:
            f.write(json.dumps(rec) + "\n")

    def describe(self):
        return {n: describe_tool(t) for n, t in self.tools.items()}

    # ---- HTTP
    def handler(self):
        bridge = self

        class H(http.server.BaseHTTPRequestHandler):
            server_version = "agentbox-bridge"

            def log_message(self, *a):
                pass

            def _send(self, code, obj):
                body = json.dumps(obj).encode()
                self.send_response(code)
                self.send_header("Content-Type", "application/json")
                self.send_header("Content-Length", str(len(body)))
                self.end_headers()
                self.wfile.write(body)

            def _authed(self):
                tok = self.headers.get("X-Agentbox-Token", "")
                if not hmac.compare_digest(tok, bridge.token):
                    bridge.log({"denied": self.path, "reason": "bad token"})
                    self._send(401, {"error": "bad or missing token"})
                    return False
                return True

            def do_GET(self):
                if not self._authed():
                    return
                if self.path == "/ping":
                    return self._send(200, {"ok": True, "profile": bridge.prof.name})
                if self.path == "/tools":
                    return self._send(200, bridge.describe())
                self._send(404, {"error": "not found"})

            def do_POST(self):
                if not self._authed():
                    return
                if self.path != "/run":
                    return self._send(404, {"error": "not found"})
                n = int(self.headers.get("Content-Length", "0"))
                if n > 65536:
                    return self._send(413, {"error": "request too large"})
                try:
                    req = json.loads(self.rfile.read(n) or b"{}")
                    res = bridge.run(req.get("tool", ""), req.get("params") or {},
                                     req.get("args") or [], req.get("cwd", ""))
                    self._send(200, res)
                except ToolError as e:
                    bridge.log({"rejected": req.get("tool") if isinstance(req, dict) else None, "reason": str(e)})
                    self._send(400, {"error": str(e)})
                except (ValueError, AttributeError) as e:
                    self._send(400, {"error": f"bad request: {e}"})
        return H

    def serve(self):
        port = self.prof.port
        servers = []

        class V6(http.server.ThreadingHTTPServer):
            address_family = socket.AF_INET6

        for cls, addr in ((http.server.ThreadingHTTPServer, "127.0.0.1"), (V6, "::1")):
            try:
                servers.append(cls((addr, port), self.handler()))
            except OSError as e:
                if addr == "127.0.0.1":
                    die(f"cannot bind 127.0.0.1:{port}: {e}")
        for s in servers[1:]:
            threading.Thread(target=s.serve_forever, daemon=True).start()
        info(f"bridge for '{self.prof.name}' on localhost:{port} - tools: {', '.join(self.tools)}")
        on_sigterm(lambda *_: sys.exit(0))
        try:
            servers[0].serve_forever()
        except KeyboardInterrupt:
            pass


def bridge_pid(prof: Profile) -> int | None:
    return _pid_of(prof.state / "bridge.pid", "bridge", prof.name)


def _pid_of(pf: Path, word: str, profile: str) -> int | None:
    """pid from a state-dir pid file, only if it is still OUR `agentbox <word> <profile>` process.
    A stale file (pid reused by something else, pid 0/1/negative, ourselves) is removed and
    nothing is returned, so callers can never signal an unrelated process."""
    if not pf.exists():
        return None
    try:
        pid = int(pf.read_text().strip())
        if pid > 1 and pid not in (os.getpid(), os.getppid()):
            cmd = process_cmdline(pid)
            if any("agentbox" in t for t in cmd) and word in cmd and profile in cmd:
                return pid
    except (ValueError, OSError):
        pass
    pf.unlink(missing_ok=True)
    return None


def start_bridge(prof: Profile):
    if not prof.tool_names or bridge_pid(prof):
        return
    prof.state.mkdir(parents=True, exist_ok=True)
    Bridge(prof)  # preflight in the foreground so errors are visible
    log = open(prof.state / "bridge.out", "a")
    p = subprocess.Popen([sys.executable, str(Path(__file__).resolve()), "bridge", prof.name],
                         stdout=log, stderr=log, stdin=subprocess.DEVNULL,
                         **detached_popen_kwargs(), env=child_env())
    (prof.state / "bridge.pid").write_text(str(p.pid))
    time.sleep(0.5)
    if p.poll() is not None:
        die(f"bridge exited immediately - see {prof.state / 'bridge.out'}")
    info(f"host-tool bridge running (pid {p.pid}, localhost:{prof.port})")


def stop_bridge(prof: Profile):
    pid = bridge_pid(prof)
    if pid:
        terminate(pid)
        info(f"stopped bridge (pid {pid})")
    (prof.state / "bridge.pid").unlink(missing_ok=True)


# ------------------------------------------------------------- commands
def set_secrets(prof: Profile):
    for s in prof.d["secrets"]:
        if isinstance(s, str):
            s = {"service": s}
        if s.get("custom"):
            host, envn = s.get("host"), s.get("env")
            if not host or not envn:
                die("custom secret needs host and env", EXIT_USAGE)
            # Hand sbx the SOURCE (op:// ref or a command it runs on the host), never the
            # value: values on argv are visible to `ps`, and agentbox never needs to see them.
            if s.get("ref"):
                src = ["--ref", s["ref"]]
            elif s.get("command"):
                src = ["--command", s["command"]]
            else:
                die(f"custom secret {envn}: set `ref = \"op://...\"` or `command = \"...\"` "
                    "(e.g. command = \"security find-generic-password -s junie -w\" for the macOS keychain)",
                    EXIT_USAGE)
            info(f"custom secret {envn} -> {host} (sandbox-scoped, resolved on the host by sbx)")
            sbx(prof.cfg, "secret", "set-custom", "--sandbox", prof.sandbox,
                "--host", host, "--env", envn, *src)
            continue
        svc = s.get("service")
        if not svc:
            die(f"secret entry without service: {s}", EXIT_USAGE)
        args = ["secret", "set", svc, "--sandbox", prof.sandbox]
        if s.get("ref"):
            args += ["--ref", s["ref"]]
        elif s.get("command"):
            args += ["--command", s["command"]]
        info(f"secret '{svc}' (sandbox-scoped)")
        sbx(prof.cfg, *args)


def remove_secrets(prof: Profile):
    for s in prof.d["secrets"]:
        if isinstance(s, str):
            s = {"service": s}
        if s.get("service") and not s.get("custom"):
            sbx(prof.cfg, "secret", "rm", s["service"], "--sandbox", prof.sandbox, check=False, capture=True)


def create_sandbox_retrying(prof: Profile, create: list, attempts: int = 5):
    """`sbx create` with backoff on transient errors. After a failed attempt the sandbox may
    already exist (the call timed out, not the creation), so re-check before creating again."""
    for i in range(attempts):
        r = sbx(prof.cfg, *create, check=False, capture=True)
        if r.returncode == 0:
            return
        if not is_transient(r) or i == attempts - 1:
            die(f"`sbx create` failed (exit {r.returncode})" + (f"\n{r.stderr}" if r.stderr else ""))
        delay = backoff_delay(i)
        info(f"sbx create failed transiently; checking before retrying in {delay:g}s")
        time.sleep(delay)
        if sandbox_exists(prof, retry=True):
            info(f"{prof.sandbox} exists after the error; continuing")
            return


def ensure_sandbox(prof: Profile, retry: bool = False):
    """Create the sandbox if needed (without attaching) and start the bridge.
    retry=True (headless jobs) retries transient daemon errors."""
    cfg = prof.cfg
    for r in prof.roots:
        if not r.exists():
            die(f"workspace {r} does not exist", EXIT_USAGE)
    if prof.tool_names and prof.d["mode"] == "clone":
        die("host tools need mode = \"direct\": in clone mode the code lives only inside the VM", EXIT_USAGE)
    prof.require_skills()               # re-checked before every mount: the folder may have changed
    token = get_token(prof)
    kit_dir, digest = render_local_kit(prof, token)
    digest_file = prof.state / "kit.digest"

    if sandbox_exists(prof, retry=retry):
        if digest_file.exists() and digest_file.read_text() != digest:
            msg = ("profile/config changed since this sandbox was created; kits apply at creation only."
                   f" Run `agentbox fresh {prof.name}` to rebuild.")
            if sorted(map(str, prof.skill_mounts())) != sorted(recorded_skill_mounts(prof)):
                msg += (" The skill set paths changed: a new mount only exists after a fresh"
                        " (links to skills that are already mounted apply on the next `up`).")
            info(msg)
        warn_skill_drift(prof)
        start_bridge(prof)
    else:
        kits = [str(p) for p in prof.kit_paths()] + [kit_dir]
        create = ["create", "--name", prof.sandbox]
        if prof.d["mode"] == "clone":
            create.append("--clone")
        if prof.d.get("template"):
            create += ["--template", prof.d["template"]]
        elif tpl := built_template(prof):
            create += ["--template", tpl, "--pull", "never"]
            info(f"starting from the prebuilt template {tpl}")
        for k in kits:
            create += ["--kit", k]
        create.append(prof.agent_ref())
        create.append(str(prof.primary))
        for p, ro in prof.extras:
            create.append(f"{p}:ro" if ro else str(p))
        for p in prof.skill_mounts():
            create.append(f"{p}:ro")                    # never writable
        write_snapshot(prof)
        start_bridge(prof)
        info(f"creating sandbox {prof.sandbox}")
        if retry:
            create_sandbox_retrying(prof, create)
        else:
            sbx(cfg, *create)
        digest_file.write_text(digest)
        (prof.state / "skills.mounts").write_text(json.dumps(list(map(str, prof.skill_mounts()))))
        record_skill_heads(prof)
        set_secrets(prof)
        restore_sessions(prof)
        for p in prof.d["publish"]:
            sbx(cfg, "ports", prof.sandbox, "--publish", p, check=False)


def recorded_skill_mounts(prof: Profile) -> list[str]:
    try:
        v = json.loads((prof.state / "skills.mounts").read_text())
    except (OSError, ValueError):
        return []
    return [x for x in v if isinstance(x, str)] if isinstance(v, list) else []


def skills_link_script(links: list[tuple[str, str]]) -> str:
    """ONE idempotent sh script, run in the VM: make ~/.claude/skills/<skill> a symlink to the mounted
    folder. It only replaces or removes symlinks listed in ~/.claude/skills/.agentbox-links (the names of
    links agentbox made; that file is agent-writable, so a name is used only if it is a plain skill name
    AND the entry is a symlink). Real folders and other symlinks (skills the agent wrote) are left alone.
    Prints LINK / OK / UNLINK / SKIP <name> [reason] lines."""
    want = " ".join(sk for sk, _ in links)
    calls = "\n".join(f"link {shlex.quote(sk)} {shlex.quote(t)}" for sk, t in links)
    return f'''set -f
d="{SKILLS_VM_DIR}"; m="$d/.agentbox-links"; want=" {want} "; new=; old=
if [ -f "$m" ]; then old=$(cat "$m" 2>/dev/null); fi
mkdir -p "$d" || exit 1
isours() {{ case " $(echo $old) " in *" $1 "*) return 0;; esac; return 1; }}
for n in $old; do
  case $n in ""|[!a-z0-9]*|*[!a-z0-9-]*) continue;; esac
  case $want in *" $n "*) continue;; esac
  if [ -L "$d/$n" ]; then rm -f "$d/$n" && echo "UNLINK $n"; fi
done
link() {{
  n=$1; t=$2
  if [ ! -f "$t/SKILL.md" ]; then
    echo "SKIP $n not-mounted"; if isours "$n" && [ -L "$d/$n" ]; then new="$new $n"; fi; return
  fi
  if [ -L "$d/$n" ]; then
    if ! isours "$n"; then echo "SKIP $n foreign-link"; return; fi
    if [ "$(readlink "$d/$n")" = "$t" ]; then echo "OK $n"; else ln -sfn "$t" "$d/$n" && echo "LINK $n"; fi
  elif [ -e "$d/$n" ]; then echo "SKIP $n exists"; return
  else ln -s "$t" "$d/$n" && echo "LINK $n"
  fi
  new="$new $n"
}}
{calls}
if [ -n "$new" ]; then
  tmp="$m.tmp.$$"; {{ for n in $new; do echo "$n"; done; }} > "$tmp" && mv "$tmp" "$m"
else rm -f "$m"; fi
true'''


def skills_check_script(links: list[tuple[str, str]]) -> str:
    """sh run in the VM by doctor: SKILLOK / SKILLBAD <name> <reason> for every configured skill."""
    body = "\n".join(
        f't={shlex.quote(t)}; n={shlex.quote(sk)}; '
        'if [ ! -f "$t/SKILL.md" ]; then echo "SKILLBAD $n not-mounted"; '
        f'elif [ ! -L "{SKILLS_VM_DIR}/$n" ]; then echo "SKILLBAD $n not-linked"; '
        f'elif [ "$(readlink "{SKILLS_VM_DIR}/$n")" != "$t" ]; then echo "SKILLBAD $n points-elsewhere"; '
        'else echo "SKILLOK $n"; fi' for sk, t in links)
    return body + "\ntrue"


def parse_skill_lines(out: str, words: tuple[str, ...]) -> list[tuple[str, str, str]]:
    """[(word, skill, reason)] for lines like `LINK name` / `SKIP name reason`; anything else is dropped."""
    found = []
    for line in out.splitlines():
        m = re.fullmatch(r"(%s) ([a-z0-9][a-z0-9-]*)(?: ([a-z-]+))?" % "|".join(words), line.strip())
        if m:
            found.append((m.group(1), m.group(2), m.group(3) or ""))
    return found


SKILL_SKIP_WHY = {"not-mounted": "its folder is not mounted in this sandbox - a new skill set needs `agentbox fresh`",
                  "foreign-link": "~/.claude/skills already has a symlink of that name that agentbox did not make",
                  "exists": "~/.claude/skills already has a folder of that name (a skill written in the sandbox)"}


def link_skills(prof: Profile, quiet: bool = False) -> bool:
    """Link the profile's skills in a sandbox that is RUNNING (callers check). True on success."""
    links = prof.skill_links()
    r = vm_exec(prof, skills_link_script(links))

    def say(msg):
        if quiet:                           # the agent's UI owns the terminal
            with open(prof.state / "skills.out", "a") as f:
                f.write(safe_text(msg) + "\n")
        else:
            info(msg)
    if r.returncode != 0:
        say(f"could not link skills in {prof.sandbox} (exit {r.returncode}) {(r.stderr or '').strip()[:200]}")
        return False
    for _, sk, why in parse_skill_lines(r.stdout or "", ("SKIP",)):
        say(f"skill '{sk}' not linked: {SKILL_SKIP_WHY.get(why, why)}")
    prof.state.mkdir(parents=True, exist_ok=True)
    if links:
        (prof.state / "skills.json").write_text(json.dumps([sk for sk, _ in links]))
    else:
        (prof.state / "skills.json").unlink(missing_ok=True)
    return True


def link_skills_when_running(prof: Profile, timeout: float = 180.0, interval: float = 2.0):
    """Background half of sync_skills: wait for a VM that something else (`sbx run`, `sbx exec`) is
    booting, then link once. Never boots it itself."""
    deadline = time.monotonic() + timeout
    try:
        while time.monotonic() < deadline:
            vm = sandbox_state(prof)
            if vm == "running":
                link_skills(prof, quiet=True)
                return
            if vm == "missing":
                return
            time.sleep(interval)
    except SystemExit:
        pass


def sync_skills(prof: Profile, background: bool = True):
    """Link the profile's skills (and drop links agentbox made for sets no longer configured) if the
    sandbox is running. A stopped sandbox is never booted for this: with background=True a thread
    links once something else has started it. Profiles that never used skills cost nothing."""
    if not prof.d["skills"] and not (prof.state / "skills.json").exists():
        return
    if prof.d["skills"]:
        prof.require_skills()
    if sandbox_state(prof) == "running":
        link_skills(prof)
    elif background:
        info("sandbox is not running; skills are linked as soon as it is")
        threading.Thread(target=link_skills_when_running, args=(prof,), daemon=True).start()
    else:
        info(f"sandbox {prof.sandbox} is not running; skills not linked (`agentbox up {prof.name}` links them)")


def cmd_up(prof: Profile, args) -> int:
    cfg = prof.cfg
    ensure_sandbox(prof)
    sync_skills(prof)
    run = ["run", "--name", prof.sandbox]
    # the permission mode first, so the session starts in it whatever sbx's agent defaults to
    agent_args = prof.mode_args(interactive=True) + list(args.agent_args or prof.d["agent_args"])
    if agent_args:
        run += ["--", *agent_args]
    r = sbx(cfg, *run, check=False)
    print(f"\nSession ended (sandbox {prof.sandbox} still exists).\n"
          f"  review host-side risk:  agentbox audit {prof.name}\n"
          f"  pause:                  agentbox stop {prof.name}\n"
          f"  destroy everything:     agentbox down {prof.name}")
    return r.returncode


def find_vscode(cfg: Config) -> str:
    c = cfg.settings["vscode"]
    found = shutil.which(c) or (c if Path(c).is_file() else None)
    if found:
        return found
    for p in VSCODE_APP_CLIS:
        if Path(p).is_file():
            return p
    die(f"VS Code CLI '{c}' not found. On macOS run 'Shell Command: Install code command in PATH' in VS Code;"
        " on Linux install the code package (apt, snap, flatpak) so `code` is on PATH. Or set `vscode = \"/path/to/code\"` in [settings]")


def ssh_config_has_sbx() -> bool:
    f = HOME / ".ssh" / "config"
    return f.exists() and "docker sandboxes (managed)" in f.read_text(errors="replace")


def cmd_code(prof: Profile, args) -> int:
    cfg = prof.cfg
    code = find_vscode(cfg)
    host = f"{prof.sandbox}.sbx"
    if not shutil.which("ssh"):
        die("ssh client not found")
    folder = xp(args.path) if args.path else prof.primary
    if prof.d["mode"] == "direct" and not any(is_within(folder, r) for r in prof.roots):
        die(f"{folder} isn't one of this sandbox's workspaces: {', '.join(map(str, prof.roots))}", EXIT_USAGE)
    if not ssh_config_has_sbx():
        info("configuring SSH for *.sbx hosts (sbx setup ssh)")
        sbx(cfg, "setup", "ssh")

    # Our ~/.ssh/config could still forward the agent (e.g. `Host *` + ForwardAgent yes);
    # VS Code Remote-SSH honours that. Refuse rather than leak the SSH agent in.
    eff = subprocess.run(["ssh", "-G", host], capture_output=True, text=True).stdout.lower()
    if "\nforwardagent yes" in "\n" + eff and not cfg.settings["forward_ssh_agent"]:
        die(f"your SSH config forwards the agent to {host}. Add this ABOVE any `Host *` block in ~/.ssh/config:\n\n"
            "    Host *.sbx\n        ForwardAgent no\n")

    if not prof.d.get("vscode"):
        info(f"profile '{prof.name}' doesn't set `vscode = true`, so VS Code's server download and"
             " Marketplace may be blocked. Either set it and `agentbox fresh`, or set"
             " \"remote.SSH.localServerDownload\": \"always\" in VS Code to copy the server from your Mac.")

    ensure_sandbox(prof)

    info(f"checking SSH to {host}")
    r = subprocess.run(["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=60", host, "true"],
                       env=sbx_env(cfg), capture_output=True, text=True)
    if r.returncode != 0:
        die(f"`ssh {host} true` failed:\n{r.stderr.strip()}\n"
            f"Is the sandbox running? Try `agentbox up {prof.name}` (or `sbx ls`), then re-run."
            " For host-key errors: delete the 'docker sandboxes (managed)' block in ~/.ssh/config and run `sbx setup ssh`.")

    sync_skills(prof, background=False)             # the ssh check above started the VM
    info(f"opening {folder} in VS Code on {host}")
    subprocess.run([code, "--remote", f"ssh-remote+{host}", str(folder)], env=sbx_env(cfg), check=False)
    print(f"Terminals, tasks, debuggers and extensions in that window run inside {prof.sandbox}.\n"
          f"Run `agentbox audit {prof.name}` before using these files in a local (non-remote) window.")
    return 0


# ------------------------------------------------- the VS Code extension (share/vscode)
# Plain JavaScript, no build step: `vscode install` zips share/vscode into a .vsix (a zip with a manifest
# and [Content_Types].xml; no node or vsce) and hands it to `code --install-extension`.
VSCODE_EXT_DIR = SHARE_DIR / "vscode"
VSCODE_EXT_FILES = ("package.json", "extension.js", "model.js", "README.md", "media/agentbox.svg")
VSIX_CONTENT_TYPES = """<?xml version="1.0" encoding="utf-8"?>
<Types xmlns="http://schemas.openxmlformats.org/package/2006/content-types">
<Default Extension=".json" ContentType="application/json"/><Default Extension=".js" ContentType="application/javascript"/>
<Default Extension=".md" ContentType="text/markdown"/><Default Extension=".svg" ContentType="image/svg+xml"/>
<Default Extension=".vsixmanifest" ContentType="text/xml"/>
</Types>
"""


def vscode_ext_package(src: Path = None) -> dict:
    src = src or VSCODE_EXT_DIR
    try:
        return json.loads((src / "package.json").read_text(encoding="utf-8"))
    except (OSError, ValueError) as e:
        die(f"cannot read the VS Code extension at {src}: {e} - reinstall agentbox")


def vsix_manifest(pkg: dict) -> str:
    from xml.sax.saxutils import escape, quoteattr
    a = {k: quoteattr(str(pkg[k])) for k in ("name", "version", "publisher")}
    return f"""<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011">
  <Metadata>
    <Identity Language="en-US" Id={a["name"]} Version={a["version"]} Publisher={a["publisher"]}/>
    <DisplayName>{escape(pkg["displayName"])}</DisplayName>
    <Description xml:space="preserve">{escape(pkg["description"])}</Description>
    <Categories>Other</Categories>
    <Properties>
      <Property Id="Microsoft.VisualStudio.Code.Engine" Value={quoteattr(pkg["engines"]["vscode"])}/>
      <Property Id="Microsoft.VisualStudio.Code.ExtensionKind" Value="ui"/>
    </Properties>
  </Metadata>
  <Installation><InstallationTarget Id="Microsoft.VisualStudio.Code"/></Installation>
  <Dependencies/>
  <Assets>
    <Asset Type="Microsoft.VisualStudio.Code.Manifest" Path="extension/package.json" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.Details" Path="extension/README.md" Addressable="true"/>
  </Assets>
</PackageManifest>
"""


def pack_vsix(out_dir: Path, src: Path = None) -> Path:
    """share/vscode as <name>-<version>.vsix in out_dir."""
    import zipfile
    src = src or VSCODE_EXT_DIR
    pkg = vscode_ext_package(src)
    out = Path(out_dir) / f"{pkg['name']}-{pkg['version']}.vsix"
    try:
        with zipfile.ZipFile(out, "w", zipfile.ZIP_DEFLATED) as z:
            z.writestr("[Content_Types].xml", VSIX_CONTENT_TYPES)
            z.writestr("extension.vsixmanifest", vsix_manifest(pkg))
            for f in VSCODE_EXT_FILES:
                z.write(src / f, f"extension/{f}")
    except OSError as e:
        die(f"cannot pack the VS Code extension from {src}: {e} - reinstall agentbox")
    return out


def vscode_installed_version(code: str, ext_id: str) -> str | None:
    """The installed version, None if not installed; dies if VS Code can't list its extensions."""
    r = subprocess.run([code, "--list-extensions", "--show-versions"], capture_output=True, text=True, check=False)
    if r.returncode != 0:
        die(f"'{code} --list-extensions' failed (exit {r.returncode}): {(r.stderr or r.stdout or '').strip()[:300]}")
    for line in (r.stdout or "").splitlines():
        ident, _, ver = line.strip().partition("@")
        if ident.lower() == ext_id.lower():
            return ver
    return None


def cmd_vscode(args) -> int:
    """`agentbox vscode install|status|uninstall`: the dashboard extension in the host's VS Code."""
    if CONFIG_FILE.exists():                 # [settings] vscode, if set
        code = find_vscode(Config())
    else:                                    # no config yet: `code` on PATH, else the app bundles
        code = shutil.which(DEFAULT_SETTINGS["vscode"]) or next((p for p in VSCODE_APP_CLIS if Path(p).is_file()), None)
        if not code:
            die("VS Code CLI 'code' not found. On macOS run 'Shell Command: Install code command in PATH' in VS Code")
    pkg = vscode_ext_package()
    ext_id = f"{pkg['publisher']}.{pkg['name']}"
    have = vscode_installed_version(code, ext_id) if args.action != "install" else None
    if args.action == "status":
        state = "missing" if have is None else "current" if have == pkg["version"] else "outdated"
        if args.json:
            emit_json({"id": ext_id, "state": state, "installed": have, "available": pkg["version"], "code": code})
        else:
            print(f"{ext_id}: {state} (installed {have or '-'}, this agentbox has {pkg['version']})")
        return EXIT_OK
    if args.action == "uninstall":
        if have is None:
            print(f"{ext_id}: not installed")
            return EXIT_OK
        r = subprocess.run([code, "--uninstall-extension", ext_id], check=False)
        return EXIT_OK if r.returncode == 0 else EXIT_FAIL
    with tempfile.TemporaryDirectory(prefix="agentbox-vsix-") as d:
        vsix = pack_vsix(Path(d))
        # --force: reinstall over the same version too, so `install` after an agentbox upgrade always takes
        r = subprocess.run([code, "--install-extension", str(vsix), "--force"], check=False)
    if r.returncode != 0:
        return EXIT_FAIL
    print(f"{ext_id} {pkg['version']} installed: reload VS Code's windows (Developer: Reload Window) to start it")
    return EXIT_OK


# ------------------------------------------------- the Rex actions (share/rex) in ~/.config/rex/init.lua
# `rex setup` appends one marked block to init.lua and `rex remove` deletes exactly that block; nothing else in
# the file is touched. Lines that load agentbox without the markers (added by hand, as the installer used to
# suggest) are "manual" and left alone.
REX_BEGIN = "-- agentbox: added by `agentbox rex setup`; `agentbox rex remove` deletes this block"
REX_END = "-- end agentbox"
REX_REQUIRE_RE = re.compile(r"""^\s*require\s*\(?\s*["']agentbox["']""", re.M)


def rex_init_lua() -> Path:
    return Path.home() / ".config" / "rex" / "init.lua"     # not HOME: read at call time, as rex_block() does


def rex_block() -> str:
    """The block for this agentbox's share/rex. A Lua string: forward slashes (Rex takes them on Windows too)."""
    d = (SHARE_DIR / "rex").as_posix()
    home = Path.home().as_posix()
    if not IS_WIN and d.startswith(home + "/"):          # as install.sh printed it: survives a renamed home
        path = 'os.getenv("HOME") .. ' + lua_str(d[len(home):] + "/?.lua;")
    else:
        path = lua_str(d + "/?.lua;")
    return f'{REX_BEGIN}\npackage.path = {path} .. package.path\nrequire("agentbox").setup{{}}\n{REX_END}\n'


def write_text_atomic(path: Path, text: str, mode: int | None = None):
    """Replace path's contents in one rename. Text is written as given (no newline translation). Mode: the
    given one, else the file's own (0644 for a new file). A symlink is written through: its target is
    replaced and the link kept (an init.lua kept in a dotfiles repo stays linked)."""
    path = Path(os.path.realpath(path))
    if mode is None:
        try:
            mode = stat.S_IMODE(path.stat().st_mode)
        except FileNotFoundError:
            mode = 0o644
    fd, name = tempfile.mkstemp(prefix=f".{path.name}.", suffix=".tmp", dir=path.parent)
    tmp = Path(name)
    try:
        with os.fdopen(fd, "w", encoding="utf-8", newline="") as f:
            f.write(text)
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    finally:
        tmp.unlink(missing_ok=True)


def lua_str(s: str) -> str:
    return '"' + s.replace("\\", "\\\\").replace('"', '\\"') + '"'


def rex_block_span(text: str) -> tuple[int, int] | None:
    """(start, end) of our block in init.lua's text, end past its line ending; None if absent. Both markers
    must be whole lines, and the block is the end marker's nearest begin marker: a begin left behind by a
    hand edit (its end line deleted) never pairs with a later block's end, which would take the user's lines
    in between with it."""
    begin = None
    pos = 0
    for line in text.splitlines(keepends=True):
        bare = line.rstrip("\r\n")
        if bare == REX_BEGIN:
            begin = pos
        elif bare == REX_END and begin is not None:
            return begin, pos + len(line)
        pos += len(line)
    return None


def rex_setup_state(text: str | None) -> str:
    """missing | current | outdated (our block, for another path) | manual (loaded without our markers)."""
    if text is None:
        return "missing"
    span = rex_block_span(text)
    if span:
        ours = text[span[0]:span[1]].replace("\r\n", "\n").rstrip("\n")
        return "current" if ours == rex_block().rstrip("\n") else "outdated"
    return "manual" if REX_REQUIRE_RE.search(text) else "missing"


def cmd_rex(args) -> int:
    """`agentbox rex setup|status|remove`: the agentbox actions in Rex's init.lua."""
    f = rex_init_lua()
    try:
        with open(f, encoding="utf-8", newline="") as fh:     # newline="": CRLF kept, written back as found
            text = fh.read()
    except FileNotFoundError:
        text = None
    except UnicodeDecodeError:
        die(f"cannot read {f}: it isn't UTF-8. Save it as UTF-8, or add the lines by hand (see `agentbox rex status`)")
    except OSError as e:
        die(f"cannot read {f}: {e.strerror}")
    nl = "\r\n" if text and "\r\n" in text else "\n"

    def write(new: str):
        try:
            f.parent.mkdir(parents=True, exist_ok=True)
            write_text_atomic(f, new)
        except OSError as e:
            die(f"cannot write {f}: {e.strerror or e}")

    state = rex_setup_state(text)
    actions = SHARE_DIR / "rex" / "agentbox.lua"
    if args.action == "status":
        if args.json:
            emit_json({"init_lua": str(f), "state": state, "actions": str(actions), "actions_present": actions.is_file()})
        else:
            print(f"{state:<9} {f}")
            if not actions.is_file():
                print(f"the Rex actions aren't installed at {actions}: run the installer again")
        return EXIT_OK
    if args.action == "remove":
        if state in ("current", "outdated"):
            i, j = rex_block_span(text)
            write(text[:i] + text[j:])
            print(f"removed the agentbox block from {f}; restart Rex (or reload its config) to drop the actions")
        elif state == "manual":
            print(f"left alone: {f} loads agentbox with lines agentbox didn't write; delete them by hand")
        else:
            print(f"not set up: {f}")
        return EXIT_OK
    if not actions.is_file():
        die(f"the Rex actions aren't installed at {actions}: run the installer again (it copies them when it finds Rex)")
    if state == "current":
        print(f"current: {f}")
        return EXIT_OK
    if state == "manual":
        print(f"left alone: {f} already loads agentbox with lines agentbox didn't write. To let agentbox manage it,"
              " delete those lines and run `agentbox rex setup` again")
        return EXIT_OK
    block = rex_block().replace("\n", nl)                  # in the file's own line endings
    if state == "outdated":
        i, j = rex_block_span(text)
        new = text[:i] + block + text[j:]
    else:
        base = text or ""
        new = base + (nl if base and not base.endswith("\n") else "") + (nl if base.strip() else "") + block
    write(new)
    print(f"{'updated' if state == 'outdated' else 'added'} the agentbox block in {f}; restart Rex (or reload its config)"
          " and the command palette has the actions under \"agentbox\"")
    return EXIT_OK



# ------------------------------------------------- sessions and unsaved work across `fresh`
# Recreating a sandbox is a new VM: sbx (0.54) keeps no volume across `sbx rm`, so the agent's session
# history and, in clone mode, the working tree would go with it. `fresh` copies the sessions out and back;
# `down`/`fresh` refuse to drop clone-mode work the host does not have.
SESSION_DIRS = {"claude": f"{VM_HOME}/.claude/projects"}    # agent -> in-VM dir of resumable sessions
SHA_RE = re.compile(r"^[0-9a-f]{40}([0-9a-f]{24})?$")
# The clone's path is passed as $1 (never an sbx-provided variable): a guard that cannot find the
# working tree must say so, not report that nothing would be lost.
UNSAVED_WORK_SCRIPT = r'''cd "$1" 2>/dev/null || { echo NOWS; exit 0; }
git rev-parse --git-dir >/dev/null 2>&1 || { echo NOWS; exit 0; }
echo "DIRTY $(git status --porcelain 2>/dev/null | wc -l)"
echo "STASH $(git stash list 2>/dev/null | wc -l)"
git for-each-ref --format="REF %(objectname) %(refname:short)" refs/heads'''


def clone_unsaved_work(prof: Profile) -> list[str]:
    """What removing this clone-mode sandbox would lose: branches whose head the host repo lacks,
    uncommitted changes, stashes. Empty when there is nothing (or it is not clone mode)."""
    if prof.d["mode"] != "clone":
        return []
    ws = vm_path(prof.primary)
    r = vm_exec(prof, f"set -- {shlex.quote(ws)}\n{UNSAVED_WORK_SCRIPT}")
    if r.returncode != 0:
        return [f"could not look inside {prof.sandbox} (exit {r.returncode}): {(r.stderr or '').strip()[:200]}"]
    lost = []
    for ln in (r.stdout or "").splitlines():
        kind, _, rest = ln.partition(" ")
        if kind == "NOWS":
            lost.append(f"possibly anything: no git working tree found at {ws} inside {prof.sandbox}")
        elif kind in ("DIRTY", "STASH") and rest.strip().isdigit() and int(rest) > 0:
            lost.append(f"{int(rest)} uncommitted change(s)" if kind == "DIRTY" else f"{int(rest)} stash entr(y/ies)")
        elif kind == "REF":
            sha, _, branch = rest.partition(" ")
            if not SHA_RE.match(sha):           # VM output: never handed to git unchecked
                continue
            if host_git(prof, "cat-file", "-e", f"{sha}^{{commit}}", check=False).returncode != 0:
                lost.append(f"branch {safe_text(branch)} ({sha[:12]}) has commits the host does not")
    return lost


def _strip_links(root: Path):
    """Agent-written copies hold plain files only: drop symlinks and anything special, both ways."""
    for dirpath, dirnames, filenames in os.walk(root):
        for n in dirnames + filenames:
            q = Path(dirpath) / n
            if q.is_symlink() or not (q.is_dir() or q.is_file()):
                q.unlink()


def save_sessions(prof: Profile) -> str | None:
    """Copy the agent's sessions out of the sandbox into the state dir. None when done (or nothing to
    do), else what went wrong."""
    src = SESSION_DIRS.get(prof.d["agent"])
    if not src:
        return None
    probe = vm_exec(prof, f"test -d {shlex.quote(src)}")
    if probe.returncode != 0:
        return None if probe.returncode == 1 else f"could not reach {prof.sandbox} (exit {probe.returncode})"
    tmp, dest = prof.state / "sessions.new", prof.state / "sessions"
    shutil.rmtree(tmp, ignore_errors=True)
    tmp.mkdir(parents=True)
    r = sbx(prof.cfg, "cp", f"{prof.sandbox}:{src}", str(tmp), check=False, capture=True)
    got = tmp / PurePosixPath(src).name
    if r.returncode != 0 or not got.is_dir():
        shutil.rmtree(tmp, ignore_errors=True)
        return f"`sbx cp` failed (exit {r.returncode}): {((r.stderr or '') + (r.stdout or '')).strip()[:300]}"
    _strip_links(tmp)
    shutil.rmtree(dest, ignore_errors=True)
    tmp.rename(dest)
    return None


def restore_sessions(prof: Profile):
    """Put sessions saved by `fresh` back into the new sandbox, owned by the agent."""
    saved = prof.state / "sessions"
    dst = SESSION_DIRS.get(prof.d["agent"])
    src = saved / PurePosixPath(dst).name if dst else None
    if not src or not src.is_dir():
        return
    _strip_links(saved)
    parent = str(PurePosixPath(dst).parent)
    r = sbx(prof.cfg, "exec", "--user", "0", prof.sandbox, "sh", "-c",
            f"mkdir -p {shlex.quote(parent)} && rm -rf {shlex.quote(dst)}", check=False, capture=True)
    if r.returncode == 0:   # root may just have created the parent (~/.claude): Claude Code must own it
        r = sbx(prof.cfg, "exec", "--user", "0", prof.sandbox, "chown", "1000:1000", parent,
                check=False, capture=True)
    if r.returncode == 0:
        r = sbx(prof.cfg, "cp", str(src), f"{prof.sandbox}:{parent}", check=False, capture=True)
    if r.returncode == 0:
        r = sbx(prof.cfg, "exec", "--user", "0", prof.sandbox, "chown", "-R", "1000:1000", dst,
                check=False, capture=True)
    if r.returncode != 0:
        info(f"could not restore the saved sessions into {prof.sandbox}; they are kept in {saved}")
        return
    n = sum(1 for _ in src.rglob("*.jsonl"))
    shutil.rmtree(saved, ignore_errors=True)
    info(f"restored {n} saved session(s) into {prof.sandbox}")


# ---------------------------------------------------------------- prebuilt templates
# `agentbox template <profile>` creates a throwaway sandbox from the profile's agent and kits ONLY
# (no generated kit - it holds the bridge token -, no secrets, an empty workspace), lets the kits'
# install hooks run, and saves it with `sbx template save`. New sandboxes of that profile then start
# from the snapshot (`--template TAG --pull never`), so apt installs are already done. The record is
# keyed by a fingerprint of the agent and the kits' files: change a kit and the template is ignored.
TEMPLATE_REPO = "agentbox-{name}"


def template_record_path(prof: Profile) -> Path:
    return prof.cfg.state_root / "templates" / f"{prof.name}.json"


def template_fingerprint(prof: Profile) -> str:
    h = hashlib.sha256(json.dumps([prof.d["agent"], prof.d["kits"]]).encode())
    for k in prof.kit_paths():
        for f in sorted(q for q in k.rglob("*") if q.is_file()):
            h.update(f.relative_to(k).as_posix().encode() + b"\0" + f.read_bytes() + b"\0")
    return h.hexdigest()


def template_record(prof: Profile) -> dict | None:
    try:
        rec = json.loads(template_record_path(prof).read_text())
    except (OSError, ValueError):
        return None
    ok = isinstance(rec, dict) and isinstance(rec.get("tag"), str) and isinstance(rec.get("fingerprint"), str)
    return rec if ok and TEMPLATE_TAG_RE.match(rec["tag"]) else None


def built_template(prof: Profile) -> str | None:
    """The tag to create this profile's sandbox from, or None (no template, or the kits changed)."""
    rec = template_record(prof)
    if not rec:
        return None
    if rec["fingerprint"] != template_fingerprint(prof):
        info(f"the prebuilt template {rec['tag']} predates a change to the agent or kits; not using it."
             f" Rebuild it with `agentbox template {prof.name}`")
        return None
    if template_image_present(prof.cfg, rec["tag"]) is False:
        # `sbx template rm`, an image prune or an sbx reset: `create --pull never` would fail on every `up`
        info(f"the prebuilt template {rec['tag']} is no longer in sbx's image store; creating without it."
             f" Rebuild it with `agentbox template {prof.name}`")
        template_record_path(prof).unlink(missing_ok=True)
        return None
    return rec["tag"]


def template_image_present(cfg: Config, tag: str) -> bool | None:
    """Whether sbx's local image store holds TAG (repo:tag); None when the listing cannot be read,
    in which case the caller goes ahead as before rather than dropping a template that may be fine."""
    r = sbx(cfg, "template", "ls", "--json", check=False, capture=True)
    try:
        images = json.loads(r.stdout or "") if r.returncode == 0 else None
    except ValueError:
        images = None
    if not isinstance(images, list):
        return None
    repo, _, want = tag.partition(":")
    return any(isinstance(i, dict) and i.get("tag") == want
               and str(i.get("repository", "")).rsplit("/", 1)[-1] == repo for i in images)


TEMPLATE_TAG_RE = re.compile(r"^agentbox-[a-z0-9][a-z0-9-]{0,40}:\d{14}$")


def cmd_template(prof: Profile, args) -> int:
    cfg = prof.cfg
    rec = template_record(prof)
    if args.remove:
        if rec:
            sbx(cfg, "template", "rm", "--force", rec["tag"], check=False, capture=True)
        template_record_path(prof).unlink(missing_ok=True)
        info(f"removed {rec['tag']}" if rec else f"profile '{prof.name}' has no prebuilt template")
        return EXIT_OK
    if prof.d.get("template"):
        die(f"profile '{prof.name}' sets template = \"{prof.d['template']}\" itself; remove that to use a prebuilt one",
            EXIT_USAGE)
    if not prof.d["kits"]:
        die(f"profile '{prof.name}' has no kits, so there is nothing to prebuild", EXIT_USAGE)
    box = f"{prof.sandbox}-tpl"
    tag = TEMPLATE_REPO.format(name=prof.name) + ":" + time.strftime("%Y%m%d%H%M%S", time.gmtime())
    fingerprint = template_fingerprint(prof)
    ws = Path(tempfile.mkdtemp(prefix="agentbox-tpl-"))
    try:
        sbx(cfg, "rm", "--force", box, check=False, capture=True)       # ours: left over from a failed build
        create = ["create", "--name", box]
        for k in prof.kit_paths():
            create += ["--kit", str(k)]
        info(f"building {tag}: creating {box} with {prof.d['agent']} + {', '.join(prof.d['kits'])}"
             " (the kits' install steps run now; this can take a while)")
        sbx(cfg, *create, prof.agent_ref(), str(ws))
        sbx(cfg, "stop", box, check=False, capture=True)
        info(f"saving {box} as {tag}")
        sbx(cfg, "template", "save", box, tag)
    finally:
        sbx(cfg, "rm", "--force", box, check=False, capture=True)
        shutil.rmtree(ws, ignore_errors=True)
    path = template_record_path(prof)
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps({"tag": tag, "fingerprint": fingerprint,
                                "created": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())}))
    if rec and rec["tag"] != tag:
        sbx(cfg, "template", "rm", "--force", rec["tag"], check=False, capture=True)
    info(f"new {prof.name} sandboxes start from {tag}; `agentbox fresh {prof.name}` to use it now."
         " Rebuild after kit changes, or to pick up a newer agent version.")
    return EXIT_OK


def cmd_down(prof: Profile, args) -> int:
    force = getattr(args, "force", False)
    if not force and not sys.stdin.isatty():
        die("sbx asks for confirmation before removing a sandbox and stdin is not a terminal;"
            " pass --force to skip it", EXIT_USAGE)
    job = job_info(prof)
    if job["state"] == "running":
        if not force:
            die(f"job {job['id']} is still running in {prof.sandbox}; removing the sandbox would kill it."
                f" Wait for it (`agentbox wait {prof.name}`) or pass --force")
        info(f"--force: killing running job {job['id']}")
        vm_exec(prof, kill_script(job["id"]))
    keep_sessions = getattr(args, "keep_sessions", False)
    exists = sandbox_exists(prof)
    if exists and not force:
        lost = clone_unsaved_work(prof)
        if lost:
            die(f"{prof.sandbox} is in clone mode and removing it would lose:\n  - " + "\n  - ".join(lost)
                + f"\nFetch what you want first (`agentbox fetch {prof.name} --start [--branch ...]`), or pass"
                  " --force to drop it.")
    if exists and keep_sessions:
        problem = save_sessions(prof)
        if problem and force:
            info(f"WARNING: could not save the agent's sessions from {prof.sandbox}: {problem}."
                 " --force: removing it anyway; its sessions are lost.")
        elif problem:
            die(f"could not save the agent's sessions from {prof.sandbox}: {problem}."
                " Nothing was removed; fix that, pass --force to drop them, or use `agentbox down` and `up`.")
    if (prof.state / "snapshot.json").exists():
        cmd_audit(prof)
        print()
    stop_bridge(prof)
    stop_keepalive(prof)
    if exists:
        r = sbx(prof.cfg, "rm", *(["--force"] if force else []), prof.sandbox, check=False, capture=True)
        if sandbox_exists(prof):        # sbx rm can fail (or be declined) and still leave a sandbox behind
            detail = ((r.stderr or "") + (r.stdout or "")).strip()
            die(f"`sbx rm` did not remove {prof.sandbox} (exit {r.returncode}); keeping its secrets and state."
                + (f"\n{detail}" if detail else ""))
    remove_secrets(prof)
    if not args.keep_state and prof.state.exists():
        if keep_sessions and (prof.state / "sessions").is_dir():
            for q in prof.state.iterdir():          # everything but the saved sessions
                if q.name != "sessions":
                    shutil.rmtree(q) if q.is_dir() and not q.is_symlink() else q.unlink()
        else:
            shutil.rmtree(prof.state)
    info(f"{prof.sandbox} removed")
    return 0


# ------------------------------------------------------------ headless jobs
# A job is one headless agent run started by `agentbox run`. It lives INSIDE the VM in
# ~/.agentbox/jobs/<id>/ (prompt.md, wrap.sh, pid, output.jsonl, stderr.log, started_at,
# finished_at, exit_code, session_id); the host keeps only prof.state/job.json. State is
# derived from those files plus /proc/<pid>/cmdline - never from `pgrep -f`, which matches
# its own command line. The prompt travels on stdin only, never on an argv.
JOB_ID_RE = re.compile(r"^\d{8}T\d{6}Z-[0-9a-f]{6}$")
SESSION_ID_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_-]{7,79}$")   # never starts with '-': it ends up in an argv
TIMESTAMP_RE = re.compile(r"^\d{4}-\d\d-\d\dT\d\d:\d\d:\d\dZ$")
JOB_DIR = '"$HOME/.agentbox/jobs/{id}"'
HEADLESS_AGENTS = {         # agent -> headless command, and the flag that resumes a session
    # + the permission mode: `--permission-mode auto`, or `--dangerously-skip-permissions` (Profile.mode_args)
    "claude": {"cmd": ["claude", "-p", "--output-format", "stream-json", "--verbose"], "resume": "--resume"},
    # `opencode run` reads the prompt from stdin when it is not a terminal (and appends any message
    # words, of which we pass none), so the prompt stays off the argv here too. --auto approves tool
    # permissions (opencode 1.19: `--dangerously-skip-permissions` is a hidden alias).
    "opencode": {"cmd": ["opencode", "run", "--format", "json", "--auto"], "resume": "--session"},
}
NO_JOB = {"id": None, "state": "none", "exit_code": None, "session_id": None,
          "started_at": None, "finished_at": None, "vm": None,     # vm: sandbox state when last checked
          "branch": None, "end_head": None}     # the branch and commit the workspace ended on (ended jobs only)


def new_job_id() -> str:
    return time.strftime("%Y%m%dT%H%M%SZ", time.gmtime()) + "-" + pysecrets.token_hex(3)


def check_job_id(job_id: str) -> str:
    if not JOB_ID_RE.match(job_id):
        die(f"bad job id '{job_id}'", EXIT_USAGE)
    return job_id


def probe_script(job_id: str) -> str:
    """sh run in the VM: print the live process's cmdline and the job's state files, and cache the
    session id (from the stream's first session_id) into the job dir. ORDER MATTERS: look at the
    process first and the files after. The wrapper writes exit_code before it exits, so a process
    seen dead already has its exit_code on disk; reading the files first would call a job that
    finishes mid-probe "lost" (and a lost job is cached for good)."""
    d = JOB_DIR.format(id=check_job_id(job_id))
    return (
        f'd={d}; echo "D $d"; [ -d "$d" ] || {{ echo MISSING; exit 0; }}; '
        'p=$(cat "$d/pid" 2>/dev/null); case $p in *[!0-9]*|"") p=;; esac; '
        '[ -n "$p" ] && [ -r "/proc/$p/cmdline" ] && echo "CMD $(tr \'\\0\' \' \' < "/proc/$p/cmdline")"; '
        'if [ ! -s "$d/session_id" ]; then grep -m1 -o -E \'"(session_id|sessionID)":"[^"]*"\' "$d/output.jsonl" 2>/dev/null '
        '| head -n1 | sed \'s/.*":"\\([^"]*\\)".*/\\1/\' > "$d/session_id.tmp"; '
        '[ -s "$d/session_id.tmp" ] && mv "$d/session_id.tmp" "$d/session_id" || rm -f "$d/session_id.tmp"; fi; '
        'for f in pid started_at finished_at session_id exit_code branch end_head; do '
        '[ -f "$d/$f" ] && echo "F $f $(head -c 200 "$d/$f" | tr -d \'\\n\')"; done; true')


def hold_script(job_id: str) -> str:
    """sh run in the VM by the keep-alive: an open exec session that ends when the job does."""
    d = JOB_DIR.format(id=check_job_id(job_id))
    return (f'd={d}; w="$d/wrap.sh"; while [ ! -e "$d/exit_code" ]; do p=$(cat "$d/pid" 2>/dev/null) || break; '
            'case $p in *[!0-9]*|"") break;; esac; grep -qa -- "$w" "/proc/$p/cmdline" 2>/dev/null || break; '
            'sleep 5; done')


def kill_script(job_id: str) -> str:
    """sh run in the VM: signal the job's wrapper and what it started - the ONLY place a job pid
    read from a file is signalled. With setsid the wrapper leads its own process group and the whole
    group gets the signal; without it (no `setsid` in the VM) there is no such group, so the
    wrapper's direct children are signalled first (pkill -P, or /proc/*/stat if pkill is absent)
    and then the wrapper. The pid file is agent-writable, so never trust it: it must
    be digits, > 1 (PID 1 is the VM's init: TERM to it takes the whole sandbox down), not this
    shell or its parent, and /proc/<pid>/cmdline must contain THIS job's wrap.sh path."""
    d = JOB_DIR.format(id=check_job_id(job_id))
    return (f'd={d}; w="$d/wrap.sh"; p=$(cat "$d/pid" 2>/dev/null); '
            'case $p in ""|*[!0-9]*) exit 0;; esac; '
            '[ "$p" -gt 1 ] 2>/dev/null || exit 0; '
            '[ "$p" -ne "$$" ] && [ "$p" -ne "$PPID" ] || exit 0; '
            'grep -qa -- "$w" "/proc/$p/cmdline" 2>/dev/null || exit 0; '
            'if kill -TERM -- "-$p" 2>/dev/null; then :; else '
            'if command -v pkill >/dev/null 2>&1; then pkill -TERM -P "$p" 2>/dev/null; '
            'else for s in /proc/[0-9]*/stat; do read -r l < "$s" 2>/dev/null || continue; '
            'set -- ${l##*) }; [ "$2" = "$p" ] || continue; c=${s#/proc/}; c=${c%/stat}; '
            '[ "$c" -gt 1 ] 2>/dev/null && kill -TERM "$c" 2>/dev/null; done; fi; '
            'kill -TERM "$p" 2>/dev/null; fi; true')


def parse_probe(out: str) -> dict:
    res = {"dir": None, "missing": False, "files": {}, "cmdline": None}
    for line in out.splitlines():
        if line.startswith("D "):
            res["dir"] = line[2:].strip()
        elif line.strip() == "MISSING":
            res["missing"] = True
        elif line.startswith("F "):
            parts = line.split(" ", 2) + [""]
            res["files"][parts[1]] = parts[2].strip()
        elif line.startswith("CMD "):
            res["cmdline"] = line[4:]
    return res


def classify_job(probe: dict) -> str:
    """finished if exit_code exists; running if the pid file's process is alive AND its cmdline
    runs this job's wrapper (a reused pid runs something else); lost otherwise (VM rebooted...)."""
    if probe["missing"]:
        return "lost"
    if "exit_code" in probe["files"]:
        return "finished"
    pid = probe["files"].get("pid", "")
    wrapper = f"{probe['dir']}/wrap.sh"
    if pid.isdigit() and probe["cmdline"] is not None and wrapper in probe["cmdline"].split():
        return "running"
    return "lost"


def job_record(prof: Profile) -> dict:
    try:
        return json.loads((prof.state / "job.json").read_text())
    except (OSError, ValueError):
        return {}


def save_job_record(prof: Profile, rec: dict):
    prof.state.mkdir(parents=True, exist_ok=True)
    (prof.state / "job.json").write_text(json.dumps(rec, indent=1))


def job_summary(job_id: str, state: str, files: dict) -> dict:
    code = files.get("exit_code")
    sid = files.get("session_id")
    ended = state != "running"
    return {"id": job_id, "state": state,
            "exit_code": (int(code) if code and code.lstrip("-").isdigit() else 1) if state == "finished" else None,
            "session_id": sid if sid and SESSION_ID_RE.match(sid) else None,
            "started_at": _timestamp(files.get("started_at")), "finished_at": _timestamp(files.get("finished_at")),
            "branch": job_branch(files.get("branch")) if ended else None,
            "end_head": _commit(files.get("end_head")) if ended else None}


def _timestamp(value) -> str | None:
    return value if isinstance(value, str) and TIMESTAMP_RE.match(value) else None


def probe_job(prof: Profile, job_id: str) -> dict | None:
    """Exec the probe in the VM (this starts a stopped sandbox: check sandbox_state first)."""
    r = sbx_retry(prof.cfg, "exec", prof.sandbox, "sh", "-c", probe_script(job_id))
    return parse_probe(r.stdout or "") if r.returncode == 0 else None


def job_info(prof: Profile, job_id: str | None = None, states=_FETCH) -> dict:
    """Current state of a job (default: the profile's recorded one). Never boots a stopped VM,
    and makes no sbx call at all once the job is known to be finished or lost - neither comes back."""
    rec = job_record(prof)
    job_id = job_id or rec.get("id")
    if not job_id:
        return dict(NO_JOB)
    mine = rec.get("id") == job_id
    if mine and rec.get("state") in ("finished", "lost"):
        return {k: rec.get(k) for k in NO_JOB} | {"id": job_id}
    known = {k: rec.get(k) for k in ("session_id", "started_at", "finished_at", "branch", "end_head")} if mine else {}
    vm = sandbox_state(prof, states)
    if vm != "running":
        # The process died with the VM. "unknown" (daemon unreachable) isn't certain: don't cache it,
        # and flag it so `wait` can double-check.
        out = job_summary(job_id, "lost", known) | {"vm": vm}
        if vm == "unknown":
            return out | {"probe_failed": True}
    else:
        probe = probe_job(prof, job_id)
        if probe is None:
            return job_summary(job_id, "lost", known) | {"vm": "unknown", "probe_failed": True}
        out = job_summary(job_id, classify_job(probe), {**known, **probe["files"]}) | {"vm": "running"}
    if mine and out["state"] != "running":
        save_job_record(prof, {**rec, **{k: out[k] for k in NO_JOB if k != "id"}, "id": job_id})
        note_job_ended(prof, job_id, out)
    elif mine and out["session_id"] and rec.get("session_id") != out["session_id"]:
        save_job_record(prof, {**rec, "session_id": out["session_id"]})
    return out


def public_job(info_: dict) -> dict:
    return {k: info_.get(k) for k in NO_JOB}


def session_id_from_stream(text: str) -> str | None:
    """First session id in a transcript: claude stream-json's `session_id` (its system/init message) or
    opencode's `sessionID` (on every event)."""
    for line in text.splitlines():
        try:
            obj = json.loads(line)
        except ValueError:
            continue
        sid = (obj.get("session_id") or obj.get("sessionID")) if isinstance(obj, dict) else None
        if isinstance(sid, str) and SESSION_ID_RE.match(sid):
            return sid
    return None


def _squash(text, width: int = 200) -> str:
    text = " ".join(str(text).split())
    return text if len(text) <= width else text[:width - 1] + "…"


def render_stream_line(line: str) -> str | None:
    """One human line for a stream-json event (assistant text, tool calls, init, result).
    Everything in it is agent-controlled, so the result is passed through safe_text()."""
    try:
        ev = json.loads(line)
    except ValueError:
        return safe_text(f"? {_squash(line)}") if line.strip() else None
    if not isinstance(ev, dict):
        return None
    kind = ev.get("type")
    if kind in OPENCODE_EVENTS:
        return render_opencode_event(ev)
    if kind == "system" and ev.get("subtype") == "init":
        mode = f" mode {_squash(ev['permissionMode'], 30)}" if isinstance(ev.get("permissionMode"), str) else ""
        return safe_text(f"[init] session {ev.get('session_id', '?')} model {ev.get('model', '?')}{mode}")
    if kind == "user":
        denied = [f"denied: {_squash(d)}" for d in map(denial_text, tool_results(ev)) if d is not None]
        return safe_text("\n".join(denied)) or None
    if kind == "assistant":
        parts = []
        content = (ev.get("message") or {}).get("content")
        for block in content if isinstance(content, list) else []:
            if not isinstance(block, dict):
                continue
            if block.get("type") == "text" and str(block.get("text", "")).strip():
                parts.append(f"assistant: {_squash(block['text'])}")
            elif block.get("type") == "tool_use":
                parts.append(f"tool: {_squash(block.get('name', '?'), 60)} "
                             f"{_squash(json.dumps(block.get('input', {})), 120)}")
        return safe_text("\n".join(parts)) or None
    if kind == "result":
        return safe_text(f"[result] {ev.get('subtype', '?')}: {_squash(ev.get('result', ''))}".rstrip(": "))
    return None


# How Claude Code (2.1.306) words a tool call its permission check refused: the tool_result (is_error) text
# starts with one of these. The first is auto mode's classifier; the second any other refusal, such as a
# deny rule. Read from the claude binary; the end-of-run `result` event also lists them (permission_denials).
DENIAL_PREFIXES = ("Permission for this action was denied by the Claude Code auto mode classifier.",
                   "Permission for this action has been denied.")


def tool_results(ev: dict) -> list[dict]:
    """The tool_result blocks of a stream-json `user` event."""
    msg = ev.get("message")
    content = msg.get("content") if isinstance(msg, dict) else None
    return [b for b in content if isinstance(b, dict) and b.get("type") == "tool_result"] \
        if isinstance(content, list) else []


def denial_text(block: dict) -> str | None:
    """The text of a tool_result that is a permission denial, else None."""
    if block.get("is_error") is not True:
        return None
    c = block.get("content")
    if isinstance(c, list):
        c = next((x.get("text") for x in c if isinstance(x, dict) and x.get("type") == "text"), None)
    if not isinstance(c, str):
        return None
    c = c.strip()
    c = c[len("<tool_use_error>"):].lstrip() if c.startswith("<tool_use_error>") else c
    return c if c.startswith(DENIAL_PREFIXES) else None


# `opencode run --format json`: one JSON object per line, {"type", "timestamp" (ms), "sessionID", ...}.
# step_start / step_finish (with the step's tokens) frame each model call, tool_use comes once per finished
# tool call, text once per finished text part, reasoning only with --thinking, error for a session error.
# Read from opencode 1.19.6's `run` command; tests/fixtures/opencode-run.jsonl is one such stream.
OPENCODE_EVENTS = {"step_start", "step_finish", "tool_use", "text", "reasoning", "error"}


def _part(ev: dict) -> dict:
    return ev["part"] if isinstance(ev.get("part"), dict) else {}


def render_opencode_event(ev: dict) -> str | None:
    kind, part = ev.get("type"), _part(ev)
    if kind == "text" and str(part.get("text", "")).strip():
        return safe_text(f"assistant: {_squash(part['text'])}")
    if kind == "reasoning" and str(part.get("text", "")).strip():
        return safe_text(f"thinking: {_squash(part['text'])}")
    if kind == "tool_use":
        state = part.get("state") if isinstance(part.get("state"), dict) else {}
        failed = " [failed]" if state.get("status") == "error" else ""
        return safe_text(f"tool: {_squash(part.get('tool', '?'), 60)} "
                         f"{_squash(json.dumps(state.get('input', {})), 120)}{failed}")
    if kind == "error":
        err = ev.get("error") if isinstance(ev.get("error"), dict) else {}
        data = err.get("data") if isinstance(err.get("data"), dict) else {}
        return safe_text(f"[error] {_squash(err.get('name', '?'), 60)}: {_squash(data.get('message', ''))}".rstrip(": "))
    return None


def vm_exec(prof: Profile, script: str, stdin: str | None = None):
    args = ["exec"] + (["-i"] if stdin is not None else []) + [prof.sandbox, "sh", "-c", script]
    return sbx_retry(prof.cfg, *args, stdin=stdin)


def vm_write(prof: Profile, job_id: str, name: str, data: str):
    """Write a file into the job dir through the exec's stdin (0600; data never on an argv)."""
    d = JOB_DIR.format(id=check_job_id(job_id))
    r = vm_exec(prof, f'umask 077; d={d}; mkdir -p "$d" && cat > "$d/{name}"', stdin=data)
    if r.returncode != 0:
        die(f"could not write {name} into the sandbox (exit {r.returncode})\n{r.stderr or ''}".rstrip())


def keepalive_pid(prof: Profile) -> int | None:
    return _pid_of(prof.state / "keepalive.pid", "keepalive", prof.name)


def start_keepalive(prof: Profile):
    """Host-side, on by default (`--no-keepalive` / `keepalive = false` opt out): hold an `sbx exec` session
    open while the job runs. sbx stops a sandbox with no open session ~30 s after the last one, killing
    a detached job."""
    if keepalive_pid(prof):
        return
    log = open(prof.state / "keepalive.out", "a")
    p = subprocess.Popen([sys.executable, str(Path(__file__).resolve()), "keepalive", prof.name],
                         stdout=log, stderr=log, stdin=subprocess.DEVNULL, **detached_popen_kwargs(),
                         env=child_env())
    (prof.state / "keepalive.pid").write_text(str(p.pid))


def stop_keepalive(prof: Profile):
    pid = keepalive_pid(prof)
    if pid:
        terminate(pid)
    (prof.state / "keepalive.pid").unlink(missing_ok=True)


def cmd_keepalive(prof: Profile) -> int:
    """Internal (started by `run`): keep one exec session open until the job is no longer running."""
    job_id = job_record(prof).get("id")
    if not job_id:
        return EXIT_OK
    held: list = []

    def on_term(*_):
        if held:
            held[0].terminate()
        sys.exit(0)

    on_sigterm(on_term)
    cmd = [prof.cfg.settings["sbx"], "exec", prof.sandbox, "sh", "-c", hold_script(job_id)]
    drops = unknown = 0
    while True:
        vm = sandbox_state(prof)            # our own `sbx exec` would boot a stopped VM: never do that
        if vm in ("stopped", "missing"):
            return EXIT_OK
        if vm == "unknown":                 # daemon unreachable: keep trying for a while
            unknown += 1
            if unknown >= 10:
                return EXIT_OK
            time.sleep(backoff_delay(unknown, 1.0, 30.0))
            continue
        unknown = 0
        held[:] = [subprocess.Popen(cmd, env=sbx_env(prof.cfg), stdin=subprocess.DEVNULL,
                                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)]
        held[0].wait()
        j = job_info(prof, job_id)
        if j["state"] != "running":
            cache_final_progress(prof, job_id, j)
            return EXIT_OK
        time.sleep(backoff_delay(drops, 1.0, 30.0))      # the session dropped but the job lives: re-hold
        drops = min(drops + 1, 10)


def job_exit_status(j: dict) -> int:
    if j["state"] == "finished":
        return j["exit_code"] if j["exit_code"] is not None else EXIT_FAIL
    return EXIT_LOST


def poll_delays(first: float = 2.0, cap: float = 30.0):
    d = first
    while True:
        yield d
        d = min(cap, d * 1.5)


def resolve_job(prof: Profile, arg: str | None) -> str:
    job_id = arg or job_record(prof).get("id")
    if not job_id:
        die(f"no job recorded for profile '{prof.name}' - start one with `agentbox run {prof.name} ...`", EXIT_USAGE)
    return check_job_id(job_id)


def cmd_wait(prof: Profile, args) -> int:
    rex = RexStatus(rex_wanted())
    try:
        return _wait(prof, args, rex)
    except KeyboardInterrupt:
        rex.report({"state": "idle"}, prof.name)
        raise


def _wait(prof: Profile, args, rex: RexStatus) -> int:
    job_id = resolve_job(prof, args.job)
    deadline = time.monotonic() + args.timeout if args.timeout else None
    delays, doubts = poll_delays(), 0
    while True:
        j = job_info(prof, job_id)
        if j["state"] == "finished":
            cache_final_progress(prof, job_id, j)
            rex.report(rex_fields(j), prof.name)
            info(f"job {job_id} finished (exit {j['exit_code']})"
                 + (f"; `agentbox fetch {prof.name}` brings its commits to the host" if prof.d["mode"] == "clone" else ""))
            return job_exit_status(j)
        if j["state"] == "lost":
            doubts += 1                     # one flaky probe isn't "lost"
            if not j.get("probe_failed") or doubts >= 3:
                rex.report(rex_fields(j), prof.name)
                info(f"job {job_id} lost (its process is gone; sandbox {j['vm']})")
                return EXIT_LOST
        else:
            doubts = 0
            rex.report(rex_fields(j), prof.name)
        if deadline is not None and time.monotonic() >= deadline:
            rex.report({"state": "idle"}, prof.name)   # no longer watched
            info(f"job {job_id} still running after {args.timeout:g}s")
            return EXIT_TIMEOUT
        time.sleep(min(next(delays), max(0.0, deadline - time.monotonic()) if deadline else 1e9))


def require_running(prof: Profile, start: bool = False):
    """Reading from the VM (`sbx exec`) would boot a stopped sandbox; only do that if asked (--start)."""
    vm = sandbox_state(prof)
    if vm == "running" or (start and vm in ("stopped", "unknown")):
        return
    if vm == "unknown":
        die(f"cannot tell whether {prof.sandbox} is running (`sbx ls --json` failed)")
    die(f"sandbox {prof.sandbox} is {vm}; its job output can't be read without starting it"
        + (" (pass --start to boot it)" if vm == "stopped" else ""), EXIT_NO_SANDBOX)


def fetch_new_lines(prof: Profile, job_id: str, have: int, start: bool = False, final: bool = False) -> list[str]:
    """Complete lines of output.jsonl after the first `have` ones. A last line without its newline
    is still being written, unless the job is over (`final`): then it is the real end of the output."""
    require_running(prof, start)
    d = JOB_DIR.format(id=job_id)
    r = vm_exec(prof, f'tail -n +{have + 1} {d}/output.jsonl 2>/dev/null')
    if r.returncode != 0:
        die(f"could not read the job output (exit {r.returncode}) - is {prof.sandbox} running?")
    *lines, partial = (r.stdout or "").split("\n")
    return lines + [partial] if final and partial else lines


def cmd_logs(prof: Profile, args, follow: bool | None = None) -> int:
    job_id = resolve_job(prof, args.job)
    follow = args.follow if follow is None else follow
    have, delays = 0, poll_delays(1.0, 10.0)
    while True:
        j = job_info(prof, job_id)          # sampled BEFORE the read, so a finished job's tail is complete
        lines = fetch_new_lines(prof, job_id, have, getattr(args, "start", False), final=j["state"] != "running")
        have += len(lines)
        for ln in lines:
            shown = safe_text(ln) if args.raw else render_stream_line(ln)
            if shown:
                print(shown, flush=True)
        if not follow:
            return EXIT_OK
        if j["state"] != "running":         # state was sampled before the read, so the tail is in
            return job_exit_status(j) if getattr(args, "wait_status", False) else EXIT_OK
        time.sleep(next(delays))


PROGRESS_PROMPT = ('Progress reporting: before you start, record your plan with `jobprogress plan "<step>" ...` '
                   '(3 to 12 steps); run `jobprogress start <n>` and `jobprogress done <n>` as you go, and '
                   '`jobprogress note "<status>"` for anything the user should know. Keep it accurate: the user watches it.')


def headless_cmd(prof: Profile, spec: dict) -> list[str]:
    """The agent's headless argv. The prompt is never in it: the job wrapper feeds prompt.md on stdin."""
    lm = prof.local_model
    # the model is in the generated opencode config too; on the argv a workspace opencode.json can't override it
    return [*spec["cmd"], *prof.mode_args(interactive=False),
            *([f"--model={OPENCODE_PROVIDER}/{lm['model']}"] if lm else [])]


MODE_CHECK_WAIT = 30         # seconds `run` waits for Claude's init event to see the permission mode it started in
CLAUDE_MODES = {"default", "plan", "acceptEdits", "bypassPermissions", "dontAsk", "auto"}   # init's permissionMode


def mode_check_script(job_id: str, wait: float = MODE_CHECK_WAIT) -> str:
    """sh run in the VM: wait for the job's stream-json init event and print `INIT <permissionMode>`
    (empty if it has none); or, if the job ends first, `EXITED <code>`, `---` and the start of stderr.log;
    or TIMEOUT. One exec, so `run` costs no extra sbx round trips while it waits."""
    d = JOB_DIR.format(id=check_job_id(job_id))
    return textwrap.dedent("""\
        d=@D@; i=0
        while [ $i -lt @N@ ]; do
          l=$(head -c 1048576 "$d/output.jsonl" 2>/dev/null | grep -a -m1 '"subtype":"init"')
          if [ -n "$l" ]; then
            m=$(printf %s "$l" | grep -o '"permissionMode":"[A-Za-z]*"' | head -n1 | cut -d'"' -f4)
            echo "INIT $m"; exit 0
          fi
          if [ -e "$d/exit_code" ]; then
            echo "EXITED $(head -c 20 "$d/exit_code" | tr -d '\\n')"; echo ---
            head -c 2000 "$d/stderr.log" 2>/dev/null; exit 0
          fi
          sleep 0.2; i=$((i + 1))
        done
        echo TIMEOUT
        """).replace("@D@", d).replace("@N@", str(int(wait * 5)))


def check_auto_mode(prof: Profile, job_id: str):
    """For an auto-mode Claude job: die - and stop the job - if Claude Code did not start in auto mode.
    When auto mode is unavailable (plan, model, settings, version) Claude Code says so in its own UI and
    carries on in another mode; headless, that is only visible as the init event's permissionMode. An older
    Claude Code that does not know the mode exits at once with a usage error instead."""
    hint = (f"To run jobs without auto mode, set permission_mode = \"bypass\" in [profiles.{prof.name}] of"
            f" {CONFIG_FILE} (the sandbox stays the boundary; README: \"Permission mode\").")
    r = vm_exec(prof, mode_check_script(job_id))
    out = (r.stdout or "") if r.returncode == 0 else ""
    first, _, rest = out.partition("\n")
    if first.startswith("INIT "):
        mode = first[5:].strip()
        if mode == "auto" or mode not in CLAUDE_MODES:
            return                                  # auto, or a Claude Code that doesn't say: carry on
        vm_exec(prof, kill_script(job_id))
        die(f"Claude Code started job {job_id} in {mode!r} mode, not auto mode: auto mode is not available"
            f" here (plan, model, settings or Claude Code version), so the job was stopped. {hint}")
    elif first.startswith("EXITED "):
        code = first[7:].strip()
        err = safe_text(rest.partition("---\n")[2]).strip()
        if code != "0" and re.search(r"permission.?mode|auto mode", err, re.I):
            die(f"job {job_id} exited at once (exit {code}): Claude Code did not accept auto mode:\n"
                f"{err[:600]}\n{hint}")
    elif first.strip() == "TIMEOUT":
        info(f"could not confirm auto mode yet: no init event from Claude within {MODE_CHECK_WAIT}s;"
             f" `agentbox logs {prof.name}` shows the mode on its [init] line")


def cmd_run(prof: Profile, args) -> int:
    agent = prof.d["agent"]
    spec = HEADLESS_AGENTS.get(agent)
    if not spec:
        die(f"headless jobs support {', '.join(HEADLESS_AGENTS)} (profile agent is '{agent}')", EXIT_USAGE)
    if args.prompt_file:
        try:
            prompt = sys.stdin.read() if args.prompt_file == "-" else Path(args.prompt_file).read_text()
        except OSError as e:
            die(f"cannot read prompt file: {e.strerror}", EXIT_USAGE)
    else:
        prompt = args.prompt or ""
    if not prompt.strip():
        die("empty prompt", EXIT_USAGE)
    if len(prompt) > 1_000_000:
        die("prompt is over 1 MB", EXIT_USAGE)
    report = not getattr(args, "no_progress", False)
    expect = getattr(args, "expect_commits", None)
    if expect is not None and not 1 <= expect <= 10000:
        die("--expect-commits must be between 1 and 10000", EXIT_USAGE)
    current = job_record(prof).get("id")
    if current and job_info(prof, current)["state"] == "running":
        die(f"job {current} is still running in {prof.sandbox}; `agentbox wait {prof.name}` for it first")
    ensure_sandbox(prof, retry=True)
    job_id = new_job_id()
    vm_write(prof, job_id, "prompt.md", (PROGRESS_PROMPT + "\n\n" if report else "") + prompt)
    vm_write(prof, job_id, "wrap.sh", (SHARE_DIR / "jobwrap").read_text())
    if report:
        vm_write(prof, job_id, "jobprogress", (SHARE_DIR / "jobprogress").read_text())
    sync_skills(prof, background=False)             # the exec above started the VM, if it was stopped
    cmd = [*headless_cmd(prof, spec), *(args.agent_args or [])]
    d = JOB_DIR.format(id=job_id)
    # start_head: HEAD before the agent runs, so `progress` can count the commits it makes
    r = vm_exec(prof, (f'd={d}; S=; command -v setsid >/dev/null 2>&1 && S=setsid; '
                       f'git -C {shlex.quote(vm_path(prof.primary))} rev-parse HEAD > "$d/start_head" 2>/dev/null || :; '
                       f'$S nohup sh "$d/wrap.sh" "$d" {shlex.quote(vm_path(prof.primary))} {shlex.join(cmd)} '
                       '>/dev/null 2>&1 </dev/null & i=0; '
                       'while [ ! -s "$d/pid" ] && [ $i -lt 50 ]; do sleep 0.1; i=$((i+1)); done; [ -s "$d/pid" ]'))
    if r.returncode != 0:
        die(f"the job did not start inside {prof.sandbox} (exit {r.returncode})\n{r.stderr or ''}".rstrip())
    record_history(prof)                            # the job this one replaces in job.json, if it never was
    save_job_record(prof, {"id": job_id, "agent": agent, "session_id": None, "expect_commits": expect,
                           "title": brief_title(prompt)})
    overridden = any(a.startswith(("--permission-mode", "--dangerously-skip-permissions")) for a in args.agent_args or [])
    if prof.permission_mode == "auto" and not overridden:      # --agent-args chose a mode: theirs to judge
        check_auto_mode(prof, job_id)
    keep = getattr(args, "keepalive", None)
    if prof.d["keepalive"] if keep is None else keep:
        start_keepalive(prof)
    info(f"job {job_id} started in {prof.sandbox}")
    print(job_id)
    if args.detach:
        info(f"follow with `agentbox logs {prof.name} -f`, block with `agentbox wait {prof.name}`"
             + (f", then `agentbox fetch {prof.name}` for the commits" if prof.d["mode"] == "clone" else ""))
        return EXIT_OK
    args.job, args.follow, args.raw, args.wait_status = job_id, True, False, True
    return cmd_logs(prof, args)


def cmd_resume(prof: Profile, args) -> int:
    spec = HEADLESS_AGENTS.get(prof.d["agent"])
    if not spec:
        die(f"resume is not supported for agent '{prof.d['agent']}' (only: {', '.join(HEADLESS_AGENTS)})", EXIT_USAGE)
    job_id = resolve_job(prof, args.job)
    if not sandbox_exists(prof, retry=True):
        die(f"sandbox {prof.sandbox} not found", EXIT_NO_SANDBOX)
    j = job_info(prof, job_id)
    if j["state"] == "running":
        die(f"job {job_id} is still running; `agentbox wait {prof.name}` first")
    if not j["session_id"] and j["vm"] != "running":
        probe = probe_job(prof, job_id)       # `sbx run` below boots the sandbox anyway
        j = job_summary(job_id, j["state"], probe["files"]) if probe else j
    if not j["session_id"]:
        die(f"no session id recorded for job {job_id} (did the agent start?)")
    ensure_sandbox(prof)
    sync_skills(prof)
    sid = j["session_id"]
    if not SESSION_ID_RE.match(sid):          # belt and braces: the id comes from an agent-writable file
        die(f"refusing to resume: malformed session id for job {job_id}")
    # `--resume=<id>` / `--session=<id>` (claude and opencode accept it) so the id can never be read as a separate option
    return sbx(prof.cfg, "run", "--name", prof.sandbox, "--", *prof.mode_args(interactive=True),
               f"{spec['resume']}={sid}", check=False).returncode


# ------------------------------------------------------------ job progress
# `agentbox progress`, and the progress part of `status`. Two kinds of data, kept apart on purpose:
#   MEASURED  - computed here from the job's output.jsonl (turns, tool calls, tokens, cost, time since
#               the last event) and from git in the VM (commits since the job started);
#   REPORTED  - the plan and note the agent wrote with `jobprogress`. The agent can misreport these.
# Everything that comes out of the VM is agent-controlled: parsed defensively, capped, safe_text'd.
PROGRESS_CACHE = "progress.cache.json"      # state dir: byte offset into output.jsonl + running totals
PROGRESS_CHUNK = 8 * 1024 * 1024            # most output.jsonl bytes fetched per exec
MAX_PLAN_STEPS, MAX_STEP_CHARS, MAX_NOTE_CHARS = 50, 200, 300
MAX_SEEN_IDS, MAX_TOOL_NAMES = 20000, 100
TOKEN_KEYS = ("input", "output", "cache_read", "cache_creation")
# USD per million tokens, (input, output, cache read, cache write 5m) by model family. NEEDS CHECKING
# against current pricing before anyone relies on it: the figures are the first-party list prices of
# the newest model in each family as of 2026-10, and the cache write rate is an assumption (1.25x
# input). Older models of a family cost more. This only feeds the "~ estimate" shown while a job
# runs; a finished job shows the exact total_cost_usd from the agent's own result.
PRICES = {
    "opus": (4.00, 20.00, 0.20, 5.00),
    "sonnet": (2.00, 10.00, 0.20, 2.50),
    "haiku": (0.10, 0.50, 0.01, 0.125),
    "fable": (10.00, 50.00, 0.25, 12.50),
}


def model_family(model) -> str | None:
    low = model.lower() if isinstance(model, str) else ""
    return next((f for f in PRICES if f in low), None)


def new_acc(job_id: str) -> dict:
    return {"job": job_id, "offset": 0, "turns": 0, "tool_calls": 0, "tools": {}, "tokens": {},
            "last_ts": None, "result": None, "commits": None, "plan": [], "note": "", "seen": [], "denials": 0}


def acc_ok(d, job_id: str) -> bool:
    """Is d (read from a file) a usable accumulator for this job?"""
    if not isinstance(d, dict) or d.get("job") != job_id:
        return False
    d.setdefault("denials", 0)                  # a cache from before denials were counted
    return all(isinstance(d.get(k), type(v)) for k, v in new_acc(job_id).items() if v is not None) \
        and not isinstance(d["offset"], bool)


def event_time(v) -> float | None:
    """Seconds since the epoch from an event's "timestamp" (ISO 8601, or a number of s / ms)."""
    try:
        if isinstance(v, bool):
            return None
        if isinstance(v, (int, float)):
            return float(v) / 1000 if v > 1e11 else float(v)
        if isinstance(v, str) and 10 <= len(v) <= 40:
            t = datetime.datetime.fromisoformat(v.replace("Z", "+00:00"))
            return (t if t.tzinfo else t.replace(tzinfo=datetime.timezone.utc)).timestamp()
    except (ValueError, OverflowError, OSError):
        pass
    return None


def _count(v) -> int:
    return v if isinstance(v, int) and not isinstance(v, bool) and 0 <= v <= 10 ** 12 else 0


def ingest(acc: dict, text: str):
    """Fold complete stream-json lines (claude) or opencode JSON events into the totals. stream-json
    repeats a message id across content-block events (each repeats the usage), so a message id counts -
    and bills - once. The two formats share no event type, so each line says which one it is."""
    seen = set(acc["seen"])
    for line in text.split("\n"):
        line = line.strip()
        if not line.startswith("{"):
            continue
        try:
            ev = json.loads(line)
        except (ValueError, RecursionError):
            continue
        if not isinstance(ev, dict):
            continue
        ts = event_time(ev.get("timestamp"))
        if ts is not None and (acc["last_ts"] is None or ts > acc["last_ts"]):
            acc["last_ts"] = ts
        kind = ev.get("type")
        if kind in OPENCODE_EVENTS:
            ingest_opencode(acc, ev, seen)
        elif kind == "assistant" and isinstance(ev.get("message"), dict):
            msg = ev["message"]
            mid = msg.get("id")
            key = f"m:{mid[:200]}" if isinstance(mid, str) and mid else None
            if key is None or key not in seen:
                if key and len(seen) < MAX_SEEN_IDS:
                    seen.add(key)
                acc["turns"] += 1
                usage = msg.get("usage")
                if isinstance(usage, dict):
                    row = acc["tokens"].setdefault(model_family(msg.get("model")) or "other", dict.fromkeys(TOKEN_KEYS, 0))
                    for k, src in zip(TOKEN_KEYS, ("input_tokens", "output_tokens", "cache_read_input_tokens",
                                                   "cache_creation_input_tokens")):
                        row[k] = row.get(k, 0) + _count(usage.get(src))
            content = msg.get("content")
            for block in content if isinstance(content, list) else []:
                if not isinstance(block, dict) or block.get("type") != "tool_use":
                    continue
                bid = block.get("id")
                if _seen_once(seen, f"t:{bid[:200]}" if isinstance(bid, str) and bid else None):
                    _count_tool(acc, block.get("name"))
        elif kind == "user":
            for block in tool_results(ev):
                if denial_text(block) is None:
                    continue
                bid = block.get("tool_use_id")
                if _seen_once(seen, f"d:{bid[:200]}" if isinstance(bid, str) and bid else None):
                    acc["denials"] += 1
        elif kind == "result":
            cost = ev.get("total_cost_usd")
            ok = isinstance(cost, (int, float)) and not isinstance(cost, bool) and 0 <= cost <= 1e6
            acc["result"] = {"cost": float(cost) if ok else None}
    acc["seen"] = sorted(seen)


def _seen_once(seen: set, key: str | None) -> bool:
    """True the first time `key` is seen (None: no id, always counted)."""
    if key is None:
        return True
    if key in seen:
        return False
    if len(seen) < MAX_SEEN_IDS:
        seen.add(key)
    return True


def _count_tool(acc: dict, name):
    acc["tool_calls"] += 1
    name = name[:64] if isinstance(name, str) else "?"
    if name not in acc["tools"] and len(acc["tools"]) >= MAX_TOOL_NAMES:
        name = "(other)"
    acc["tools"][name] = acc["tools"].get(name, 0) + 1


def ingest_opencode(acc: dict, ev: dict, seen: set):
    """One `opencode run --format json` event (see OPENCODE_EVENTS). A turn is a step (one model call),
    counted at its step_start; its tokens come with its step_finish. opencode's own cost is ignored: it
    is 0 for a local model, and anything else has no price here, so cost stays null."""
    kind, part = ev.get("type"), _part(ev)
    pid = part.get("id")
    key = f"o:{pid[:200]}" if isinstance(pid, str) and pid else None
    if kind == "step_start" and _seen_once(seen, key):
        acc["turns"] += 1
    elif kind == "step_finish" and isinstance(part.get("tokens"), dict) and _seen_once(seen, key):
        t = part["tokens"]
        cache = t.get("cache") if isinstance(t.get("cache"), dict) else {}
        row = acc["tokens"].setdefault("other", dict.fromkeys(TOKEN_KEYS, 0))
        # reasoning tokens are output the model generated; opencode counts them apart
        for k, n in (("input", _count(t.get("input"))), ("output", _count(t.get("output")) + _count(t.get("reasoning"))),
                     ("cache_read", _count(cache.get("read"))), ("cache_creation", _count(cache.get("write")))):
            row[k] = row.get(k, 0) + n
    elif kind == "tool_use" and _seen_once(seen, key):
        _count_tool(acc, part.get("tool"))


def parse_plan(lines: list[str]) -> tuple[list[dict], str]:
    """progress.tsv lines ("<kind>\\t<text>") -> (steps, note). Malformed lines are skipped, the
    plan is capped at MAX_PLAN_STEPS, text at its limit, the last note wins."""
    steps, note = [], ""
    for ln in lines:
        kind, tab, text = ln.rstrip("\r").partition("\t")
        if not tab:
            continue
        text = text.strip()
        if kind in ("pending", "active", "done"):
            if len(steps) < MAX_PLAN_STEPS:
                steps.append({"text": safe_text(text[:MAX_STEP_CHARS]), "status": kind})
        elif kind == "note":
            note = safe_text(text[:MAX_NOTE_CHARS])
    return steps, note


def progress_script(job_id: str, offset: int, workspace: Path, final: bool) -> str:
    """sh run in the VM, ONE exec: print numbers first (SIZE START CONSUMED COMMITS TSV), then `---`,
    then the first TSV lines of progress.tsv (as many as TSV says), then the new, complete lines of
    output.jsonl past `offset`, reduced to printable ASCII (all the host needs; so a byte count in the
    VM is a character count here). The numbers come before anything the agent wrote, so it cannot
    forge them. The file shrinking (it is agent-writable) is reported as SHRUNK and read from 0."""
    d = JOB_DIR.format(id=check_job_id(job_id))
    return textwrap.dedent("""\
        d=@D@; o=@O@; cap=@CAP@; final=@FINAL@; ws=@WS@
        [ -d "$d" ] || { echo MISSING; exit 0; }
        t="$d/.progress.t.$$"; c="$d/.progress.c.$$"; trap 'rm -f "$t" "$c"' EXIT
        sz=$(wc -c < "$d/output.jsonl" 2>/dev/null | tr -d ' '); sz=${sz:-0}
        if [ "$sz" -lt "$o" ]; then o=0; echo SHRUNK; fi
        tail -c +$((o + 1)) "$d/output.jsonl" 2>/dev/null | head -c "$cap" > "$c"
        n=$(wc -c < "$c" | tr -d ' '); l=$(wc -l < "$c" | tr -d ' ')
        if [ "$final" = 1 ]; then k=$n
        elif [ "$l" -gt 0 ]; then k=$(head -n "$l" "$c" | wc -c | tr -d ' ')
        elif [ "$n" -ge "$cap" ]; then k=$n
        else k=0; fi
        s=$(head -c 64 "$d/start_head" 2>/dev/null | tr -d '\\n'); m=none
        case $s in ""|*[!0-9a-f]*) ;; *) if [ ${#s} -eq 40 ]; then
          x=$(git -C "$ws" rev-list --count "$s..HEAD" 2>/dev/null) && case $x in ""|*[!0-9]*) ;; *) m=$x;; esac
        fi;; esac
        { head -n 60 "$d/progress.tsv" 2>/dev/null | head -c 20000; echo; } > "$t"
        echo "SIZE $sz"; echo "START $o"; echo "CONSUMED $k"; echo "COMMITS $m"
        echo "TSV $(wc -l < "$t" | tr -d ' ')"; echo ---
        cat "$t"
        head -c "$k" "$c" | tr -cd '\\n\\040-\\176'
        """).replace("@D@", d).replace("@O@", str(int(offset))).replace("@CAP@", str(PROGRESS_CHUNK)) \
        .replace("@FINAL@", "1" if final else "0").replace("@WS@", shlex.quote(str(workspace)))


def parse_progress_out(out: str) -> dict | None:
    head, sep, rest = out.partition("\n---\n")
    if not sep:
        return None
    vals, shrunk = {}, False
    for ln in head.splitlines():
        key, _, v = ln.partition(" ")
        if key == "SHRUNK":
            shrunk = True
        elif key in ("SIZE", "START", "CONSUMED", "TSV") and v.isdigit():
            vals[key] = int(v)
        elif key == "COMMITS":
            vals[key] = int(v) if v.isdigit() else None
    if not all(k in vals for k in ("SIZE", "START", "CONSUMED", "TSV")):
        return None
    parts = rest.split("\n", vals["TSV"])
    return {"size": vals["SIZE"], "start": vals["START"], "consumed": vals["CONSUMED"], "shrunk": shrunk,
            "commits": vals.get("COMMITS"), "tsv": parts[:vals["TSV"]],
            "chunk": parts[vals["TSV"]] if len(parts) > vals["TSV"] else ""}


def load_acc(prof: Profile, job_id: str) -> dict:
    try:
        d = json.loads((prof.state / PROGRESS_CACHE).read_text())
    except (OSError, ValueError):
        d = None
    return d if acc_ok(d, job_id) else new_acc(job_id)


def save_acc(prof: Profile, acc: dict):
    prof.state.mkdir(parents=True, exist_ok=True)
    tmp = prof.state / (PROGRESS_CACHE + ".tmp")
    tmp.write_text(json.dumps(acc))
    os.replace(tmp, prof.state / PROGRESS_CACHE)


def refresh_progress(prof: Profile, job_id: str, final: bool) -> dict | None:
    """Fetch what is new in the job's files (one exec per round; a round is up to PROGRESS_CHUNK bytes)
    and fold it into the cached totals. None if the VM could not be read. Only call for a RUNNING VM."""
    acc, got = load_acc(prof, job_id), False
    for _ in range(8):
        r = vm_exec(prof, progress_script(job_id, acc["offset"], vm_path(prof.primary), final))
        raw = parse_progress_out(r.stdout or "") if r.returncode == 0 else None
        if raw is None:
            return acc if got else None
        got = True
        if raw["shrunk"] or raw["start"] != acc["offset"]:
            acc = new_acc(job_id)               # the file was replaced or truncated: recount from 0
        ingest(acc, raw["chunk"])
        acc["offset"] = min(raw["start"] + raw["consumed"], raw["size"])
        acc["commits"] = raw["commits"]
        acc["plan"], acc["note"] = parse_plan(raw["tsv"])
        if raw["size"] - raw["start"] <= PROGRESS_CHUNK:
            break
    save_acc(prof, acc)
    return acc


def estimate_cost(acc: dict) -> float | None:
    total, any_tokens = 0.0, False
    for fam, row in acc["tokens"].items():
        counts = [_count(row.get(k)) for k in TOKEN_KEYS]
        if not sum(counts):
            continue
        any_tokens = True
        if fam not in PRICES:
            return None                         # a model we have no price for: no number beats a wrong one
        total += sum(n * p for n, p in zip(counts, PRICES[fam])) / 1e6
    return round(total, 4) if any_tokens else None


def iso_epoch(v) -> float | None:
    return float(calendar.timegm(time.strptime(v, "%Y-%m-%dT%H:%M:%SZ"))) if _timestamp(v) else None


def progress_view(prof: Profile, acc: dict, j: dict, rec: dict, now: float) -> dict:
    """The job.progress object (see README, "Watching a job")."""
    running = j["state"] == "running"
    start, finish = iso_epoch(j.get("started_at")), iso_epoch(j.get("finished_at"))
    last = acc["last_ts"]
    end = now if running else (finish or last or now)
    elapsed = max(0, int(end - start)) if start else None
    ref = last or start
    stalled = bool(running and ref is not None and now - ref > prof.d["stall_after"])
    cost, estimate = acc["result"]["cost"] if acc["result"] else None, False
    if cost is None:
        cost = estimate_cost(acc)
        estimate = cost is not None
    tokens = {k: sum(_count(row.get(k)) for row in acc["tokens"].values()) for k in TOKEN_KEYS}
    steps = acc["plan"]
    plan = {"steps": steps, "current": next((i + 1 for i, s in enumerate(steps) if s["status"] == "active"), None),
            "done": sum(s["status"] == "done" for s in steps), "total": len(steps)} if steps else None
    expect = rec.get("expect_commits") if rec.get("id") == acc["job"] else None
    return {"elapsed_s": elapsed,
            "last_event_age_s": max(0, int(now - last)) if running and last else None,
            "stalled": stalled, "turns": acc["turns"], "tool_calls": acc["tool_calls"],
            "tools_top": [{"name": safe_text(n), "count": c} for n, c in
                          sorted(acc["tools"].items(), key=lambda kv: (-kv[1], kv[0]))[:5]],
            "tokens": {**tokens, "total": sum(tokens.values())},
            "cost_usd": cost, "cost_is_estimate": estimate,
            "commits": acc["commits"], "expect_commits": expect if isinstance(expect, int) else None,
            "denials": acc["denials"],
            "plan": plan, "note": acc["note"] or None, "stale": False,
            "branch": job_branch(j.get("branch")), "end_head": _commit(j.get("end_head"))}


def job_progress(prof: Profile, job_id: str, j: dict, states=_FETCH, finalize: bool = False):
    """(progress view, message). Reads the VM only for a running job - or, with `finalize`, once after a
    job has ended (that caches the final values in job.json, so later calls make no sbx call at all).
    Never boots a stopped VM: the sandbox state is asked first. Otherwise the cached values are used
    and the view is marked stale."""
    rec = job_record(prof)
    mine = rec.get("id") == job_id
    ended = j["state"] != "running"
    acc, why = None, ""
    if mine and ended and acc_ok(rec.get("progress"), job_id):
        acc = rec["progress"]
    else:
        vm = "running" if not ended else sandbox_state(prof, states)
        if vm == "running" and (not ended or finalize):
            acc = refresh_progress(prof, job_id, final=ended)
            if acc is not None and ended and mine:
                save_job_record(prof, {**job_record(prof), "progress": {**acc, "seen": []}})
            elif acc is None:
                why = "could not read the job output; showing cached values"
        elif vm != "running":
            why = f"sandbox {vm}: showing cached values"
        else:
            why = "final values not cached yet: run `agentbox progress` while the sandbox is running"
        if acc is None:
            acc = load_acc(prof, job_id)
            if why and not acc["offset"]:
                why += " (none yet)"
    view = progress_view(prof, acc, j, rec, time.time())
    view["stale"] = bool(why)
    return view, why


def cache_final_progress(prof: Profile, job_id: str, j: dict):
    """Called where an ended job is noticed while the sandbox is up (wait, keep-alive)."""
    try:
        job_progress(prof, job_id, j, finalize=True)
    except SystemExit:
        pass


def fmt_dur(s, precise: bool = False) -> str:
    if s is None:
        return "?"
    s = int(s)
    if s < 60:
        return f"{s}s"
    if s < 3600:
        return f"{s // 60}m{s % 60:02d}s" if precise else f"{s // 60}m"
    return f"{s // 3600}h{s % 3600 // 60:02d}m"


def progress_suffix(view: dict | None) -> str:
    """Short tail for a `status` line: "3/7 · 12m · 6s ago" or "STALLED 7m"."""
    if not view:
        return ""
    plan = view["plan"]
    if view["stalled"]:
        return f" STALLED {fmt_dur(view['last_event_age_s'] if view['last_event_age_s'] is not None else view['elapsed_s'])}"
    parts = ([f"{plan['done']}/{plan['total']}"] if plan else []) + [fmt_dur(view["elapsed_s"])]
    if view["last_event_age_s"] is not None:
        parts.append(f"{fmt_dur(view['last_event_age_s'])} ago")
    if view.get("denials"):
        parts.append(f"{view['denials']} denied")
    return " " + " · ".join(parts)


def progress_lines(job_id: str, state: str, view: dict, why: str = "") -> list[str]:
    head = f"job {job_id}  {state}  elapsed {fmt_dur(view['elapsed_s'], True)}"
    if view["stalled"]:
        age = view["last_event_age_s"] if view["last_event_age_s"] is not None else view["elapsed_s"]
        head += f"  STALLED: no activity for {fmt_dur(age, True)}"
    elif view["last_event_age_s"] is not None:
        head += f"  last activity {fmt_dur(view['last_event_age_s'], True)} ago"
    lines = [head]
    if view.get("branch"):
        lines.append(f"branch {view['branch']}" + (f" at {view['end_head'][:12]}" if view.get("end_head") else ""))
    plan = view["plan"]
    if plan:
        n = plan["done"] * 20 // plan["total"]
        now = f"  now: step {plan['current']}: {plan['steps'][plan['current'] - 1]['text']}" if plan["current"] else ""
        lines.append(f"plan [{'#' * n}{'-' * (20 - n)}] {plan['done']}/{plan['total']}{now}  (agent's plan, not verified)")
    if view["note"]:
        lines.append(f"note: {view['note']}  (agent's note)")
    if view.get("denials"):
        lines.append(f"DENIED {view['denials']}: Claude Code's permission check refused {view['denials']} action(s);"
                     " see `agentbox logs` (lines starting `denied:`)")
    tools = ", ".join(f"{t['name']} {t['count']}" for t in view["tools_top"])
    cost = ""
    if view["cost_usd"] is not None:
        cost = f"  cost {'~' if view['cost_is_estimate'] else ''}${view['cost_usd']:.2f}" \
               + (" (estimate)" if view["cost_is_estimate"] else "")
    commits = "" if view["commits"] is None else \
        f"commits {view['commits']}" + (f"/{view['expect_commits']}" if view["expect_commits"] else "") + "  "
    lines.append(f"{commits}turns {view['turns']}  tool calls {view['tool_calls']}"
                 + (f" ({tools})" if tools else "") + cost)
    t = view["tokens"]
    if t["total"]:
        lines.append(f"tokens in {t['input']}  out {t['output']}  cache read {t['cache_read']}  cache write {t['cache_creation']}")
    if why:
        lines.append(f"({why})")
    return [safe_text(ln) for ln in lines]


# --------------------------------------------------------------------- rex
# Rex (a terminal multiplexer) shows a per-terminal status record that a program reports with OSC 7501:
# ESC ] 7501 ; key=value:key=value ESC \. Rex shows the records in the tab, in View Activity and in
# its own notifications. A report carries ONLY state agentbox derives on the host - job state, the
# stalled flag, exit code, profile name, plan counts, and agentbox's own wording. Never VM text: no agent
# output, plan step text, notes, commit messages or sbx stderr.
OSC_KEY_RE = re.compile(r"^[a-z][a-z0-9_]*$")
OSC_VALUE_RE = re.compile(r"^[A-Za-z0-9_.,+/=-]+$")
OSC_ID_RE = re.compile(r"^[A-Za-z0-9_.+-]{1,32}(/[A-Za-z0-9_.+-]{1,32})*$")
OSC_TEXT_KEYS = ("msg", "title")       # sent as base64 of single-line UTF-8
OSC_BAD_TEXT = re.compile("[\x00-\x1f\x7f-\x9f\u2028\u2029\u202a-\u202e\u2066-\u2069]")


def osc7501(fields: dict) -> str:
    """One OSC 7501 report. Raises ValueError for anything outside the grammar."""
    pairs = []
    for k, v in fields.items():
        if not OSC_KEY_RE.match(k):
            raise ValueError(f"bad key {k!r}")
        v = str(v)
        if k in OSC_TEXT_KEYS:
            if OSC_BAD_TEXT.search(v):
                raise ValueError(f"control character in {k}")
            v = base64.b64encode(v.encode()).decode()
        elif k == "id" and not OSC_ID_RE.match(v):
            raise ValueError(f"bad id {v!r}")
        if not OSC_VALUE_RE.match(v):
            raise ValueError(f"bad value for {k}")
        pairs.append(f"{k}={v}")
    return "\x1b]7501;" + ":".join(pairs) + "\x1b\\"


def rex_wanted(as_json: bool = False) -> bool:
    return (sys.stdout.isatty() and bool(os.environ.get("REX_SESSION")) and not as_json
            and "AGENTBOX_NO_OSC" not in os.environ)


def rex_fields(j: dict, view: dict | None = None) -> dict:
    """The report for a job (`job_info` shape) and its progress view: see README, "Using agentbox from Rex".
    Only numbers and agentbox's own words go in; `view`'s text (plan steps, note, tools) is never read."""
    state = j.get("state")
    if state == "running":
        if view and view.get("stalled"):
            age = view.get("last_event_age_s")
            age = age if isinstance(age, int) else view.get("elapsed_s")
            mins = max(1, age // 60) if isinstance(age, int) else None
            return {"state": "blocked", "kind": "other",
                    "msg": f"no event for {mins} min" if mins else "no recent event"}
        plan = view.get("plan") if view else None
        if plan and isinstance(plan.get("done"), int) and isinstance(plan.get("total"), int) and plan["total"] > 0:
            return {"state": "working", "progress": max(0, min(100, plan["done"] * 100 // plan["total"]))}
        return {"state": "working"}
    if state == "finished":
        code = j.get("exit_code")
        if code == 0:
            return {"state": "done"}
        return {"state": "error", "msg": f"exit {code}" if isinstance(code, int) else "exit ?"}
    if state == "lost":
        return {"state": "error", "msg": "job lost"}
    return {"state": "idle"}


class RexStatus:
    """Writes OSC 7501 reports to stdout when `rex_wanted`, each record only when it changes.
    Records are keyed by id (agentbox always passes the profile name); None is the terminal's root record."""

    def __init__(self, on: bool):
        self.on, self.last = on, {}

    def report(self, fields: dict, rid: str | None = None):
        if not self.on or self.last.get(rid) == fields:
            return
        rec = {"state": fields["state"]}
        if "kind" in fields:
            rec["kind"] = fields["kind"]
        rec["app"] = "agentbox"
        if rid is not None:
            rec["id"] = rid
        rec |= {k: v for k, v in fields.items() if k not in ("state", "kind")}
        try:
            text = osc7501(rec)
        except ValueError:
            return                    # e.g. a 33-41 char profile name: longer than an id segment
        self.last[rid] = fields
        sys.stdout.write(text)
        sys.stdout.flush()

    def clear(self, rid: str):
        if not self.on or rid not in self.last:
            return
        del self.last[rid]
        try:
            sys.stdout.write(osc7501({"state": "clear", "id": rid}))
            sys.stdout.flush()
        except ValueError:
            pass

    def ids(self) -> list:
        return [r for r in self.last if r is not None]


def cmd_progress(prof: Profile, args) -> int:
    job_id = resolve_job(prof, args.job)
    if args.json and args.watch:
        die("--json cannot be combined with --watch", EXIT_USAGE)
    if args.interval < 1:
        die("--interval must be at least 1 second", EXIT_USAGE)
    tty, doubts = sys.stdout.isatty(), 0
    rex = RexStatus(args.watch and rex_wanted(args.json))
    try:
        while True:
            j = job_info(prof, job_id)
            view, why = job_progress(prof, job_id, j, finalize=True)
            if args.json:
                emit_json(view)
                return EXIT_OK
            lines = progress_lines(job_id, j["state"], view, why)
            if not args.watch:
                print("\n".join(lines))
                return EXIT_OK
            if tty:     # our own escape codes: home, clear screen. Nothing from the VM is ever printed raw.
                print("\x1b[H\x1b[2J" + "\n".join(lines), flush=True)
            else:
                print(lines[0] + (f"  {lines[1]}" if view["plan"] else ""), flush=True)
            if j["state"] == "lost" and j.get("probe_failed"):
                doubts += 1                     # one flaky probe isn't "lost"
            if j["state"] == "lost" and j.get("probe_failed") and doubts < 3:
                time.sleep(args.interval)       # the Rex record keeps its last state until this is certain
                continue
            rex.report(rex_fields(j, view), prof.name)
            if j["state"] == "running":
                time.sleep(args.interval)
                continue
            return job_exit_status(j)
    except KeyboardInterrupt:
        rex.report({"state": "idle"}, prof.name)
        raise


# ----------------------------------------------------------------- history
# The host keeps only a profile's latest job in job.json, and the agent's final summary lives only in the VM,
# which sbx stops ~30 s after a job ends. So when agentbox first sees a job ended (job_info, while the VM can
# still be read), it appends one record per job to $state_dir/<sandbox>/history.jsonl: the measured numbers,
# the brief's title and the agent's own summary. Both texts are agent-writable: safe_text'd and capped here,
# and dash_clean'ed again wherever they are drawn.
HISTORY_FILE, HISTORY_MAX = "history.jsonl", 200      # jobs kept per profile
SUMMARY_MAX, TITLE_MAX = 8192, 200                    # characters
HISTORY_PROMPT_READ, HISTORY_RESULT_READ = 16384, 1 << 20   # bytes read from prompt.md / the result line
HISTORY_KEYS = ("id", "state", "started_at", "finished_at", "exit_code", "branch", "end_head", "turns",
                "tool_calls", "denials", "tokens", "cost_usd", "commits", "title", "summary")


def history_script(job_id: str) -> str:
    """sh run in the VM: line 1 "R", line 2 the stream's last `result` event (newlines removed), line 3 "P",
    then the head of prompt.md. The prompt is last, so nothing in it can shift the lines before it."""
    d = JOB_DIR.format(id=check_job_id(job_id))
    return (f'd={d}; [ -d "$d" ] || {{ echo MISSING; exit 0; }}; echo R; '
            f'grep \'"type":"result"\' "$d/output.jsonl" 2>/dev/null | tail -n 1 | head -c {HISTORY_RESULT_READ} '
            f'| tr -d \'\\r\\n\'; echo; echo P; head -c {HISTORY_PROMPT_READ} "$d/prompt.md" 2>/dev/null; true')


def parse_history_out(out: str) -> dict:
    """history_script's output -> {"summary", "title"} (each None when absent or unreadable)."""
    res = {"summary": None, "title": None}
    parts = out.split("\n", 3)
    if len(parts) < 3 or parts[0] != "R" or parts[2] != "P":
        return res
    try:
        ev = json.loads(parts[1]) if parts[1].startswith("{") else None
    except (ValueError, RecursionError):
        ev = None
    if isinstance(ev, dict) and isinstance(ev.get("result"), str) and ev["result"].strip():
        res["summary"] = safe_text(ev["result"].strip()[:SUMMARY_MAX])
    res["title"] = brief_title(parts[3] if len(parts) > 3 else "")
    return res


def brief_title(prompt: str) -> str | None:
    """The first Markdown heading of a brief, else its first non-empty line; the progress paragraph agentbox
    puts in front of the brief is skipped. safe_text'd, at most TITLE_MAX characters."""
    if not isinstance(prompt, str):
        return None
    prompt = prompt.removeprefix(PROGRESS_PROMPT)
    lines = [ln.strip() for ln in prompt.splitlines()]
    heading = next((m.group(1) for ln in lines if (m := re.match(r"#{1,6}\s+(.*\S)", ln))), None)
    title = heading or next((ln for ln in lines if ln), None)
    return safe_text(title.strip("# ")[:TITLE_MAX]) if title else None


def _hist_text(v, cap: int) -> str | None:
    return safe_text(v[:cap]) if isinstance(v, str) and v else None


def history_record(rec: dict, details: dict | None = None) -> dict:
    """One history line from a job.json record (an ended job, its cached progress) and what was read from
    the VM. Every value is checked again: job.json is host-written, but the values came from the VM."""
    details = details or {}
    acc = rec.get("progress") if acc_ok(rec.get("progress"), rec.get("id")) else None
    cost = (acc.get("result") or {}).get("cost") if acc else None
    tokens = None
    if acc:
        tokens = {k: sum(_count(row.get(k)) for row in acc["tokens"].values() if isinstance(row, dict))
                  for k in TOKEN_KEYS}
        tokens["total"] = sum(tokens.values())
    code = rec.get("exit_code")
    return {"id": rec["id"], "state": rec.get("state") if rec.get("state") in ("finished", "lost") else "lost",
            "started_at": _timestamp(rec.get("started_at")), "finished_at": _timestamp(rec.get("finished_at")),
            "exit_code": code if isinstance(code, int) and not isinstance(code, bool) else None,
            "branch": job_branch(rec.get("branch")), "end_head": _commit(rec.get("end_head")),
            "turns": _count(acc["turns"]) if acc else None, "tool_calls": _count(acc["tool_calls"]) if acc else None,
            "denials": _count(acc.get("denials")) if acc else None, "tokens": tokens,
            "cost_usd": float(cost) if isinstance(cost, (int, float)) and not isinstance(cost, bool) else None,
            "commits": _int_or_none(acc.get("commits")) if acc else None,
            "title": _hist_text(details.get("title") or rec.get("title"), TITLE_MAX),
            "summary": _hist_text(details.get("summary"), SUMMARY_MAX)}


def read_history(prof: Profile) -> list[dict]:
    """The profile's history records, oldest first; one per job id (the first one written wins)."""
    try:
        text = (prof.state / HISTORY_FILE).read_text(errors="replace")
    except OSError:
        return []
    out, seen = [], set()
    for line in text.splitlines():
        try:
            rec = json.loads(line)
        except (ValueError, RecursionError):
            continue
        if isinstance(rec, dict) and isinstance(rec.get("id"), str) and JOB_ID_RE.match(rec["id"]) \
                and rec["id"] not in seen:
            seen.add(rec["id"])
            out.append({k: rec.get(k) for k in HISTORY_KEYS})
    return out


def append_history(prof: Profile, entry: dict) -> bool:
    """Add one job's record unless its id is already there; keep the last HISTORY_MAX. The file is
    rewritten whole (owner-only) and swapped in, so a reader never sees half a line. True if written."""
    old = read_history(prof)
    if any(r["id"] == entry["id"] for r in old):
        return False
    prof.state.mkdir(parents=True, exist_ok=True)
    keep = (old + [entry])[-HISTORY_MAX:]
    tmp = prof.state / f".{HISTORY_FILE}.{os.getpid()}.{threading.get_ident()}.tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write("".join(json.dumps(r, separators=(",", ":")) + "\n" for r in keep))
    owner_only(tmp)
    os.replace(tmp, prof.state / HISTORY_FILE)
    return True


def record_history(prof: Profile, details: dict | None = None) -> bool:
    """The recorded job, if it has ended and is not in the history yet. Never raises: history is a record
    of what happened, and failing to write it must not fail the command that noticed the job end."""
    try:
        rec = job_record(prof)
        if not (isinstance(rec.get("id"), str) and JOB_ID_RE.match(rec["id"])) or rec.get("state") not in ("finished", "lost"):
            return False
        if any(r["id"] == rec["id"] for r in read_history(prof)):
            return False
        return append_history(prof, history_record(rec, details))
    except (Exception, SystemExit):
        return False


def note_job_ended(prof: Profile, job_id: str, j: dict):
    """job_info found the recorded job ended, for the first time. While the VM is up, cache the job's final
    progress and read its summary and title (two execs, once per job); then write its history record."""
    details = None
    if j.get("vm") == "running":
        with contextlib.suppress(Exception, SystemExit):
            cache_final_progress(prof, job_id, j)
        with contextlib.suppress(Exception, SystemExit):
            r = vm_exec(prof, history_script(job_id))
            details = parse_history_out(r.stdout or "") if r.returncode == 0 else None
    record_history(prof, details)


def history_rows(cfg: Config, name: str | None) -> list[dict]:
    """History records of one profile (or every profile), newest first, each with its profile's name."""
    rows = []
    for n in [name] if name else cfg.profile_names():
        try:
            prof = cfg.profile(n)
        except SystemExit:
            continue
        record_history(prof)                # a job that ended before history existed, or never seen ending
        rows += [{"profile": n} | r for r in read_history(prof)]
    return sorted(rows, key=lambda r: (r.get("finished_at") or r.get("started_at") or "", r["id"]), reverse=True)


def cmd_history(cfg: Config, name: str | None, as_json: bool = False) -> int:
    if name:
        cfg.profile(name)                   # dies for an unknown profile
    rows = history_rows(cfg, name)
    if as_json:
        emit_json({"jobs": rows})
        return EXIT_OK
    if not rows:
        print("no jobs recorded yet")
        return EXIT_OK
    for r in rows:
        code = r.get("exit_code")
        state = f"exit {code}" if r.get("state") == "finished" and code is not None else r.get("state") or "?"
        cost = f"${r['cost_usd']:.2f}" if isinstance(r.get("cost_usd"), (int, float)) else "-"
        print(f"{r['id']}  {r['profile']:<16} {state:<8} {r.get('finished_at') or '-':<20} {cost:>7}  "
              f"{safe_text(r.get('branch') or '-'):<24} {dash_clean(r.get('title') or '')[:80]}")
    return EXIT_OK


# ------------------------------------------------------------------- fetch
# Clone mode keeps the agent's work in the VM. While the sandbox runs, sbx adds the git remote
# `sandbox-<sandbox>` to the host repo, and it removes it when the sandbox stops (which it does ~30 s
# after the last exec session ends). `fetch` holds a session open, waits for the remote, fetches into a
# review branch and reports. It never merges. The remote name is built here, never read from the VM.
FETCH_WAIT, FETCH_POLL, FETCH_HOLD = 60.0, 1.5, 300      # seconds: wait for the remote, poll gap, keep-awake session
REF_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._/-]*$")     # no leading '-', no spaces, no '@{', ':', '~', '^', '*', '\\'
JOB_BRANCH_MAX = 100        # longest branch name taken from a job's (agent-written) branch file
LOG_CAP, STAT_CAP = 50, 30


def host_git(prof: Profile, *args, check: bool = True, timeout: float = 120):
    """Run git on the host in the primary workspace. Only used in clone mode, where the agent cannot
    have touched the host's .git; commit contents never choose a program (no external diff or textconv)."""
    cmd = ["git", "-C", str(prof.primary), *args]
    env = {**sbx_env(prof.cfg), "LC_ALL": "C", "GIT_TERMINAL_PROMPT": "0"}
    try:
        r = subprocess.run(cmd, env=env, stdin=subprocess.DEVNULL, capture_output=True, text=True,
                           errors="replace", timeout=timeout)
    except FileNotFoundError:
        die("git not found on the host")
    except subprocess.TimeoutExpired:
        die(f"`git {args[0]}` timed out after {timeout:g}s")
    if check and r.returncode != 0:
        die(f"`git {args[0]}` failed (exit {r.returncode})\n{(r.stderr or r.stdout or '').strip()}")
    return r


def ref_name_ok(value) -> bool:
    """The rules check_fetch_ref applies before it asks git (which also checks the result)."""
    return isinstance(value, str) and REF_RE.fullmatch(value) is not None and ".." not in value \
        and "//" not in value and not value.endswith(("/", ".", ".lock")) and "/." not in value \
        and ".lock/" not in value and len(value) <= 200


def job_branch(value) -> str | None:
    """The branch a job's workspace ended on, or None. The job dir is agent-writable, so only a plain
    branch name gets through: at most JOB_BRANCH_MAX characters of [A-Za-z0-9._/-], no leading '-' or '.',
    no '..', '//', trailing '/' or '.lock', not HEAD or refs/..., and check_fetch_ref's rules."""
    if not isinstance(value, str) or not 0 < len(value) <= JOB_BRANCH_MAX or not ref_name_ok(value):
        return None
    return None if value == "HEAD" or value.startswith("refs/") else value


def fetch_defaults(name: str, job: dict | None, ref: str | None = None, branch: str | None = None) -> dict:
    """What `fetch <name>` fetches, and into which branch: {"ref", "branch", "source", "why"}. Explicit
    --ref / --branch win; otherwise the ref is the branch the latest job ended on, else main. A ref from a
    job goes to review/<name>-<ref, '/' -> '-'> (review/<name>/<x> would clash with review/<name> in git),
    anything else to review/<name>. Shared by `fetch` and the dashboard's confirmation."""
    job = job or {}
    jb = job_branch(job.get("branch"))
    jid = job.get("id") if isinstance(job.get("id"), str) and JOB_ID_RE.match(job.get("id")) else None
    if ref is not None:
        source, why = "flag", "given with --ref"
    elif jb:
        ref, source, why = jb, "job", f"the branch job {jid or '?'} ended on"
    else:
        ref, source = "main", "default"
        if not jid:
            why = "the default: no job recorded"
        elif job.get("state") == "running":
            why = f"the default: job {jid} is still running, and its branch is recorded when it ends"
        else:
            why = f"the default: no branch recorded for job {jid} (detached HEAD, or an older job)"
    if branch is None:
        branch = f"review/{name}-{ref.replace('/', '-')}" if source == "job" and ref != "main" else f"review/{name}"
    return {"ref": ref, "branch": branch, "source": source, "why": why}


def check_fetch_ref(what: str, value: str) -> str:
    if not ref_name_ok(value):
        die(f"{what} {value!r} is not an acceptable branch name", EXIT_USAGE)
    r = subprocess.run(["git", "check-ref-format", "--branch", value], capture_output=True, text=True,
                       stdin=subprocess.DEVNULL)
    if r.returncode != 0:
        die(f"{what} {value!r} is not a valid git branch name", EXIT_USAGE)
    return value


@contextlib.contextmanager
def keep_awake(prof: Profile, seconds: int = FETCH_HOLD):
    """One `sbx exec <sandbox> sleep N` child, so sbx does not stop the sandbox mid-fetch (and boots
    it if it is stopped). Always ended, on success, error and Ctrl-C."""
    p = subprocess.Popen([prof.cfg.settings["sbx"], "exec", prof.sandbox, "sleep", str(seconds)],
                         env=sbx_env(prof.cfg), stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    try:
        yield p
    finally:
        if p.poll() is None:
            p.terminate()
            try:
                p.wait(timeout=5)
            except subprocess.TimeoutExpired:
                p.kill()
                p.wait()


def wait_for_remote(prof: Profile, remote: str, child) -> None:
    deadline = time.monotonic() + FETCH_WAIT
    while True:
        if remote in host_git(prof, "remote").stdout.split():
            return
        rc = child.poll()
        if rc is not None:
            die(f"the keep-awake session in {prof.sandbox} ended (exit {rc}) before remote {remote} appeared;"
                f" is the sandbox healthy? (`agentbox doctor {prof.name}`)")
        if time.monotonic() >= deadline:
            die(f"remote {remote} did not appear within {FETCH_WAIT:g}s; the sandbox may still be starting."
                f" Try again, or check `sbx ls` and `git -C {prof.primary} remote`")
        time.sleep(FETCH_POLL)


def fetch_missing_hint(prof: Profile) -> str:
    r = host_git(prof, "for-each-ref", "--format=%(refname)", f"refs/sandboxes/{prof.sandbox}/", check=False)
    refs = r.stdout.split() if r.returncode == 0 else []
    if not refs:
        return ""
    return ("\nCommits fetched before the sandbox was removed are kept in refs/sandboxes/; keep one with"
            "\n  " + "\n  ".join(f"git branch LOCAL {ref}" for ref in refs[:5]) + ("\n  ..." if len(refs) > 5 else ""))


def checked_out_branches(prof: Profile) -> set[str]:
    out = host_git(prof, "worktree", "list", "--porcelain").stdout
    return {ln.split(" ", 1)[1] for ln in out.splitlines() if ln.startswith("branch ")}


def parse_stat_summary(line: str) -> tuple[int, int, int]:
    pick = lambda pat: int(m.group(1)) if (m := re.search(pat, line)) else 0
    return pick(r"(\d+) files? changed"), pick(r"(\d+) insertions?\(\+\)"), pick(r"(\d+) deletions?\(-\)")


def fetch_job_note(prof: Profile) -> tuple[bool, str]:
    """(is a job running, progress suffix). Best effort: a failed look is not a failed fetch."""
    try:
        j = job_info(prof)
        if j["state"] != "running":
            return False, ""
        try:
            return True, progress_suffix(job_progress(prof, j["id"], j)[0])
        except SystemExit:
            return True, ""
    except SystemExit:
        return False, ""


def fetch_branch_free(prof: Profile, branch: str):
    if f"refs/heads/{branch}" in checked_out_branches(prof):
        die(f"branch {branch} is checked out in {prof.primary}; pick another with --branch", EXIT_USAGE)


def fetch_target(prof: Profile, args) -> dict:
    """fetch_defaults for the profile's latest job, checked, announced, plus the review branch's ref and
    current tip. Reading the job is best effort: no job is better than a failed fetch."""
    try:
        job = job_info(prof)
    except SystemExit:
        job = None
    t = fetch_defaults(prof.name, job, args.ref, args.branch)
    check_fetch_ref("--ref", t["ref"])
    check_fetch_ref("--branch", t["branch"])
    info(f"fetching {t['ref']} ({t['why']}) into {t['branch']}")
    full = f"refs/heads/{t['branch']}"
    fetch_branch_free(prof, t["branch"])
    tip = host_git(prof, "rev-parse", "--verify", "-q", f"{full}^{{commit}}", check=False)
    return t | {"full": full, "previous": tip.stdout.strip() if tip.returncode == 0 else None}


def cmd_fetch(prof: Profile, args) -> int:
    if prof.d["mode"] != "clone":
        die(f"profile '{prof.name}' is in direct mode: the agent edits {prof.primary} itself, so there is"
            f" nothing to fetch. Review what it changed with `agentbox audit {prof.name}`", EXIT_USAGE)
    for what, v in (("--ref", args.ref), ("--branch", args.branch)):
        if v is not None:
            check_fetch_ref(what, v)
    remote = f"sandbox-{prof.sandbox}"
    vm = sandbox_state(prof)
    if vm == "unknown":
        die(f"cannot tell whether {prof.sandbox} is running (`sbx ls --json` failed)")
    if vm == "missing":
        die(f"sandbox {prof.sandbox} does not exist, so there is no {remote} remote to fetch from"
            + fetch_missing_hint(prof))
    if vm == "stopped" and not args.start:
        die(f"sandbox {prof.sandbox} is stopped, and sbx removes {remote} when a sandbox stops. --start boots it;"
            f" booting relaunches the agent that was last started with `sbx run`")
    if host_git(prof, "rev-parse", "--git-dir", check=False).returncode != 0:
        die(f"{prof.primary} is not a git repository")
    if args.branch is not None:
        fetch_branch_free(prof, args.branch)
    # The job is looked at while the sandbox runs: a job found ended while it is stopped reads as lost.
    target = fetch_target(prof, args) if vm == "running" else None

    try:
        with keep_awake(prof) as child:
            wait_for_remote(prof, remote, child)
            target = target or fetch_target(prof, args)
            ref, branch, full, previous = target["ref"], target["branch"], target["full"], target["previous"]
            if previous and not args.force:
                host_git(prof, "fetch", "--no-tags", "--", remote, ref, timeout=300)
                fetched = host_git(prof, "rev-parse", "--verify", "FETCH_HEAD^{commit}").stdout.strip()
                if host_git(prof, "merge-base", "--is-ancestor", previous, fetched, check=False).returncode != 0:
                    die(f"{branch} ({previous[:12]}) is not an ancestor of {remote}/{ref} ({fetched[:12]}),"
                        f" so this would not be a fast-forward. Pass --force to overwrite {branch}, or use --branch")
            host_git(prof, "fetch", "--no-tags", "--", remote, f"{'+' if args.force else ''}{ref}:{full}", timeout=300)
            running, suffix = fetch_job_note(prof)
    except KeyboardInterrupt:
        die("interrupted", 130)

    commit = host_git(prof, "rev-parse", "--verify", f"{full}^{{commit}}").stdout.strip()
    head_r = host_git(prof, "rev-parse", "--verify", "-q", "HEAD^{commit}", check=False)
    head = head_r.stdout.strip() if head_r.returncode == 0 else None
    rng = f"{head}..{commit}" if head else commit
    total = int(host_git(prof, "rev-list", "--count", rng, "--").stdout.strip() or 0)
    commits = []
    for ln in host_git(prof, "log", "--no-color", "--no-show-signature", f"--max-count={LOG_CAP}",
                       "--format=%H %s", rng, "--").stdout.splitlines():
        h, _, subject = ln.partition(" ")
        commits.append({"hash": h, "subject": subject})
    stat = ""
    if head:
        stat = host_git(prof, "diff", "--stat=120", "--no-color", "--no-ext-diff", "--no-textconv",
                        f"{head}...{commit}", "--").stdout.rstrip("\n")
    stat_lines = stat.splitlines()
    files, ins, dels = parse_stat_summary(stat_lines[-1]) if stat_lines else (0, 0, 0)
    ff = bool(head) and host_git(prof, "merge-base", "--is-ancestor", head, commit, check=False).returncode == 0

    if running:
        info(f"a job is still running in {prof.sandbox}{suffix}: this is not necessarily its final state"
             f" (`agentbox progress {prof.name}`)")
    if args.json:
        emit_json({"profile": prof.name, "sandbox": prof.sandbox, "remote": remote, "ref": ref, "branch": branch,
                   "ref_source": target["source"],
                   "commit": commit, "previous": previous, "fast_forward_from_head": ff, "commits": commits,
                   "commits_total": total, "files_changed": files, "insertions": ins, "deletions": dels,
                   "job_running": running})
        return EXIT_OK
    print(f"fetched {remote} {ref} ({commit[:12]}) into {branch}"
          + (f" (was {previous[:12]})" if previous else " (new branch)"))
    print(f"\n{total} commit(s) {'not in HEAD' if head else 'on the branch'}:")
    for c in commits:
        print(f"  {c['hash'][:9]} {safe_text(c['subject'])}")
    if total > len(commits):
        print(f"  ... {total - len(commits)} more")
    if stat_lines:
        body, summary = stat_lines[:-1], stat_lines[-1]
        print()
        for ln in body[:STAT_CAP]:
            print(safe_text(ln))
        if len(body) > STAT_CAP:
            print(f" ... {len(body) - STAT_CAP} more files")
        print(safe_text(summary))
    print(f"\nnext:\n  git diff HEAD...{branch}")
    print(f"  git merge --ff-only {branch}" if ff else
          f"  (a fast-forward is not possible: HEAD is not an ancestor of {branch}; rebase it or merge by hand)")
    return EXIT_OK


def emit_json(obj):
    """The one JSON document a --json command prints on stdout. Never put secret values in obj."""
    print(json.dumps(obj, indent=2, default=str))


def status_progress(prof: Profile, j: dict, states) -> dict | None:
    """job.progress for `status`: at most ONE extra exec, and only for a running job (an ended job
    is answered from the cache, a stopped sandbox is never started)."""
    if not j["id"]:
        return None
    try:
        return job_progress(prof, j["id"], j, states)[0]
    except SystemExit:
        return None


def profile_status(prof: Profile, states=_FETCH) -> dict:
    """`states`: a sandbox_states() listing shared by every profile of one status run."""
    if states is _FETCH:
        states = sandbox_states(prof.cfg)
    if not prof.enabled:
        return {"name": prof.name, "valid": True, "enabled": False, "sandbox": prof.sandbox,
                "agent": prof.d["agent"], "mode": prof.d["mode"], "job": dict(NO_JOB) | {"progress": None}}
    pid = bridge_pid(prof) if prof.state.exists() else None
    info_ = job_info(prof, states=states)
    job = public_job(info_) | {"progress": status_progress(prof, info_, states)}
    if job["id"]:
        job["vm"] = sandbox_state(prof, states)      # now, not as of the last probe (job_info caches)
    out = {"name": prof.name, "valid": True, "enabled": True, "sandbox": prof.sandbox,
           "job": job,
           "agent": prof.d["agent"], "mode": prof.d["mode"],
           "sandbox_exists": sandbox_exists(prof) if states is None else prof.sandbox in states,
           "host_tools": prof.tool_names,
           "host_tools_port": int(prof.d.get("host_tools_port") or 0) or None,
           "local_model": prof.local_model,
           "bridge": {"running": pid is not None, "pid": pid},
           "skills": skills_status(prof)}
    if sandbox_state(prof, states) == "running":     # interactive sessions: never from a stopped VM
        r = vm_exec(prof, vm_script(VM_SESSIONS_SCRIPT, prof))
        out |= parse_vm_sessions(r.stdout or "") if r.returncode == 0 else NO_SESSIONS
    return out


def skills_status(prof: Profile) -> list[dict]:
    rows = []
    for ss in prof.skillsets:
        row = {"set": ss.name, "path": str(ss.path) if ss.path else None, "ref": ss.ref, "commit": ss.commit,
               "branch": ss.branch, "skills": list(ss.skills), "drift": skill_drift(prof, ss)[0]}
        if ss.problems:
            row["problems"] = list(ss.problems)
        rows.append(row)
    return rows


def cmd_status(cfg: Config, as_json: bool = False) -> int:
    states = sandbox_states(cfg)
    if as_json:
        rows = []
        for n in cfg.profile_names():
            try:
                rows.append(profile_status(cfg.profile(n), states))
            except SystemExit:               # message already on stderr
                rows.append({"name": n, "valid": False})
        emit_json({"profiles": rows})
        return EXIT_OK
    sbx(cfg, "ls", check=False)
    print()
    for n in cfg.profile_names():
        try:
            prof = cfg.profile(n)
        except SystemExit:
            continue
        if not prof.enabled:
            print(f"{n:20s} skipped (disabled)")
            continue
        pid = bridge_pid(prof) if prof.state.exists() else None
        tools = f"bridge pid {pid} on :{prof.port}" if pid else ("bridge stopped" if prof.tool_names else "no host tools")
        job = job_info(prof, states=states)
        jobs = f" job={safe_text(job['id'])} {job['state']}" if job["state"] != "none" else ""
        if jobs:
            jobs += progress_suffix(status_progress(prof, job, states))
        print(f"{n:20s} sandbox={prof.sandbox:24s} agent={prof.d['agent']:10s} {tools}{jobs}")
    return EXIT_OK


# ---------------------------------------------------------------- dashboard
# One screen for every running sandbox: VM uptime, CPU, memory, disk, and the job's activity and
# tokens. A running sandbox costs one `sbx exec` (the resource probe below) plus whatever `status`
# already needs for its job; stopped sandboxes are listed, never booted. Everything the VM prints is
# parsed as numbers here and drawn by us, so nothing from the VM reaches the terminal as text.
#
# The same exec also reports interactive agent sessions (VM_SESSIONS_SCRIPT): each claude/opencode
# process (by argv[0]'s base name) with its age and whether it is the current job ($AB_JOB's pid or a
# descendant), how long ago the newest Claude transcript and opencode session store were written, and
# the transcript's last permissionMode. Only process metadata, file times and that one word are read,
# never conversation content; the lines carry only numbers and fixed words.
VM_SESSIONS_SCRIPT = r"""
now=$(date +%s); up=$(cut -d' ' -f1 /proc/uptime); hz=$(getconf CLK_TCK 2>/dev/null) || hz=100
jp=; case "$AB_JOB" in ?*) jp=$(head -c 16 "$HOME/.agentbox/jobs/$AB_JOB/pid" 2>/dev/null | tr -cd 0-9);; esac
ag=
for f in /proc/[0-9]*/cmdline; do
  a=$(head -c 512 "$f" 2>/dev/null | tr '\0\n' '\n ' | head -n1); a=${a##*/}
  case "$a" in claude|opencode) p=${f#/proc/}; ag="$ag ${p%/cmdline}:$a";; esac
done
[ -n "$ag" ] && cat /proc/[0-9]*/stat 2>/dev/null | awk -v ag="$ag" -v jp="$jp" -v up="$up" -v hz="$hz" '
  { pid = $1; sub(/^.*\) /, ""); pp[pid] = $2; st[pid] = $20 }
  END { n = split(ag, a, " "); for (i = 1; i <= n && i <= 64; i++) {
      split(a[i], x, ":"); p = x[1]; if (!(p in st)) continue
      j = 0; q = p; for (k = 0; k < 64 && q != "" && q > 1; k++) { if (q == jp) { j = 1; break }; q = pp[q] }
      e = int(up - st[p] / hz); if (e < 0) e = 0
      print "agent", x[2], p, e, j } }'
f=$(ls -t -- "$HOME"/.claude/projects/*/*.jsonl 2>/dev/null | head -n1)
if [ -n "$f" ] && t=$(stat -c %Y -- "$f" 2>/dev/null); then
  m=$(tail -c 65536 -- "$f" 2>/dev/null | grep -o '"permissionMode":"[a-zA-Z]*"' | tail -n1 | cut -d'"' -f4)
  echo "claude_activity $((now > t ? now - t : 0)) ${m:--}"
fi
o=$(ls -td -- "$HOME"/.local/share/opencode/opencode.db* "$HOME"/.local/share/opencode/storage/session/*/* \
  "$HOME"/.local/share/opencode/storage/message/* 2>/dev/null | head -n1)
if [ -n "$o" ] && t=$(stat -c %Y -- "$o" 2>/dev/null); then echo "opencode_activity $((now > t ? now - t : 0))"; fi
"""
VM_STATS_SCRIPT = r"""
echo "stat1 $(head -n1 /proc/stat)"; sleep 0.5; echo "stat2 $(head -n1 /proc/stat)"
echo "uptime $(cut -d' ' -f1 /proc/uptime)"
echo "load $(cut -d' ' -f1-3 /proc/loadavg)"
echo "cpus $(nproc 2>/dev/null || grep -c '^processor' /proc/cpuinfo)"
grep -E '^(MemTotal|MemAvailable):' /proc/meminfo | tr -s ' ' | sed 's/^/mem /'
echo "disk $(df -Pk / | tail -n1)"
""" + VM_SESSIONS_SCRIPT
SESSION_AGENTS = ("claude", "opencode")
SESSION_MODES = ("auto", "acceptEdits", "bypassPermissions", "plan", "default", "dontAsk", "manual")
SESSIONS_MAX, SESSION_SECS_MAX, SESSION_PID_MAX = 32, 10**9, 1 << 22


def vm_script(script: str, prof: "Profile") -> str:
    """`script` with AB_JOB set to the profile's job, if that job may still be running (a finished job's
    pid file could name a reused pid)."""
    rec = job_record(prof)
    jid = rec.get("id")
    if isinstance(jid, str) and JOB_ID_RE.match(jid) and rec.get("state") not in ("finished", "lost"):
        return f"AB_JOB={jid}\n{script}"
    return f"AB_JOB=\n{script}"


def _secs(v: str, top: int = SESSION_SECS_MAX) -> int | None:
    """A plain ASCII decimal in [0, top], else None (no sign, no '_', no other digits)."""
    return int(v) if re.fullmatch(r"[0-9]{1,10}", v) and int(v) <= top else None


def parse_vm_sessions(out: str) -> dict:
    """The session lines of VM_SESSIONS_SCRIPT: {"sessions": [{"agent", "age_s"}] (interactive processes
    only, at most SESSIONS_MAX), "activity_age_s": int | None, "permission_mode": str | None}. Any line
    that isn't exactly the expected shape is ignored."""
    sessions, ages, mode, seen = [], [], None, set()
    for line in out.split("\n"):
        f = line.split(" ")
        if f[0] == "agent" and len(f) == 5 and f[1] in SESSION_AGENTS and f[4] in ("0", "1"):
            pid, age = _secs(f[2], SESSION_PID_MAX), _secs(f[3])
            if pid and age is not None and pid not in seen and f[4] == "0" and len(sessions) < SESSIONS_MAX:
                seen.add(pid)
                sessions.append({"agent": f[1], "age_s": age})
        elif f[0] == "claude_activity" and len(f) == 3 and _secs(f[1]) is not None:
            ages.append(_secs(f[1]))
            mode = f[2] if f[2] in SESSION_MODES else None
        elif f[0] == "opencode_activity" and len(f) == 2 and _secs(f[1]) is not None:
            ages.append(_secs(f[1]))
    sessions.sort(key=lambda s: -s["age_s"])
    return {"sessions": sessions, "activity_age_s": min(ages) if ages else None, "permission_mode": mode}


NO_SESSIONS = {"sessions": [], "activity_age_s": None, "permission_mode": None}


def _cpu_times(fields: list[str]) -> tuple[int, int] | None:
    """(busy, total) jiffies from the fields after "cpu" in /proc/stat."""
    try:
        v = [int(x) for x in fields]
    except ValueError:
        return None
    if len(v) < 5:
        return None
    idle = v[3] + v[4]                  # idle + iowait
    return sum(v[:8]) - idle, sum(v[:8])


def parse_vm_stats(out: str) -> dict | None:
    """The numbers from VM_STATS_SCRIPT, or None if the output is not what we expect."""
    rows: dict[str, list[list[str]]] = {}
    for line in out.splitlines():
        if line.split():
            key, *rest = line.split()
            rows.setdefault(key, []).append(rest)
    try:
        t1, t2 = _cpu_times(rows["stat1"][0][1:]), _cpu_times(rows["stat2"][0][1:])
        mem = {r[0].rstrip(":"): int(r[1]) * 1024 for r in rows["mem"]}
        disk = rows["disk"][0]
        total, used = int(disk[1]) * 1024, int(disk[2]) * 1024
        res = {"uptime_s": int(float(rows["uptime"][0][0])), "cpus": int(rows["cpus"][0][0]),
               "load": [float(x) for x in rows["load"][0][:3]],
               "mem_total": mem["MemTotal"], "mem_used": mem["MemTotal"] - mem["MemAvailable"],
               "disk_total": total, "disk_used": used}
    except (KeyError, IndexError, ValueError):
        return None
    if t1 is None or t2 is None or len(res["load"]) != 3:
        return None
    dt = t2[1] - t1[1]
    res["cpu_pct"] = round(100.0 * (t2[0] - t1[0]) / dt, 1) if dt > 0 else None
    return res


def dashboard_entry(cfg: Config, name: str, states) -> dict:
    """One profile's row. Never raises: a broken profile or an unreadable VM is a row with less in it."""
    try:
        prof = cfg.profile(name)
        if not prof.enabled:
            return {"name": name, "enabled": False, "vm": "disabled"}
        vm = sandbox_state(prof, states)
        row = {"name": name, "enabled": True, "sandbox": prof.sandbox, "agent": prof.d["agent"],
               "mode": prof.d["mode"], "vm": vm, "job": None, "resources": None,
               "review": review_summary(cfg, prof, states)} | NO_SESSIONS   # clone mode: what `review` would list
        if vm == "unknown":
            return row
        if vm == "running":
            r = vm_exec(prof, vm_script(VM_STATS_SCRIPT, prof))
            if r.returncode == 0:
                row["resources"] = parse_vm_stats(r.stdout or "")
                row |= parse_vm_sessions(r.stdout or "")
        j = job_info(prof, states=states)       # a stopped VM: host-side state only, as `status` does
        row["job"] = public_job(j) | {"progress": status_progress(prof, j, states)}
        return row
    except SystemExit:
        return {"name": name, "enabled": True, "vm": "unknown", "error": True}


def collect_dashboard(cfg: Config) -> dict:
    from concurrent.futures import ThreadPoolExecutor
    states = sandbox_states(cfg)
    names = cfg.profile_names()
    with ThreadPoolExecutor(max_workers=max(1, min(8, len(names)))) as pool:
        rows = list(pool.map(lambda n: dashboard_entry(cfg, n, states), names))
    for r in rows:              # the interactive dashboard's state, so other front ends (VS Code) needn't re-derive it
        r["state"] = dash_state(r)
    return {"generated_at": int(time.time()), "sandboxes_known": states is not None, "profiles": rows}


def fmt_bytes(n) -> str:
    n = float(n)
    for unit in ("B", "K", "M", "G", "T"):
        if n < 1024 or unit == "T":
            return f"{n:.0f}{unit}" if unit in ("B", "K") or n >= 100 else f"{n:.1f}{unit}"
        n /= 1024
    return "?"


def fmt_count(n) -> str:
    n = int(n)
    for div, unit in ((10**9, "G"), (10**6, "M"), (10**3, "k")):
        if n >= div:
            return f"{n / div:.1f}{unit}"
    return str(n)


class Style:
    """ANSI colour only on a terminal, and not if NO_COLOR is set."""
    CODES = {"dim": "2", "bold": "1", "red": "31", "green": "32", "yellow": "33", "blue": "34", "cyan": "36"}

    def __init__(self, on: bool):
        self.on = on

    def __call__(self, kind: str, text: str) -> str:
        return f"\x1b[{self.CODES[kind]}m{text}\x1b[0m" if self.on else text


def bar_colour(pct: float) -> str:
    return "red" if pct >= 90 else "yellow" if pct >= 70 else "green"


def bar(pct, st: Style, width: int = 20) -> str:
    if pct is None:
        return st("dim", "░" * width) + "    ?"
    pct = max(0.0, min(100.0, float(pct)))
    n = round(pct * width / 100)
    colour = bar_colour(pct)
    return st(colour, "█" * n) + st("dim", "░" * (width - n)) + f" {pct:3.0f}%"


def strip_ansi_len(s: str) -> int:
    return len(re.sub(r"\x1b\[[0-9;]*m", "", s))


def box(title: str, lines: list[str], width: int, st: Style) -> list[str]:
    inner = width - 4
    top = f"╭─ {title} " + "─" * max(0, width - 5 - strip_ansi_len(title)) + "╮"
    out = [top]
    for ln in lines:
        out.append("│ " + ln + " " * max(0, inner - strip_ansi_len(ln)) + " │")
    out.append("╰" + "─" * (width - 2) + "╯")
    return out


def dashboard_card(row: dict, st: Style, width: int) -> list[str]:
    res, job = row["resources"], row["job"]
    name = safe_text(row["name"])
    title = st("bold", name) + st("dim", f"  {safe_text(row['agent'])} · {safe_text(row['mode'])}")
    lines = []
    if res is None:
        lines.append(st("yellow", "running, but the VM could not be read"))
    else:
        mem_pct = 100 * res["mem_used"] / res["mem_total"] if res["mem_total"] else None
        disk_pct = 100 * res["disk_used"] / res["disk_total"] if res["disk_total"] else None
        lines += [f"uptime {fmt_dur(res['uptime_s'])}   load {res['load'][0]:.2f} {res['load'][1]:.2f} {res['load'][2]:.2f}"
                  f"   {res['cpus']} cpu",
                  f"cpu    {bar(res['cpu_pct'], st)}",
                  f"memory {bar(mem_pct, st)}  {fmt_bytes(res['mem_used'])}/{fmt_bytes(res['mem_total'])}",
                  f"disk   {bar(disk_pct, st)}  {fmt_bytes(res['disk_used'])}/{fmt_bytes(res['disk_total'])}"]
    if job and job["state"] != "none":
        view = job.get("progress")
        state = {"running": st("green", "running"), "finished": st("cyan", "finished"),
                 "lost": st("red", "lost")}.get(job["state"], job["state"])
        head = f"job {safe_text(job['id'])}  {state}"
        if view:
            head += st("red", "  STALLED") if view["stalled"] else ""
        lines.append(head)
        if view:
            idle = f"idle {fmt_dur(view['last_event_age_s'])}" if view["last_event_age_s"] is not None else "idle -"
            t = view["tokens"]
            cost = "" if view["cost_usd"] is None else \
                f"   cost {'~' if view['cost_is_estimate'] else ''}${view['cost_usd']:.2f}"
            lines.append(f"       elapsed {fmt_dur(view['elapsed_s'])}   {idle}   turns {view['turns']}   tools {view['tool_calls']}")
            lines.append(f"       tokens {fmt_count(t['total'])} (in {fmt_count(t['input'])} out {fmt_count(t['output'])}"
                         f" cache {fmt_count(t['cache_read'] + t['cache_creation'])}){cost}")
    else:
        lines.append(st("dim", "no job"))
    sessions = row.get("sessions") or []
    if sessions:
        age, mode = row.get("activity_age_s"), row.get("permission_mode")
        n = f"{len(sessions)} session{'s' if len(sessions) != 1 else ''}"
        act = f", active {fmt_dur(age)} ago" if isinstance(age, int) else ""
        mode = (f", mode {st('yellow', mode) if mode == 'bypassPermissions' else mode}"
                if mode in SESSION_MODES else "")
        lines.append(st("blue", "interactive") + f": {n}{act}{mode}")
    return box(title, lines, width, st)


def dashboard_lines(data: dict, st: Style, width: int = 78) -> list[str]:
    rows = data["profiles"]
    running = [r for r in rows if r.get("vm") == "running"]
    others = [r for r in rows if r.get("vm") != "running"]
    stamp = time.strftime("%H:%M:%S", time.localtime(data["generated_at"]))
    out = [st("bold", "agentbox") + f"  {len(running)} running" + st("dim", f"   {stamp}"), ""]
    if not data["sandboxes_known"]:
        out += [st("red", "could not list sandboxes (`sbx ls --json` failed)"), ""]
    for r in running:
        out += dashboard_card(r, st, width)
    if not running and data["sandboxes_known"]:
        out += [st("dim", "no sandbox is running"), ""]
    if others:
        out.append(st("dim", "not running: " + ", ".join(f"{safe_text(r['name'])} ({r.get('vm', '?')})" for r in others)))
    return out


def cmd_dashboard(cfg: Config, args) -> int:
    if args.json and args.watch:
        die("--json cannot be combined with --watch", EXIT_USAGE)
    interactive = getattr(args, "interactive", False)
    if interactive and (args.json or args.watch):
        die("--interactive cannot be combined with --json or --watch", EXIT_USAGE)
    if args.interval < 2:
        die("--interval must be at least 2 seconds", EXIT_USAGE)
    if interactive:
        if not (sys.stdin.isatty() and sys.stdout.isatty()):
            die("--interactive needs a terminal; use --watch or --json otherwise", EXIT_USAGE)
        return dashboard_ui(lambda: collect_dashboard(cfg), args.interval, RexStatus(rex_wanted()))
    tty = sys.stdout.isatty()
    st = Style(tty and "NO_COLOR" not in os.environ)
    width = max(60, min(100, shutil.get_terminal_size((78, 24)).columns - 2))
    rex = RexStatus(args.watch and rex_wanted(args.json))
    try:
        while True:
            data = collect_dashboard(cfg)
            if args.json:
                emit_json(data)
                return EXIT_OK
            text = "\n".join(dashboard_lines(data, st, width))
            print(("\x1b[H\x1b[2J" if tty and args.watch else "") + text, flush=True)
            if not args.watch:
                return EXIT_OK
            dashboard_rex(rex, data)
            time.sleep(args.interval)
    except KeyboardInterrupt:
        for rid in rex.ids():        # nothing is watched any more
            rex.clear(rid)
        return EXIT_OK


def dashboard_rex(rex: RexStatus, data: dict):
    """One record per profile (id = profile name) that follows its latest job, whatever the VM's state:
    done/error stay until the next job starts. A record is cleared only when the profile has no job, is
    disabled or is gone from the config. A profile whose state can't be read keeps its last record, so a
    flaky `sbx ls` doesn't clear and re-notify. While interactive sessions run (and no job does) the record
    is working/idle with msg "interactive...", never done/error/blocked; when they end it is the job's
    again."""
    if not data["sandboxes_known"]:
        return
    keep = set()
    for row in data["profiles"]:
        vm, j = row.get("vm"), row.get("job") or NO_JOB
        if vm == "unknown":
            keep.add(row["name"])
        elif vm == "running" or (row.get("enabled") and j["state"] != "none"):
            keep.add(row["name"])
            rex.report(dashboard_interactive_fields(row) or dashboard_fields(j), row["name"])
    for rid in rex.ids():
        if rid not in keep:
            rex.clear(rid)


def dashboard_interactive_fields(row: dict) -> dict | None:
    """The Rex record for a row in an interactive state, else None."""
    st = dash_state(row)
    if st == "interactive_working":
        return {"state": "working", "msg": "interactive"}
    if st == "interactive_idle":
        age = _int_or_none(row.get("activity_age_s"))
        return {"state": "idle", "msg": "interactive" + (f", idle {fmt_dur(age - age % 60)}" if age is not None else "")}
    return None


def dashboard_fields(j: dict) -> dict:
    """`rex_fields` for a dashboard row's job. A job that died with its sandbox (found lost while the VM
    was not running) is an error that says so."""
    if j["state"] == "lost" and j.get("vm") in ("stopped", "missing"):
        return {"state": "error", "msg": f"sandbox {j['vm']}"}
    return rex_fields(j, j.get("progress"))


# ---------------------------------------------------- interactive dashboard
# `dashboard --interactive`: a full-screen curses UI over collect_dashboard(). Only dashboard_ui() and
# DashScreen touch curses; the rest is plain functions over plain data (the rows, a UI-state dict, lines
# of (text, style) segments), so tests need no terminal. Every piece of text reaches the screen through
# dash_line(), which runs it through safe_text and replaces what is left of the control, format and
# combining characters, so a line is exactly as many cells wide as asked and curses never sees a control.
DASH_MIN_W, DASH_MIN_H, DASH_WIDE = 60, 15, 100       # smallest usable pane; side-by-side from this width
DASH_STATES = {     # display state: (glyph, ASCII glyph, style, label, sort group)
    "working": ("●", "*", "green", "working", 0),
    "interactive_working": ("◉", "@", "blue", "interactive", 1),
    "stalled": ("◐", "~", "yellow", "stalled", 2),
    "error": ("✗", "x", "red", "failed", 2),
    "lost": ("◌", "!", "red", "lost", 2),
    "interactive_idle": ("◦", "i", "blue", "interactive, idle", 3),
    "done": ("✓", "+", "cyan", "done", 4),
    "nojob": ("○", "o", "", "no job", 5),
    "stopped": ("□", "-", "dim", "stopped", 5),
    "disabled": ("⊘", "/", "dim", "disabled", 5),
    "unknown": ("?", "?", "yellow", "unknown", 5),
}
DASH_ACTIVE_S = 90          # an interactive session wrote within this many seconds: "working"
DASH_VM_STYLE = {"running": "green", "stopped": "dim", "missing": "dim", "unknown": "yellow", "disabled": "dim"}
DASH_STEP = {"done": ("✓", "+", "green"), "active": ("▶", ">", "bold"), "pending": ("·", "-", "dim")}
DASH_SPARK, DASH_SPARK_ASCII = "▁▂▃▄▅▆▇█", "_.-:=+*#"
DASH_HELP = [("↑ ↓  j k", "select a profile (or click it)"), ("Home End", "first / last profile"),
             ("wheel", "scroll the list or the details"), ("Enter  p", "watch the job: agentbox progress --watch"),
             ("l", "the job's log in a pager ($PAGER)"), ("f", "fetch the job's commits (asks first)"),
             ("u", "start: agentbox up (in a new Rex tab inside Rex)"), ("s", "stop the sandbox (asks first)"),
             ("v", "review and merge its branches: agentbox review (a new Rex tab inside Rex)"),
             ("r", "refresh now"), ("?", "this help"), ("q  Ctrl-C", "quit")]
DASH_HISTORY, DASH_HISTORY_JOBS = 120, 64            # samples per job, jobs remembered


def dash_state(row: dict) -> str:
    """A dashboard row (dashboard_entry's shape) -> a DASH_STATES key."""
    vm = row.get("vm")
    if vm == "disabled" or row.get("enabled") is False:
        return "disabled"
    if row.get("error"):
        return "unknown"
    job = row.get("job") or {}
    state = job.get("state")
    if state == "running":
        return "stalled" if (job.get("progress") or {}).get("stalled") else "working"
    if vm == "running" and row.get("sessions"):
        age = _int_or_none(row.get("activity_age_s"))
        return "interactive_working" if age is not None and age <= DASH_ACTIVE_S else "interactive_idle"
    if state == "finished":
        return "done" if job.get("exit_code") == 0 else "error"
    if state == "lost":
        return "lost"
    if vm == "running":
        return "nojob"
    if vm in ("stopped", "missing"):
        return "stopped"
    return "unknown"


def dash_sort(rows: list) -> list:
    """Working jobs first, then working interactive sessions, then the ones needing attention (stalled,
    failed, lost), then idle interactive sessions, then finished, then the rest; by name within each group."""
    return sorted(rows, key=lambda r: (DASH_STATES[dash_state(r)][4], str(r.get("name"))))


def dash_clean(s) -> str:
    """safe_text, then a space for tab and newline and '?' for any control, format, private-use,
    unassigned, combining or separator character left: what remains is one or two cells each."""
    out = []
    for ch in safe_text("" if s is None else s):
        cat = unicodedata.category(ch)
        out.append(" " if ch in "\t\n" else "?" if cat[0] == "C" or cat in ("Mn", "Me", "Zl", "Zp") else ch)
    return "".join(out)


def _cell(ch: str) -> int:
    return 2 if unicodedata.east_asian_width(ch) in "WF" else 1


def dash_cells(s: str) -> int:
    """Width in terminal cells of text that went through dash_clean."""
    return sum(_cell(ch) for ch in s)


def _clip(s: str, w: int) -> tuple[str, int]:
    out, used = [], 0
    for ch in s:
        c = _cell(ch)
        if used + c > w:
            break
        out.append(ch)
        used += c
    return "".join(out), used


def dash_line(segs, width: int, ascii_: bool = False) -> list:
    """Segments -> segments whose text is clean and exactly `width` cells wide: clipped with an
    ellipsis, or padded with spaces."""
    if width <= 0:
        return []
    segs = [(dash_clean(t), st) for t, st in segs if t]
    if sum(dash_cells(t) for t, _ in segs) > width:
        out, room = [], width - 1
        for t, st in segs:
            part, used = _clip(t, room)
            if part:
                out.append((part, st))
            room -= used
            if part != t:
                break
        segs = out + [(" " * room + ("~" if ascii_ else "…"), out[-1][1] if out else "")]
    used = sum(dash_cells(t) for t, _ in segs)
    return segs + [(" " * (width - used), "")] if used < width else segs


def sparkline(values, width: int, ascii_: bool = False) -> str:
    """The last `width` values as block characters, scaled to the largest, right-aligned in exactly
    `width` cells. None is a gap; 0 is the lowest block; anything above 0 is at least the second."""
    if width <= 0:
        return ""
    chars = DASH_SPARK_ASCII if ascii_ else DASH_SPARK
    vals = list(values)[-width:]
    top = max((v for v in vals if v is not None), default=0)
    out = []
    for v in vals:
        if v is None:
            out.append(" ")
        elif v <= 0 or top <= 0:
            out.append(chars[0])
        else:
            out.append(chars[max(1, min(len(chars) - 1, round(v * (len(chars) - 1) / top)))])
    return " " * (width - len(out)) + "".join(out)


def _int_or_none(v):
    return v if isinstance(v, int) and not isinstance(v, bool) else None


class DashHistory:
    """In memory only: per job id, a ring buffer of the job's running totals (tokens, tool calls), one
    sample per collection. Keeps the DASH_HISTORY_JOBS most recently seen jobs."""
    KEYS = ("tokens", "tools")

    def __init__(self, size: int = DASH_HISTORY, jobs: int = DASH_HISTORY_JOBS):
        self.size, self.max_jobs, self.jobs = size, jobs, {}

    def add(self, data: dict):
        for row in (data or {}).get("profiles") or []:
            job = row.get("job") or {}
            jid, view = job.get("id"), job.get("progress")
            if not isinstance(jid, str) or not isinstance(view, dict):
                continue
            rings = self.jobs.pop(jid, None) or {k: collections.deque(maxlen=self.size + 1) for k in self.KEYS}
            self.jobs[jid] = rings                      # most recently seen last
            rings["tokens"].append(_int_or_none((view.get("tokens") or {}).get("total")))
            rings["tools"].append(_int_or_none(view.get("tool_calls")))
        while len(self.jobs) > self.max_jobs:
            del self.jobs[next(iter(self.jobs))]

    def totals(self, jid, key: str) -> list:
        return list(self.jobs.get(jid, {}).get(key, ()))

    def deltas(self, jid, key: str) -> list:
        """How much the total grew between consecutive samples (None where a sample was missing)."""
        v = self.totals(jid, key)
        return [None if a is None or b is None else max(0, b - a) for a, b in zip(v, v[1:])]


def dash_layout(width: int, height: int, nrows: int) -> dict | None:
    """Where the profile list and the details go, as (x, y, w, h); None if the pane is too small.
    Row 0 is the header and the last row the footer."""
    if width < DASH_MIN_W or height < DASH_MIN_H:
        return None
    body = height - 2
    if width >= DASH_WIDE:
        lw = max(30, min(46, width // 3))
        return {"stacked": False, "list": (0, 1, lw, body), "detail": (lw + 1, 1, width - lw - 1, body)}
    lh = max(3, min(max(nrows, 1), body // 3))
    return {"stacked": True, "list": (0, 1, width, lh), "detail": (0, lh + 2, width, body - lh - 1)}


def dash_new_ui(size=(80, 24), tab: bool = False) -> dict:
    """The UI state dash_key and dash_render share. `names` is the sorted profile names, `sel` an index
    into it, `top` / `dtop` the scroll of the list / details, `mode` list | help | confirm | nofetch (fetch
    refused: the sandbox is not running) | stop (y/N) | stopname (the name typed so far is `typed`),
    `vm` each profile's sandbox state, `states` its dash_state, `modes` its mode (clone | direct). `tab`: `u` opens a Rex tab (rex_tab_program
    found one); `up_fallback` names the profile whose tab failed to open, so its next `u` runs here."""
    return {"names": [], "sel": 0, "top": 0, "dtop": 0, "size": tuple(size), "mode": "list", "target": None,
            "msg": "", "busy": False, "error": "", "vm": {}, "states": {}, "modes": {}, "typed": "", "tab": tab,
            "up_fallback": None}


def dash_set_rows(ui: dict, names: list, vms: dict | None = None, states: dict | None = None,
                  modes: dict | None = None) -> dict:
    """New data arrived: keep the same profile selected if it is still there."""
    old = ui["names"][ui["sel"]] if ui["names"] else None
    sel = names.index(old) if old in names else min(ui["sel"], max(0, len(names) - 1))
    return _dash_follow({**ui, "names": list(names), "sel": sel, "vm": dict(vms or {}),
                         "states": dict(states or {}), "modes": dict(modes or {})}, sel)


def _dash_follow(ui: dict, sel: int) -> dict:
    """Select `sel` and scroll the list so it is visible."""
    n = len(ui["names"])
    sel = max(0, min(sel, n - 1)) if n else 0
    lay = dash_layout(*ui["size"], n)
    top = ui["top"]
    if lay:
        lh = lay["list"][3]
        top = min(top, sel) if sel < top else max(top, sel - lh + 1)
        top = max(0, min(top, max(0, n - lh)))
    return {**ui, "sel": sel, "top": top, "dtop": 0 if sel != ui["sel"] else ui["dtop"]}


def _inside(rect, x, y) -> bool:
    rx, ry, rw, rh = rect
    return rx <= x < rx + rw and ry <= y < ry + rh


def dash_key(ui: dict, key) -> tuple[dict, tuple | None]:
    """(UI state, key) -> (new UI state, action or None). A key is a character, a name ("up", "down",
    "home", "end", "pgup", "pgdn", "enter", "esc", "ctrl-c", "resize"), ("click", x, y) or
    ("wheel", +1/-1, x, y). Actions: ("quit",), ("refresh",), ("redraw",), ("progress", name),
    ("logs", name), ("confirm_fetch", name) and, only straight after a confirm_fetch and a "y",
    ("fetch", name). The loop runs them; dash_argv says how. `f` on a stopped or missing sandbox only
    says why there is nothing to fetch: fetch needs the sandbox running, and booting it (`fetch --start`)
    relaunches the agent, so the dashboard never offers that.
    `u` gives ("up_tab", name) when ui["tab"] (the loop opens a Rex tab), else ("up", name) (run here).
    `v` on a clone-mode profile gives ("review_tab", name) or ("review", name), as `u` does.
    `s` on a running sandbox gives ("confirm_stop", name) and opens a question; ("stop", name) comes only
    from it: a "y" if no job is running there, else the profile name typed exactly and Enter."""
    ui = {**ui, "msg": ""}
    n = len(ui["names"])
    name = ui["names"][ui["sel"]] if n else None
    if key == "resize":
        return _dash_follow(ui, ui["sel"]), ("redraw",)
    if ui["mode"] == "confirm":
        target, ui = ui["target"], {**ui, "mode": "list", "target": None}
        if key in ("y", "Y") and target:
            return ui, ("fetch", target)
        return {**ui, "msg": "fetch cancelled"}, None
    if ui["mode"] == "stop":
        target, ui = ui["target"], {**ui, "mode": "list", "target": None}
        if key in ("y", "Y") and target:
            return ui, ("stop", target)
        return {**ui, "msg": "stop cancelled"}, None
    if ui["mode"] == "stopname":
        return _dash_type_name(ui, key)
    if ui["mode"] in ("help", "nofetch"):
        return {**ui, "mode": "list", "target": None}, ("quit",) if key in ("q", "ctrl-c") else None
    if key in ("q", "Q", "ctrl-c"):
        return ui, ("quit",)
    lay = dash_layout(*ui["size"], n)
    page = lay["list"][3] if lay else 1
    moves = {"up": -1, "k": -1, "down": 1, "j": 1, "pgup": -page, "pgdn": page}
    if key in moves:
        return _dash_follow(ui, ui["sel"] + moves[key]), None
    if key in ("home", "g"):
        return _dash_follow(ui, 0), None
    if key in ("end", "G"):
        return _dash_follow(ui, n - 1), None
    if key == "r":
        return ui, ("refresh",)
    if key == "?":
        return {**ui, "mode": "help"}, None
    if isinstance(key, tuple) and lay:
        kind, *rest = key
        if kind == "click":
            x, y = rest
            lx, ly, lw, lh = lay["list"]
            if _inside(lay["list"], x, y) and ui["top"] + y - ly < n:
                return _dash_follow(ui, ui["top"] + y - ly), None
        elif kind == "wheel":
            step, x, y = rest
            if _inside(lay["detail"], x, y):
                return {**ui, "dtop": max(0, ui["dtop"] + 3 * step)}, None
            return {**ui, "top": max(0, min(ui["top"] + 3 * step, max(0, n - lay["list"][3])))}, None
        return ui, None
    if name is None:
        return ui, None
    if key in ("enter", "p"):
        return ui, ("progress", name)
    if key == "l":
        return ui, ("logs", name)
    if key == "f":
        if (ui.get("vm") or {}).get(name) in ("stopped", "missing"):
            return {**ui, "mode": "nofetch", "target": name}, None
        return {**ui, "mode": "confirm", "target": name}, ("confirm_fetch", name)
    vm, state = (ui.get("vm") or {}).get(name), (ui.get("states") or {}).get(name)
    busy = state in ("working", "stalled")
    if key == "u":
        if vm == "disabled" or state == "disabled":
            return {**ui, "msg": f"{name} is disabled in agentbox.toml: not starting it"}, None
        warn = f"a job is running in {name}: up attaches to its sandbox" if busy else ""
        if ui.get("tab") and ui.get("up_fallback") != name:
            return {**ui, "msg": warn}, ("up_tab", name)
        return {**ui, "msg": warn, "up_fallback": None}, ("up", name)
    if key == "v":
        if (ui.get("modes") or {}).get(name) != "clone":
            return {**ui, "msg": f"{name} is not a clone-mode profile: nothing to review (see `agentbox audit {name}`)"}, None
        if ui.get("tab") and ui.get("up_fallback") != name:
            return ui, ("review_tab", name)
        return {**ui, "up_fallback": None}, ("review", name)
    if key == "s":
        if vm != "running":
            return {**ui, "msg": f"{name}'s sandbox is {vm or 'unknown'}, not running: nothing to stop"}, None
        return {**ui, "mode": "stopname" if busy else "stop", "target": name, "typed": ""}, ("confirm_stop", name)
    return ui, None


DASH_TYPED_MAX = 64


def _dash_type_name(ui: dict, key) -> tuple[dict, tuple | None]:
    """The `stopname` question: printable characters add to ui["typed"], backspace removes one, Enter
    stops only if what was typed is exactly the profile name; Esc, Ctrl-C or a mismatch cancel."""
    target, typed = ui["target"], ui.get("typed", "")
    done = {**ui, "mode": "list", "target": None, "typed": ""}
    if key == "enter":
        if target and typed == target:
            return done, ("stop", target)
        return {**done, "msg": "stop cancelled: the name did not match"}, None
    if key in ("esc", "ctrl-c"):
        return {**done, "msg": "stop cancelled"}, None
    if key == "backspace":
        return {**ui, "typed": typed[:-1]}, None
    if (isinstance(key, str) and len(key) == 1 and unicodedata.category(key)[0] != "C"
            and len(typed) < DASH_TYPED_MAX):
        return {**ui, "typed": typed + key}, None
    return ui, None


def dash_argv(action) -> list[str] | None:
    """The agentbox arguments for an action that runs a command, or None. These are the only commands
    the dashboard ever runs (progress, logs, fetch, up, stop, review), and never with another flag."""
    kind, name = (tuple(action) + (None, None))[:2]
    if not isinstance(name, str) or not NAME_RE.match(name):
        return None
    return {"progress": ["progress", name, "--watch"], "logs": ["logs", name], "fetch": ["fetch", name],
            "up": ["up", name], "up_tab": ["up", name], "stop": ["stop", name],
            "review": ["review", name], "review_tab": ["review", name]}.get(kind)


def _dash_clock(iso, now: float) -> str:
    t = iso_epoch(iso) if isinstance(iso, str) else None
    if t is None:
        return "-"
    fmt = "%H:%M:%S" if time.localtime(t)[:3] == time.localtime(now)[:3] else "%b %d %H:%M"
    return time.strftime(fmt, time.localtime(t))


def _dash_dur(v, precise: bool = False) -> str:
    return fmt_dur(v, precise) if _int_or_none(v) is not None else "-"


def _dash_count(v) -> str:
    return fmt_count(v) if _int_or_none(v) is not None and v >= 0 else "-"


def dash_when(row: dict, now: float) -> str:
    """The list's time column: a running job's elapsed time, how long ago an interactive session last wrote,
    or how long ago an ended job finished."""
    st, job = dash_state(row), row.get("job") or {}
    if st in ("working", "stalled"):
        return _dash_dur((job.get("progress") or {}).get("elapsed_s"))
    if st in ("interactive_working", "interactive_idle"):
        age = _int_or_none(row.get("activity_age_s"))
        if age is None:
            return "idle" if st == "interactive_idle" else "-"
        return f"{fmt_dur(age)} ago" if st == "interactive_working" else f"idle {fmt_dur(age)}"
    if st in ("done", "error", "lost"):
        t = iso_epoch(job.get("finished_at")) if isinstance(job.get("finished_at"), str) else None
        return f"{fmt_dur(max(0, now - t))} ago" if t is not None else "-"
    return ""


def dash_bar(pct, width: int, ascii_: bool) -> list:
    if pct is None:
        return [(("-" if ascii_ else "░") * width, "dim"), ("    ?", "")]
    pct = max(0.0, min(100.0, float(pct)))
    n = round(pct * width / 100)
    full, empty = ("#", "-") if ascii_ else ("█", "░")
    return [(full * n, bar_colour(pct)), (empty * (width - n), "dim"), (f" {pct:3.0f}%", "")]


def dash_list(rows: list, ui: dict, w: int, h: int, now: float, ascii_: bool) -> list:
    top = max(0, min(ui["top"], max(0, len(rows) - h)))
    nw = max(8, min(41, w - 25))
    out = []
    for i, row in enumerate(rows[top:top + h], top):
        g, ga, style, _, _ = DASH_STATES[dash_state(row)]
        sel = " sel" if i == ui["sel"] else ""
        name, used = _clip(dash_clean(row.get("name")), nw)
        text = f"{name}{' ' * (nw - used)} {dash_clean(row.get('agent') or '-'):<8.8} {dash_when(row, now):>11}"
        mark = ("R" if ascii_ else "◆") if dash_review_note((row.get("review") or {}).get("counts"), 0) else " "
        out.append(dash_line([(" ", sel), (ga if ascii_ else g, (style + sel).strip()), (" ", sel), (text, sel.strip()),
                              (mark, ("yellow" + sel).strip())], w, ascii_))
    return out


def dash_detail(row: dict, history: DashHistory, w: int, now: float, ascii_: bool) -> list:
    """Unclipped segment lists describing one profile; dash_render cuts them to the panel."""
    st = dash_state(row)
    g, ga, style, label, _ = DASH_STATES[st]
    L = [[(ga if ascii_ else g, style), (" ", ""), (row.get("name"), "bold"), (f"  {label}", style),
          (f"   {row.get('agent') or '-'} {'/' if ascii_ else '·'} {row.get('mode') or '-'}", "dim")]]
    if row.get("error"):
        L.append([("this profile could not be read (try `agentbox doctor` for it)", "red")])
    vm, res = row.get("vm") or "unknown", row.get("resources")
    head = [("VM   ", "bold"), (vm, DASH_VM_STYLE.get(vm, ""))]
    if vm == "running" and isinstance(res, dict):
        load = res.get("load")
        head.append((f"   up {_dash_dur(res.get('uptime_s'))}", ""))
        if isinstance(load, list) and len(load) == 3 and all(isinstance(x, (int, float)) for x in load):
            head.append((f"   load {load[0]:.2f} {load[1]:.2f} {load[2]:.2f}", "dim"))
        if _int_or_none(res.get("cpus")):
            head.append((f"   {res['cpus']} cpu", "dim"))
    L += [[], head]
    if vm == "running":
        if not isinstance(res, dict):
            L.append([("     running, but the VM could not be read", "yellow")])
        else:
            bw = max(10, min(30, w - 34))

            def pct(used, total):
                return 100 * used / total if _int_or_none(used) is not None and _int_or_none(total) else None
            for lbl, p, extra in (
                    ("cpu", res.get("cpu_pct") if isinstance(res.get("cpu_pct"), (int, float)) else None, ""),
                    ("memory", pct(res.get("mem_used"), res.get("mem_total")), (res.get("mem_used"), res.get("mem_total"))),
                    ("disk", pct(res.get("disk_used"), res.get("disk_total")), (res.get("disk_used"), res.get("disk_total")))):
                tail = f"  {fmt_bytes(extra[0])}/{fmt_bytes(extra[1])}" if extra and p is not None else ""
                L.append([(f"     {lbl:<7}", "")] + dash_bar(p, bw, ascii_) + [(tail, "dim")])
    rv = row.get("review") if isinstance(row.get("review"), dict) else {}
    note = dash_review_note(rv.get("counts"), _int_or_none(rv.get("commits")))
    if note:
        L += [[], [("review ", "bold"), (note, "yellow")]]
    job = row.get("job") or {}
    interactive = st in ("interactive_working", "interactive_idle")
    if vm == "running" and row.get("sessions"):
        L += [[]] + dash_sessions(row, ascii_)
    L.append([])
    if job.get("state") in (None, "none") or not job.get("id"):
        L.append([("last job  " if interactive else "job  ", "bold" if not interactive else "dim"), ("none", "dim")])
        return L
    if interactive:         # an ended job: one line under the sessions
        jl = DASH_STATES["done" if job.get("state") == "finished" and job.get("exit_code") == 0
                         else "error" if job.get("state") == "finished" else "lost"][3]
        when = dash_when(row | {"sessions": []}, now)
        L.append([(f"last job: {jl}{' ' + when if when and when != '-' else ''}", "dim"),
                  (f"   {job.get('id')}", "dim")])
        return L
    view = job.get("progress") if isinstance(job.get("progress"), dict) else {}
    jstate = job.get("state")
    jstyle = {"running": "green", "finished": "cyan" if job.get("exit_code") == 0 else "red", "lost": "red"}
    L.append([("job  ", "bold"), (job.get("id"), ""), ("  ", ""), (jstate, jstyle.get(jstate, ""))]
             + ([("  STALLED", "red bold")] if view.get("stalled") else []))
    code = job.get("exit_code")
    if job_branch(job.get("branch")):
        L.append([("     branch  ", ""), (job_branch(job.get("branch")), "bold"),
                  (f"  at {job['end_head'][:12]}" if _commit(job.get("end_head")) else "", "dim")])
    L.append([(f"     started {_dash_clock(job.get('started_at'), now)}   finished {_dash_clock(job.get('finished_at'), now)}"
               f"   exit {code if _int_or_none(code) is not None else '-'}", "")])
    L.append([(f"     elapsed {_dash_dur(view.get('elapsed_s'), True)}   idle {_dash_dur(view.get('last_event_age_s'), True)}"
               f"   turns {_dash_count(view.get('turns'))}   tool calls {_dash_count(view.get('tool_calls'))}", "")])
    tools = [t for t in view.get("tools_top") or [] if isinstance(t, dict)]
    if tools:
        L.append([("     tools   ", ""), (", ".join(f"{t.get('name')} {_dash_count(t.get('count'))}" for t in tools), "dim")])
    commits, expect = _int_or_none(view.get("commits")), _int_or_none(view.get("expect_commits"))
    tok = view.get("tokens") if isinstance(view.get("tokens"), dict) else {}
    cache = [_int_or_none(tok.get(k)) for k in ("cache_read", "cache_creation")]
    cost = view.get("cost_usd")
    cost = (f"{'~' if view.get('cost_is_estimate') else ''}${cost:.2f}"
            if isinstance(cost, (int, float)) and not isinstance(cost, bool) else "-")
    L.append([(f"     commits {'-' if commits is None else commits}{f'/{expect}' if commits is not None and expect else ''}"
               f"   tokens {_dash_count(tok.get('total'))}", ""),
              (f" (in {_dash_count(tok.get('input'))} out {_dash_count(tok.get('output'))}"
               f" cache {_dash_count(sum(cache) if None not in cache else None)})", "dim"),
              ("   cost ", ""), (cost, "")])
    denials = _int_or_none(view.get("denials"))
    if denials:
        L.append([(f"     denied  {denials}", "yellow bold"),
                  ("  actions refused by Claude Code's permission check (see the log: l)", "dim")])
    if view.get("stale"):
        L.append([("     (cached values: the sandbox could not be read)", "dim")])
    sw = max(8, min(60, w - 30))
    for lbl, key in (("tokens", "tokens"), ("tool calls", "tools")):
        d = history.deltas(job.get("id"), key)
        line = [(f"     {lbl:<11}", "")]
        line += [(sparkline(d, sw, ascii_), "cyan"), ("  per refresh", "dim")] if d else [("(after the next refresh)", "dim")]
        L.append(line)
    plan = view.get("plan") if isinstance(view.get("plan"), dict) else None
    steps = [s for s in (plan or {}).get("steps") or [] if isinstance(s, dict)]
    if steps:
        L += [[], [("plan ", "bold"), (f"{_dash_count(plan.get('done'))}/{_dash_count(plan.get('total'))}", ""),
                   ("   agent's plan, not verified", "dim")]]
        for s in steps:
            sg, sa, sst = DASH_STEP.get(s.get("status"), DASH_STEP["pending"])
            L.append([("     ", ""), (sa if ascii_ else sg, sst), (" ", ""), (s.get("text"), sst if sst != "green" else "")])
    if view.get("note"):
        L.append([("note ", "bold"), (view.get("note"), ""), ("   agent's note", "dim")])
    return L


def dash_sessions(row: dict, ascii_: bool) -> list:
    """The detail panel's block for a running VM's interactive agent sessions."""
    sessions = [s for s in row.get("sessions") or [] if isinstance(s, dict)]
    age, mode = _int_or_none(row.get("activity_age_s")), row.get("permission_mode")
    L = [[("sessions  ", "bold"), (f"{len(sessions)} interactive", "blue")]]
    for s in sessions:
        L.append([(f"     {dash_clean(s.get('agent')):<9.9}", ""), (f"running {_dash_dur(s.get('age_s'))}", "dim")])
    last = [("     last activity ", ""), (f"{fmt_dur(age)} ago" if age is not None else "-", "")]
    if mode in SESSION_MODES:
        bypass = mode == "bypassPermissions"
        last += [("   mode ", ""), (mode, "yellow" if bypass else "")]
        if bypass:
            last.append(("  (bypass: no permission checks)", "yellow"))
    L.append(last)
    return L


def dash_fetch_text(row: dict, name: str, ok: bool) -> list:
    """The body of the `f` box: what `agentbox fetch <name>` will fetch and where (resolved by
    fetch_defaults, as fetch itself does), or - for a stopped or missing sandbox - why it can't."""
    sandbox = row.get("sandbox") or "the sandbox"
    if not ok:
        if row.get("vm") == "missing":
            return [[(f"Sandbox {sandbox} does not exist, so there is nothing to fetch.", "")], [],
                    [("any key closes this", "dim")]]
        return [[(f"Sandbox {sandbox} is stopped. Fetch needs it running:", "")],
                [("sbx drops the sandbox's git remote when it stops.", "")],
                [("Booting it (`agentbox fetch --start`) relaunches the agent", "dim")],
                [("last started with `sbx run`, so it is not offered here.", "dim")], [],
                [("any key closes this", "dim")]]
    t = fetch_defaults(name, row.get("job"))
    return [[("This runs:", "")], [("  " + shlex.join(["agentbox", "fetch", name]), "bold")], [],
            [("  fetches  ", "dim"), (t["ref"], "bold"), (f"  ({t['why']})", "dim")],
            [("  into     ", "dim"), (t["branch"], "bold")],
            [("  (if the job changes before it runs, fetch follows the new job)", "dim")], [],
            [("y", "bold"), (" to run it, any other key cancels", "")]]


def dash_stop_text(row: dict, name: str, typed: str | None = None) -> list:
    """The body of the `s` box: the exact command and, while a job runs there (typed is not None), a red
    warning and the name typed so far."""
    sandbox = row.get("sandbox") or "the sandbox"
    body = [[("This runs:", "")], [("  " + shlex.join(["agentbox", "stop", name]), "bold")], [],
            [(f"  stops {sandbox}; its files stay, and `agentbox up {name}` starts it again", "dim")], []]
    if typed is None:
        return body + [[("y", "bold"), (" to run it, any other key cancels", "")]]
    jid = (row.get("job") or {}).get("id")
    return body + [[("A job is running here" + (f" ({jid})" if jid else "") + ".", "red bold")],
                   [("Stopping kills it, and it will be reported as lost.", "red bold")], [],
                   [("Type the profile name, then Enter, to stop it. Esc cancels.", "")],
                   [("  > ", "bold"), (typed, "bold"), ("_", "")]]


def _dash_box(title: str, body: list, w: int, ascii_: bool) -> list:
    """A framed box (list of segment lists) at most w cells wide, for the help and confirm overlays."""
    inner = min(w - 4, max([dash_cells(dash_clean(title)) + 2] + [sum(dash_cells(dash_clean(t)) for t, _ in ln) for ln in body]))
    h, v, tl, tr, bl, br = ("-", "|", "+", "+", "+", "+") if ascii_ else ("─", "│", "╭", "╮", "╰", "╯")
    title = dash_clean(title)
    out = [[(f"{tl}{h} {title} " + h * (inner - 1 - dash_cells(title)) + tr, "bold")]]
    out += [[(v + " ", "bold")] + dash_line(ln, inner, ascii_) + [(" " + v, "bold")] for ln in body]
    out.append([(bl + h * (inner + 2) + br, "bold")])
    return out


def dash_render(data, ui: dict, history: DashHistory, size, now: float | None = None, ascii_: bool = False) -> list:
    """The whole screen: `size[1]` lines of (text, style) segments, each exactly `size[0]` cells wide."""
    w, h = size
    if w <= 0 or h <= 0:
        return []
    now = time.time() if now is None else now
    rows = dash_sort((data or {}).get("profiles") or [])
    lay = dash_layout(w, h, len(rows))
    if lay is None:
        msg = f"make the pane bigger: at least {DASH_MIN_W}x{DASH_MIN_H} (now {w}x{h})"
        lines = [dash_line([], w) for _ in range(h)]
        lines[h // 2] = dash_line([(" " * max(0, (w - len(msg)) // 2), ""), (msg, "yellow")], w, ascii_)
        return lines
    # header
    head = [(" agentbox", "bold")]
    if data:
        head += [(f"   {sum(r.get('vm') == 'running' for r in rows)} running", ""),
                 (f"   {time.strftime('%H:%M:%S', time.localtime(data.get('generated_at') or now))}", "dim")]
    head += [("   refreshing…" if not ascii_ else "   refreshing...", "cyan")] if ui.get("busy") else []
    if data and not data.get("sandboxes_known", True):
        head.append(("   could not list sandboxes (`sbx ls --json` failed)", "red bold"))
    if ui.get("error"):
        head.append((f"   {ui['error']}", "red bold"))
    # list and details
    lx, ly, lw, lh = lay["list"]
    dx, dy, dw, dh = lay["detail"]
    if rows:
        left = dash_list(rows, ui, lw, lh, now, ascii_)
        sel = rows[max(0, min(ui["sel"], len(rows) - 1))]
        detail = dash_detail(sel, history, dw - 1, now, ascii_)
    else:
        left = [dash_line([(" collecting…" if data is None else " no profiles in agentbox.toml", "dim")], lw, ascii_)]
        detail = []
    left += [dash_line([], lw)] * (lh - len(left))
    dtop = max(0, min(ui.get("dtop", 0), max(0, len(detail) - dh)))
    right = [dash_line([(" ", "")] + seg, dw, ascii_) for seg in detail[dtop:dtop + dh]]
    right += [dash_line([], dw)] * (dh - len(right))
    if lay["stacked"]:
        rule = "-" if ascii_ else "─"
        n = len(rows)
        top = max(0, min(ui["top"], n - lh))
        span = f" {top + 1}-{top + lh} of {n} " if n > lh else ""
        body = left + [dash_line([(rule * 2 + span + rule * max(0, w - 2 - len(span)), "dim")], w, ascii_)] + right
    else:
        bar_ = "|" if ascii_ else "│"
        body = [left[i] + [(bar_, "dim")] + right[i] for i in range(h - 2)]
    # overlays
    box = None
    if ui.get("mode") == "help":
        help_ = [("Up Dn  j k", d) if ascii_ and i == 0 else (k, d) for i, (k, d) in enumerate(DASH_HELP)]
        kw = max(dash_cells(k) for k, _ in help_)
        box = _dash_box("keys", [[(f"{k:<{kw}}  ", "bold"), (d, "")] for k, d in help_]
                        + [[], [("any key closes this", "dim")]], w, ascii_)
    elif ui.get("mode") in ("confirm", "nofetch") and ui.get("target"):
        box = _dash_box("fetch", dash_fetch_text(next((r for r in rows if r.get("name") == ui["target"]), {}),
                                                 ui["target"], ui["mode"] == "confirm"), w, ascii_)
    elif ui.get("mode") in ("stop", "stopname") and ui.get("target"):
        box = _dash_box("stop", dash_stop_text(next((r for r in rows if r.get("name") == ui["target"]), {}),
                                               ui["target"], ui.get("typed", "") if ui["mode"] == "stopname" else None),
                        w, ascii_)
    if box:
        top = max(0, (len(body) - len(box)) // 2)
        bw = sum(dash_cells(t) for t, _ in box[0])
        for i, ln in enumerate(box[:len(body)]):
            body[top + i] = dash_line([(" " * max(0, (w - bw) // 2), "")] + ln, w, ascii_)
    # footer
    if ui.get("msg"):
        foot = [(" " + ui["msg"], "yellow")]
    elif ui.get("mode") == "confirm":
        foot = [(" y", "bold"), (" fetch   ", ""), ("any other key", "bold"), (" cancel", "")]
    elif ui.get("mode") == "nofetch":
        foot = [(" any key", "bold"), (" close", "")]
    elif ui.get("mode") == "stop":
        foot = [(" y", "bold"), (" stop   ", ""), ("any other key", "bold"), (" cancel", "")]
    elif ui.get("mode") == "stopname":
        foot = [(" type the profile name, ", ""), ("Enter", "bold"), (" stop   ", ""), ("Esc", "bold"), (" cancel", "")]
    else:
        keys = (("j/k" if ascii_ else "↑↓", "select"), ("Enter", "progress"), ("l", "logs"), ("f", "fetch"),
                ("u", "up"), ("s", "stop"), ("v", "review"), ("r", "refresh"), ("?", "help"), ("q", "quit"))
        foot = [s for k, d in keys for s in ((f" {k}", "bold"), (f" {d}  ", "dim"))]
    return [dash_line(head, w, ascii_)] + body + [dash_line(foot, w, ascii_)]


class DashCollector:
    """Runs collect() in a worker thread so the UI stays responsive while sbx is slow; never two at once."""

    def __init__(self, collect):
        self.collect, self.lock, self.running, self.result = collect, threading.Lock(), False, None

    def start(self) -> bool:
        with self.lock:
            if self.running:
                return False
            self.running = True
        threading.Thread(target=self._run, daemon=True).start()
        return True

    def _run(self):
        try:
            res = ("ok", self.collect())
        except (Exception, SystemExit) as e:        # die() in a worker must not end the UI
            res = ("error", e)
        with self.lock:
            self.result, self.running = res, False

    def take(self):
        """The last finished collection's ("ok", data) or ("error", exception), once; else None."""
        with self.lock:
            res, self.result = self.result, None
            return res


def agentbox_argv(args: list[str]) -> list[str]:
    """This same agentbox, run as a child process."""
    return [sys.executable, str(Path(__file__).resolve()), *args]


REX_APP_CLI = "/Applications/Rex.app/Contents/Helpers/Rex Server.rex/Contents/MacOS/rex"


def _executable(path) -> bool:
    return bool(path) and os.path.isabs(path) and os.path.isfile(path) and os.access(path, os.X_OK)


def rex_program(env=None) -> str | None:
    """The `rex` CLI: $AGENTBOX_REX if it is an absolute path to an executable, else `rex` on PATH, else
    the one inside Rex.app. None if there is none."""
    env = os.environ if env is None else env
    if _executable(env.get("AGENTBOX_REX")):
        return env["AGENTBOX_REX"]
    found = shutil.which("rex", path=env.get("PATH") or os.defpath)
    if found and _executable(os.path.abspath(found)):
        return os.path.abspath(found)
    return REX_APP_CLI if _executable(REX_APP_CLI) else None


def rex_tab_program(env=None) -> str | None:
    """The rex CLI if the dashboard runs inside a Rex block (REX_SESSION and REX_BLOCK set), else None."""
    env = os.environ if env is None else env
    return rex_program(env) if env.get("REX_SESSION") and env.get("REX_BLOCK") else None


def rex_run_argv(rex: str, argv: list[str] | None, keep_open: bool = True) -> list[str] | None:
    """`rex run` opening `agentbox <argv>` in a new tab of this Rex session; argv is what dash_argv made of an
    action (`up <name>`, `review <name>`), so the name was checked there. --keep-open leaves the tab open
    after the command ends, so its output can be read."""
    if not rex or not isinstance(argv, list) or not argv or not all(isinstance(a, str) for a in argv):
        return None
    return [rex, "run", "--shell=none", *(["--keep-open"] if keep_open else []), "--label",
            shlex.join(["agentbox", *argv]), "--", *agentbox_argv(argv)]


def dash_pager() -> list[str]:
    try:
        argv = shlex.split(os.environ.get("PAGER") or "")
    except ValueError:
        argv = []
    return argv or ["less", "-R"]


class DashScreen:
    """The curses side of `dashboard --interactive`: draw dash_render's lines, turn curses input into
    dash_key's keys, run the actions."""

    def __init__(self, scr, curses, collect, interval: float, rex: RexStatus, ascii_: bool):
        self.scr, self.c, self.coll, self.interval, self.rex, self.ascii = scr, curses, DashCollector(collect), interval, rex, ascii_
        self.rexbin = rex_tab_program()
        self.history, self.data, self.attrs = DashHistory(), None, {}

    def setup(self):
        c = self.c
        with contextlib.suppress(c.error):
            c.curs_set(0)
        self.scr.keypad(True)
        self.scr.timeout(200)
        buttons = c.BUTTON1_PRESSED | c.BUTTON1_CLICKED | c.BUTTON4_PRESSED | getattr(c, "BUTTON5_PRESSED", 0)
        with contextlib.suppress(c.error):
            c.mousemask(buttons)
            c.mouseinterval(0)
        colour = c.has_colors() and "NO_COLOR" not in os.environ
        a = {"": 0, "bold": c.A_BOLD, "dim": c.A_DIM, "sel": c.A_REVERSE}
        plain = {"red": c.A_BOLD, "yellow": c.A_BOLD, "green": 0, "cyan": 0, "blue": 0}
        if colour:
            try:
                c.use_default_colors()
                bg = -1                          # the terminal's own background: fits light and dark themes
            except c.error:
                bg = c.COLOR_BLACK
            for i, (k, fg) in enumerate((("red", c.COLOR_RED), ("green", c.COLOR_GREEN),
                                         ("yellow", c.COLOR_YELLOW), ("cyan", c.COLOR_CYAN),
                                         ("blue", c.COLOR_BLUE)), 1):
                try:
                    c.init_pair(i, fg, bg)
                    a[k] = c.color_pair(i)
                except c.error:
                    a[k] = plain[k]
        else:
            a.update(plain)
        self.attrs = a

    def attr(self, style: str) -> int:
        v = 0
        for k in style.split():
            v |= self.attrs.get(k, 0)
        return v

    def draw(self, lines: list):
        self.scr.erase()
        for y, segs in enumerate(lines):
            x = 0
            for text, style in segs:
                with contextlib.suppress(self.c.error):     # the bottom-right cell "fails" after writing
                    self.scr.addstr(y, x, text, self.attr(style))
                x += dash_cells(text)
        self.scr.refresh()

    def read_key(self):
        c = self.c
        try:
            ch = self.scr.get_wch()
        except c.error:
            return None                         # timeout: no key
        if isinstance(ch, str):
            return {"\n": "enter", "\r": "enter", "\x03": "ctrl-c", "\x1b": "esc", "\x7f": "backspace",
                    "\b": "backspace"}.get(ch, ch)
        if ch == c.KEY_MOUSE:
            try:
                _, x, y, _, bstate = c.getmouse()
            except c.error:
                return None
            if bstate & c.BUTTON4_PRESSED:
                return ("wheel", -1, x, y)
            if bstate & getattr(c, "BUTTON5_PRESSED", 0):
                return ("wheel", 1, x, y)
            if bstate & (c.BUTTON1_PRESSED | c.BUTTON1_CLICKED):
                return ("click", x, y)
            return None
        return {c.KEY_UP: "up", c.KEY_DOWN: "down", c.KEY_HOME: "home", c.KEY_END: "end", c.KEY_PPAGE: "pgup",
                c.KEY_NPAGE: "pgdn", c.KEY_ENTER: "enter", c.KEY_RESIZE: "resize", c.KEY_BACKSPACE: "backspace",
                c.KEY_LEFT: "left", c.KEY_RIGHT: "right", getattr(c, "KEY_BTAB", -2): "btab"}.get(ch)

    def run(self) -> int:
        self.setup()
        ui, next_at = dash_new_ui(tab=self.rexbin is not None), 0.0
        while True:
            res = self.coll.take()
            if res and res[0] == "ok":
                self.data = res[1]
                self.history.add(self.data)
                dashboard_rex(self.rex, self.data)
                rows = dash_sort(self.data.get("profiles") or [])
                ui = dash_set_rows({**ui, "error": ""}, [r.get("name") for r in rows],
                                   {r.get("name"): r.get("vm") for r in rows}, {r.get("name"): dash_state(r) for r in rows},
                                   {r.get("name"): r.get("mode") for r in rows})
            elif res:
                ui = {**ui, "error": f"refresh failed: {res[1]}"}
            if res:
                next_at = time.monotonic() + self.interval
            if not self.coll.running and time.monotonic() >= next_at:
                self.coll.start()
            h, w = self.scr.getmaxyx()
            ui = {**ui, "busy": self.coll.running, "size": (w, h)}
            self.draw(dash_render(self.data, ui, self.history, (w, h), ascii_=self.ascii))
            key = self.read_key()
            if key is None:
                continue
            if key == "resize":
                with contextlib.suppress(AttributeError, self.c.error):
                    self.c.update_lines_cols()
                h, w = self.scr.getmaxyx()
                ui = {**ui, "size": (w, h)}
            ui, action = dash_key(ui, key)
            if not action:
                continue
            if action[0] == "quit":
                return EXIT_OK
            if action[0] == "refresh":
                next_at = 0.0                   # starts now, unless one is already running
            elif action[0] in ("progress", "logs", "fetch", "up", "stop", "review"):
                msg = self.suspend(action)
                ui = {**ui, "msg": "; ".join(m for m in (msg, ui["msg"]) if m)}
                if action[0] in ("up", "stop", "review"):
                    next_at = 0.0               # the sandbox or the branches changed: show it now
            elif action[0] in ("up_tab", "review_tab"):
                ok, msg = self.open_tab(action)
                if ok:
                    ui = {**ui, "msg": "; ".join(m for m in (msg, ui["msg"]) if m)}
                    next_at = 0.0
                else:
                    again = "u" if action[0] == "up_tab" else "v"
                    ui = {**ui, "msg": f"{msg} - press {again} again to run it here", "up_fallback": action[1]}

    def open_tab(self, action) -> tuple[bool, str]:
        """The action's agentbox command (`up <name>`, `review <name>`) in a new tab of this Rex session (Rex
        focuses it). Returns (ok, footer message)."""
        argv = rex_run_argv(self.rexbin, dash_argv(action), keep_open=action[0] != "review_tab")
        if argv is None:
            return False, "could not open a Rex tab"
        try:
            r = subprocess.run(argv, stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=10)
        except subprocess.TimeoutExpired:
            return False, "rex run timed out after 10 s"
        except OSError as e:
            return False, f"could not run rex: {e.strerror or e}"
        if r.returncode != 0:
            why = ((r.stderr or r.stdout or "").strip().splitlines() or [""])[-1][:120]
            return False, f"rex run exited {r.returncode}" + (f": {why}" if why else "")
        return True, "opened in a new Rex tab"

    @contextlib.contextmanager
    def suspended(self):
        """Leave curses for the block (a command runs in this terminal), then take the screen back."""
        c = self.c
        c.def_prog_mode()
        c.endwin()
        # Ctrl-C belongs to the child while it runs. A Python handler (not SIG_IGN, which a child
        # would inherit) keeps it from interrupting us; exec resets it to the default in the child.
        old = signal.signal(signal.SIGINT, lambda *_: None)
        try:
            yield
        finally:
            signal.signal(signal.SIGINT, old)
            c.reset_prog_mode()
            self.scr.clear()
            with contextlib.suppress(c.error):
                c.curs_set(0)

    def suspend(self, action) -> str:
        """Leave curses, run the action's command in this terminal, come back. Returns a footer message."""
        argv = dash_argv(action)
        if argv is None:
            return ""
        msg, rc = "", 0
        env = {**os.environ, "AGENTBOX_NO_OSC": "1"}     # the dashboard keeps reporting this profile itself
        with self.suspended():
            if action[0] == "logs":
                rc, msg = self._logs(argv, env)
            else:
                print(f"\n$ {shlex.join(['agentbox', *argv])}", flush=True)
                rc = subprocess.run(agentbox_argv(argv), env=env).returncode
            if action[0] not in ("logs", "review") and rc != -signal.SIGINT:
                try:
                    input(f"\n[agentbox {argv[0]} exited {rc}; press Enter to return to the dashboard] ")
                except (EOFError, KeyboardInterrupt):
                    pass
        return msg or (f"agentbox {argv[0]} exited {rc}" if rc not in (0, -signal.SIGINT) else "")

    def _logs(self, argv: list[str], env: dict) -> tuple[int, str]:
        """`agentbox logs` (it already sanitises every line) piped into the pager; argv lists, no shell."""
        pager = dash_pager()
        logs = subprocess.Popen(agentbox_argv(argv), stdout=subprocess.PIPE, stderr=subprocess.STDOUT, env=env)
        try:
            view = subprocess.Popen(pager, stdin=logs.stdout)
        except OSError:
            logs.kill()
            logs.wait()
            return 1, f"could not start the pager {safe_text(pager[0])!r} (set $PAGER)"
        finally:
            logs.stdout.close()
        view.wait()
        if logs.poll() is None:
            logs.terminate()                    # the pager was closed before the end
        logs.wait()
        return view.returncode, ""


def dashboard_ui(collect, interval: float, rex: RexStatus) -> int:
    """`dashboard --interactive`. Rex records are written straight to stdout by dashboard_rex (they draw
    nothing) and cleared on the way out, as `--watch` does."""
    import curses
    import locale
    locale.setlocale(locale.LC_ALL, "")
    ascii_ = "utf" not in (locale.getpreferredencoding(False) or "").lower().replace("-", "")
    os.environ.setdefault("ESCDELAY", "25")
    real_err, sys.stderr = sys.stderr, io.StringIO()   # info()/die() from the worker would scribble on the screen
    try:
        return curses.wrapper(lambda scr: DashScreen(scr, curses, collect, interval, rex, ascii_).run())
    except KeyboardInterrupt:
        return EXIT_OK
    finally:
        sys.stderr = real_err
        for rid in rex.ids():                   # nothing is watched any more
            rex.clear(rid)


# ------------------------------------------------------------------- review
# `agentbox review`: a pull-request page for clone mode. The items are the review branches `fetch` made
# (refs/heads/review/<p> and review/<p>-*) and the history jobs whose branch is not fetched yet; the target is
# the branch checked out in the profile's primary workspace. Git runs on the host with argv lists, never a
# shell, never a pager or an external diff, and with -c options that pin the output format. Everything it
# prints (file names, commit messages, diffs) and everything from the job (title, summary) is agent-written:
# parsed as bytes where names are involved, and drawn only through dash_line (dash_clean). The UI only ever
# runs `agentbox fetch`, `git merge --ff-only`, `git merge --no-ff --no-edit` (after typing "merge"),
# `git merge --abort` (after a conflict), `git branch -d` (merged items only), `git difftool` for VS Code and
# an interactive shell. It never rebases, resets, forces or pushes, and never runs a project script.
REVIEW_STATUSES = {     # status: (glyph, ASCII glyph, style, label, sort group)
    "ready": ("●", "*", "green", "ready", 0),
    "not_fetched": ("↓", "v", "yellow", "not fetched", 0),
    "diverged": ("≠", "!", "yellow", "diverged", 0),
    "merged": ("✓", "+", "dim", "merged", 1),
}
REVIEW_FILE_LINES = 20000           # diff lines shown per file
REVIEW_DIFF_BYTES = 64 << 20        # most bytes of one diff read from git
REVIEW_LOG_MAX = 1000               # commits listed
REVIEW_JOBS = 50                    # newest history jobs looked at for "not fetched"
REVIEW_RENDER = ("--no-color", "--no-ext-diff", "--no-textconv")
REVIEW_IN_PROGRESS = (("MERGE_HEAD", "a merge"), ("rebase-merge", "a rebase"), ("rebase-apply", "a rebase or am"),
                      ("CHERRY_PICK_HEAD", "a cherry-pick"), ("REVERT_HEAD", "a revert"))


def review_git_argv(repo, *args) -> list[str]:
    """git with the options that keep the owner's config from changing what is parsed: no pager, C-quoted
    names in text output, a/ b/ prefixes in patches."""
    return ["git", "--no-pager", "-c", "core.quotePath=true", "-c", "diff.noprefix=false", "-C", str(repo), *args]


def rgit(repo, *args, timeout: float = 60, cap: int | None = None) -> subprocess.CompletedProcess:
    """Run git for review; stdout and stderr are bytes. Never raises: a missing git is rc 127, a timeout 124.
    `cap`: read at most that many bytes of stdout (then the process is killed)."""
    env = {k: v for k, v in os.environ.items() if k not in ("GIT_DIR", "GIT_WORK_TREE", "GIT_INDEX_FILE")}
    env |= {"LC_ALL": "C", "GIT_TERMINAL_PROMPT": "0", "GIT_OPTIONAL_LOCKS": "0", "GIT_EDITOR": "true",
            "GIT_PAGER": "cat"}
    argv = review_git_argv(repo, *args)
    try:
        if cap is None:
            return subprocess.run(argv, env=env, stdin=subprocess.DEVNULL, capture_output=True, timeout=timeout)
        with subprocess.Popen(argv, env=env, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                              stderr=subprocess.DEVNULL) as p:
            out = p.stdout.read(cap + 1)
            if len(out) > cap:
                p.kill()
            rc = p.wait(timeout=timeout)
            return subprocess.CompletedProcess(argv, 0 if len(out) > cap else rc, out, b"")
    except (OSError, ValueError):
        return subprocess.CompletedProcess(argv, 127, b"", b"git not found")
    except subprocess.TimeoutExpired:
        return subprocess.CompletedProcess(argv, 124, b"", b"git timed out")


def _rtext(r) -> str:
    return (r.stdout or b"").decode("utf-8", "replace").strip()


def _rerr(r) -> str:
    """git's last line of complaint, sanitised: for a footer or a message box."""
    lines = [ln for ln in (r.stderr or r.stdout or b"").decode("utf-8", "replace").splitlines() if ln.strip()]
    return dash_clean(lines[-1].strip()[:200]) if lines else f"exit {r.returncode}"


def _ancestor(repo, a: str, b: str) -> bool:
    return rgit(repo, "merge-base", "--is-ancestor", a, b).returncode == 0


def _rev(repo, rev: str) -> str | None:
    return _commit(_rtext(rgit(repo, "rev-parse", "-q", "--verify", "--end-of-options", rev + "^{commit}")))


def review_owner(branch: str, names) -> str | None:
    """Which profile a review branch belongs to: review/<p> or review/<p>-<ref>, the longest profile name
    that fits (review/a-b-x is a-b's, not a's)."""
    fits = [n for n in names if branch == f"review/{n}" or branch.startswith(f"review/{n}-")]
    return max(fits, key=len) if fits else None


def review_target(repo) -> tuple[str | None, str | None]:
    """(branch checked out in the workspace or None if detached, its tip or None)."""
    r = rgit(repo, "symbolic-ref", "-q", "--short", "HEAD")
    name = _rtext(r) if r.returncode == 0 else None
    return (name if name and ref_name_ok(name) else None), _rev(repo, "HEAD")


def review_status(repo, tip: str, head: str | None) -> tuple[str, int]:
    """(status, commits on the branch that the target lacks) for a review branch at `tip`."""
    if head is None:
        n = _rtext(rgit(repo, "rev-list", "--count", tip, "--"))
        return "ready", int(n) if n.isdigit() else 0
    n = _rtext(rgit(repo, "rev-list", "--count", f"{head}..{tip}", "--"))
    ahead = int(n) if n.isdigit() else 0
    if ahead == 0 or _ancestor(repo, tip, head):
        return "merged", 0
    return ("ready" if _ancestor(repo, head, tip) else "diverged"), ahead


def _epoch(v) -> float | None:
    return iso_epoch(v) if isinstance(v, str) else None


def review_profile(prof: Profile, names, states=_FETCH) -> dict:
    """One clone-mode profile's review items (newest first) and their counts. Never raises."""
    repo = prof.primary
    out = {"name": prof.name, "workspace": str(repo), "target": None, "head": None, "vm": None, "items": [],
           "counts": dict.fromkeys(REVIEW_STATUSES, 0), "error": None}
    try:
        out["vm"] = sandbox_state(prof, states) if prof.enabled else "disabled"
    except (Exception, SystemExit):
        out["vm"] = "unknown"
    if rgit(repo, "rev-parse", "--git-dir").returncode != 0:
        out["error"] = f"{repo} is not a git repository"
        return out
    target, head = review_target(repo)
    out["target"], out["head"] = target, head
    record_history(prof)
    jobs = list(reversed(read_history(prof)))               # newest first
    latest = job_record(prof).get("id")
    r = rgit(repo, "for-each-ref", "--format=%(refname)%00%(objectname)%00%(committerdate:unix)", "refs/heads/review/")
    branches = {}
    for line in (r.stdout or b"").decode("utf-8", "replace").splitlines():
        ref, _, rest = line.partition("\0")
        tip, _, when = rest.partition("\0")
        short = ref.removeprefix("refs/heads/")
        if ref.startswith("refs/heads/") and ref_name_ok(short) and _commit(tip) and review_owner(short, names) == prof.name:
            branches[short] = (tip, int(when) if when.isdigit() else None)

    def item(kind, branch, job, status, tip=None, ahead=0, when=None, ref=None):
        return {"profile": prof.name, "kind": kind, "branch": branch, "ref": ref, "status": status, "tip": tip,
                "ahead": ahead, "title": (job or {}).get("title"), "when": when, "job": job,
                "latest": bool(job) and job.get("id") == latest, "target": target, "head": head,
                "workspace": str(repo), "vm": out["vm"]}
    items = []
    for short, (tip, when) in branches.items():
        mine = [j for j in jobs if fetch_defaults(prof.name, j)["branch"] == short]
        job = next((j for j in mine if j.get("end_head") == tip), mine[0] if mine else None)
        status, ahead = review_status(repo, tip, head)
        items.append(item("branch", short, job, status, tip, ahead,
                          _epoch((job or {}).get("finished_at")) or when, (job or {}).get("branch")))
    seen = set()
    for j in jobs[:REVIEW_JOBS]:
        ref = job_branch(j.get("branch"))
        if not ref or j.get("commits") == 0:
            continue
        rb = fetch_defaults(prof.name, j)["branch"]
        if rb in seen or not ref_name_ok(rb):
            continue
        end = _commit(j.get("end_head"))
        have = end and rgit(repo, "cat-file", "-e", f"{end}^{{commit}}").returncode == 0
        if have and ((head and _ancestor(repo, end, head)) or (rb in branches and _ancestor(repo, end, branches[rb][0]))):
            continue                        # fetched (and maybe merged since)
        if not end and rb in branches:
            continue
        seen.add(rb)
        items.append(item("job", rb, j, "not_fetched", end, j.get("commits") or 0,
                          _epoch(j.get("finished_at")) or _epoch(j.get("started_at")), ref))
    items.sort(key=lambda i: (REVIEW_STATUSES[i["status"]][4], -(i["when"] or 0), i["branch"]))
    out["items"] = items
    for i in items:
        out["counts"][i["status"]] += 1
    return out


def review_collect(cfg: Config, name: str | None = None) -> dict:
    """Every clone-mode profile (or just `name`): review_profile for each, with one shared sandbox listing."""
    names = cfg.profile_names()
    profs = []
    for n in [name] if name else names:
        try:
            p = cfg.profile(n)
        except SystemExit:
            continue
        if p.d["mode"] == "clone":
            profs.append(p)
    try:
        states = sandbox_states(cfg) if profs else None     # only for `f`: is the sandbox up to fetch from
    except SystemExit:
        states = None
    return {"generated_at": int(time.time()), "profiles": [review_profile(p, names, states) for p in profs]}


def review_items(data: dict) -> list:
    """All profiles' items in one list, the actionable ones first, newest first."""
    items = [i for p in (data or {}).get("profiles") or [] for i in p.get("items") or []]
    return sorted(items, key=lambda i: (REVIEW_STATUSES[i["status"]][4], -(i["when"] or 0), i["profile"], i["branch"]))


def review_pending(counts: dict) -> int:
    """How many items still need the owner: ready or not fetched (diverged ones are reported with ready)."""
    return sum(counts.get(k, 0) for k in ("ready", "not_fetched", "diverged"))


def review_public(data: dict) -> dict:
    """`review --json`: the items and their statuses, no diff, no summary."""
    keep = ("kind", "branch", "ref", "status", "tip", "ahead", "title", "when")
    return {"generated_at": data["generated_at"], "profiles": [
        {"name": p["name"], "workspace": p["workspace"], "target": p["target"], "head": p["head"], "vm": p["vm"],
         "error": p["error"], "counts": p["counts"],
         "items": [{k: i[k] for k in keep} | {"job": (i["job"] or {}).get("id")} for i in p["items"]]}
        for p in data["profiles"]]}


# -- git output parsers (bytes in, so a hostile file name cannot break a record apart)
def _fsname(b: bytes) -> str:
    return b.decode("utf-8", "surrogateescape")


def parse_numstat_z(data: bytes) -> list[dict]:
    """`git diff --numstat -z`: "<add>\\t<del>\\t<path>\\0", or for a rename or copy
    "<add>\\t<del>\\t\\0<old>\\0<new>\\0". Binary files have "-" counts. Names may hold any byte but NUL."""
    toks = (data or b"").split(b"\0")
    out, i = [], 0
    while i < len(toks):
        tok = toks[i]
        i += 1
        if not tok.strip():
            continue
        parts = tok.split(b"\t", 2)
        if len(parts) != 3:
            continue
        a, d, path = parts
        old = None
        if path == b"":
            if i + 1 >= len(toks):
                break
            old, path = toks[i], toks[i + 1]
            i += 2
        binary = a == b"-" and d == b"-"
        out.append({"path": _fsname(path), "old": _fsname(old) if old is not None else None,
                    "add": None if binary else int(a) if a.isdigit() else 0,
                    "del": None if binary else int(d) if d.isdigit() else 0, "binary": binary})
    return out


def parse_patch(data: bytes, max_lines: int = REVIEW_FILE_LINES) -> list[dict]:
    """A unified diff (`git diff`/`git show`, -p) split per file: {"lines": [(kind, text)], "binary", "more"}.
    kind: file (a header line), hunk, add, del, ctx, note. Header names in a patch are C-quoted by git, so a
    file's section always starts at a line beginning "diff --git " (or "diff --cc "); no content line can.
    At most max_lines content lines per file are kept; "more" counts the rest."""
    files, cur, in_hunk = [], None, False
    for raw in (data or b"").split(b"\n"):
        if raw.startswith((b"diff --git ", b"diff --cc ", b"diff --combined ")):
            cur, in_hunk = {"lines": [], "binary": False, "more": 0}, False
            files.append(cur)
        if cur is None:
            continue
        text = raw.decode("utf-8", "replace").expandtabs(4)
        if raw.startswith(b"@@"):
            in_hunk, kind = True, "hunk"
        elif not in_hunk:
            kind = "file"
            if raw.startswith((b"Binary files ", b"GIT binary patch")):
                cur["binary"] = True
        elif raw.startswith(b"+"):
            kind = "add"
        elif raw.startswith(b"-"):
            kind = "del"
        elif raw.startswith(b"\\"):
            kind = "note"
        elif raw == b"":
            continue                        # the end of the output, or between files
        else:
            kind = "ctx"
        if kind in ("file",) or len(cur["lines"]) < max_lines:
            cur["lines"].append((kind, text))
        else:
            cur["more"] += 1
    return files


def parse_log_z(data: bytes) -> list[dict]:
    """`git log -z --format=%H%x1f%at%x1f%s`: one record per commit; the subject is last, so a 0x1f in it
    stays in it."""
    out = []
    for rec in (data or b"").split(b"\0"):
        rec = rec.strip(b"\n")
        h, _, rest = rec.partition(b"\x1f")
        at, _, subject = rest.partition(b"\x1f")
        h = h.decode("ascii", "replace")
        if _commit(h):
            out.append({"hash": h, "time": int(at) if at.isdigit() else None,
                        "subject": subject.decode("utf-8", "replace")})
    return out


def review_view(files: list[dict], patch: list[dict]) -> dict:
    """What the Files and diff tab draws: the numstat file list, the patch flattened into lines, where each
    file and each hunk starts."""
    lines, starts, hunks = [], [], []
    for f in patch:
        starts.append(len(lines))
        for kind, text in f["lines"]:
            if kind == "hunk":
                hunks.append(len(lines))
            lines.append((kind, text))
        if f["binary"]:
            lines.append(("note", "binary"))
        if f["more"]:
            lines.append(("note", f"({f['more']} more lines; open in VS Code)"))
    add = sum(f["add"] or 0 for f in files)
    dele = sum(f["del"] or 0 for f in files)
    return {"files": files, "lines": lines, "starts": starts, "hunks": hunks, "add": add, "del": dele}


def review_detail(item: dict) -> dict:
    """The commits and the merge-base diff (target...branch) of an item that has a branch. Never raises."""
    empty = {"commits": [], "view": review_view([], []), "error": None, "base": None}
    if item.get("kind") != "branch" or not _commit(item.get("tip")):
        return empty
    repo, tip, head = item["workspace"], item["tip"], item.get("head")
    rng = f"{head}..{tip}" if head else tip
    log = rgit(repo, "log", "--no-color", "--no-show-signature", f"--max-count={REVIEW_LOG_MAX}", "-z",
               "--format=%H%x1f%at%x1f%s", rng, "--")
    base = f"{head}...{tip}" if head else None
    if base:
        num = rgit(repo, "diff", *REVIEW_RENDER, "-M", "--numstat", "-z", base, "--")
        pat = rgit(repo, "diff", *REVIEW_RENDER, "-M", base, "--", cap=REVIEW_DIFF_BYTES)
    else:
        num = rgit(repo, "show", *REVIEW_RENDER, "-M", "--format=", "--numstat", "-z", tip, "--")
        pat = rgit(repo, "show", *REVIEW_RENDER, "-M", "--format=", "-p", tip, "--", cap=REVIEW_DIFF_BYTES)
    err = next((f"git failed: {_rerr(r)}" for r in (log, num, pat) if r.returncode != 0), None)
    return {"commits": parse_log_z(log.stdout), "view": review_view(parse_numstat_z(num.stdout), parse_patch(pat.stdout)),
            "error": err, "base": base}


def review_commit_view(item: dict, commit: str) -> dict:
    """The diff of one commit (against its first parent), in review_view's shape."""
    if not _commit(commit):
        return review_view([], [])
    repo = item["workspace"]
    flags = (*REVIEW_RENDER, "-M", "--diff-merges=first-parent", "--format=")
    num = rgit(repo, "show", *flags, "--numstat", "-z", commit, "--")
    pat = rgit(repo, "show", *flags, "-p", commit, "--", cap=REVIEW_DIFF_BYTES)
    return review_view(parse_numstat_z(num.stdout), parse_patch(pat.stdout))


# -- the actions that change something
def review_merge_argv(branch: str, ff: bool) -> list[str] | None:
    """The only two merges review runs (git's arguments, after review_git_argv's)."""
    if not ref_name_ok(branch):
        return None
    return ["merge", "--ff-only", "--", branch] if ff else ["merge", "--no-ff", "--no-edit", "--", branch]


def review_delete_argv(branch: str) -> list[str] | None:
    """Lower-case -d: git itself refuses a branch that is not merged."""
    return ["branch", "-d", "--", branch] if ref_name_ok(branch) else None


def review_in_progress(repo) -> str | None:
    """"a merge" etc. if one is in progress in the workspace, else None."""
    for name, what in REVIEW_IN_PROGRESS:
        r = rgit(repo, "rev-parse", "--git-path", name)
        p = Path(repo) / os.fsdecode(r.stdout.strip()) if r.returncode == 0 and r.stdout.strip() else None
        if p is not None and p.exists():
            return what
    return None


def review_merge_check(item: dict) -> dict:
    """May the item be merged into its target now? {"ok", "reason", "ff", "count", "argv"}. Looks again at
    the workspace, the target and the branch: the list may be older than what is on disk."""
    no = lambda why: {"ok": False, "reason": why, "ff": False, "count": 0, "argv": None}
    branch, repo = item.get("branch"), item.get("workspace")
    if item.get("kind") != "branch" or item.get("status") not in ("ready", "diverged"):
        return no(f"nothing to merge: {REVIEW_STATUSES.get(item.get('status'), ('',) * 4)[3] or 'unknown'}")
    if not ref_name_ok(branch) or not repo:
        return no("not a valid review branch")
    target, head = review_target(repo)
    if target is None:
        return no(f"{repo} is on a detached HEAD: check out the branch to merge into first")
    if head is None:
        return no(f"{target} has no commits yet")
    if target != item.get("target") or head != item.get("head"):
        return no(f"the workspace is now on {target} at {head[:12]}: refresh (r) and look again")
    tip = _rev(repo, f"refs/heads/{branch}")
    if tip is None or tip != item.get("tip"):
        return no(f"{branch} has moved since the list was read: refresh (r) and look again")
    busy = review_in_progress(repo)
    if busy:
        return no(f"{busy} is in progress in {repo}: finish or abort it first")
    st = rgit(repo, "status", "--porcelain=v1", "-z", "--untracked-files=no")
    if st.returncode != 0:
        return no(f"git status failed: {_rerr(st)}")
    if st.stdout.strip(b"\0"):
        n = len([x for x in st.stdout.split(b"\0") if x[:2].strip()])
        return no(f"{repo} has uncommitted changes to tracked files ({n}): commit or stash them first")
    n = _rtext(rgit(repo, "rev-list", "--count", f"{head}..{tip}", "--"))
    count = int(n) if n.isdigit() else 0
    if count == 0:
        return no(f"{branch} is already in {target}")
    ff = _ancestor(repo, head, tip)
    return {"ok": True, "reason": "", "ff": ff, "count": count, "argv": review_merge_argv(branch, ff)}


def review_merge(item: dict, ff: bool) -> dict:
    """Merge the item into the target: `merge --ff-only` (ff) or `merge --no-ff --no-edit`, after checking
    again. A conflicted merge is aborted at once (`merge --abort`). {"ok", "msg", "lines"}."""
    chk = review_merge_check(item)
    if not chk["ok"]:
        return {"ok": False, "msg": chk["reason"], "lines": []}
    if chk["ff"] != ff:
        return {"ok": False, "msg": "the branch or the target changed: refresh (r) and look again", "lines": []}
    repo = item["workspace"]
    r = rgit(repo, *chk["argv"], timeout=300)
    if r.returncode == 0:
        tip = _rev(repo, "HEAD") or "?"
        subj = _rtext(rgit(repo, "log", "--no-color", "--no-show-signature", "-1", "--format=%s", tip, "--"))
        return {"ok": True, "msg": f"merged; t opens a shell to run install/tests",
                "lines": [f"{item['target']} is now at {tip[:12]}", subj]}
    if not ff and review_in_progress(repo) == "a merge":
        un = rgit(repo, "diff", "--name-only", "-z", "--diff-filter=U")
        files = [_fsname(x) for x in un.stdout.split(b"\0") if x]
        ab_ = rgit(repo, "merge", "--abort")
        lines = ["conflicts in:"] + [f"  {f}" for f in files[:30]] + ([f"  ... {len(files) - 30} more"] if len(files) > 30 else [])
        lines.append("the merge was aborted (git merge --abort)" if ab_.returncode == 0
                     else f"git merge --abort failed: {_rerr(ab_)}; run it yourself")
        return {"ok": False, "msg": f"merge conflict in {len(files)} file(s): aborted", "lines": lines}
    return {"ok": False, "msg": f"git merge failed: {_rerr(r)}", "lines": []}


def review_delete(item: dict) -> dict:
    """`git branch -d` for a merged item, after checking it is still merged into the target."""
    branch, repo = item.get("branch"), item.get("workspace")
    argv = review_delete_argv(branch) if item.get("kind") == "branch" and item.get("status") == "merged" else None
    if argv is None:
        return {"ok": False, "msg": "only merged review branches are deleted"}
    tip, head = _rev(repo, f"refs/heads/{branch}"), _rev(repo, "HEAD")
    if not tip or not head or not _ancestor(repo, tip, head):
        return {"ok": False, "msg": f"{branch} is no longer merged into the checked-out branch: refresh (r)"}
    r = rgit(repo, *argv)
    return {"ok": r.returncode == 0, "msg": f"deleted {branch}" if r.returncode == 0 else f"git branch -d failed: {_rerr(r)}"}


def review_fetch_argv(item: dict) -> list[str] | None:
    """agentbox's arguments for `f`: `fetch <p>` for the profile's latest job (fetch picks its branch itself),
    else the job's branch and review branch spelled out."""
    p, ref, rb = item.get("profile"), job_branch(item.get("ref")), item.get("branch")
    if item.get("status") != "not_fetched" or not isinstance(p, str) or not NAME_RE.match(p) or not ref \
            or not ref_name_ok(rb):
        return None
    return ["fetch", p] if item.get("latest") else ["fetch", p, "--ref", ref, "--branch", rb]


def review_code_argv(code: str, item: dict) -> list[str] | None:
    """VS Code on the item's diff, one file at a time: `git difftool` with `code --wait --diff` on temporary
    copies (outside the repo; git removes them). None if there is no branch to show."""
    if item.get("kind") != "branch" or not _commit(item.get("tip")) or not _commit(item.get("head")) or not code:
        return None
    return review_git_argv(item["workspace"], "difftool", "--no-prompt", "--no-symlinks",
                           f"--extcmd={shlex.quote(code)} --wait --diff", f"{item['head']}...{item['tip']}", "--")


def login_shell() -> str:
    try:
        import pwd
        sh = pwd.getpwuid(os.getuid()).pw_shell
    except (ImportError, KeyError, OSError):
        sh = ""
    return sh if _executable(sh) else (os.environ.get("SHELL") if _executable(os.environ.get("SHELL")) else "/bin/sh")


def rex_shell_argv(rex: str, workspace: str, profile: str, shell: str) -> list[str] | None:
    """`t` inside Rex: an interactive shell in a new tab, in the profile's primary workspace."""
    if not rex or not NAME_RE.match(profile or "") or not os.path.isabs(workspace or "") or not _executable(shell):
        return None
    return [rex, "run", "--shell=none", "--cwd", workspace, "--label", f"{profile} shell", "--", shell, "-i"]


def review_title(item: dict | None, profile: str | None = None) -> str:
    """The terminal title (OSC 2) while reviewing: "review: <profile>/<branch>", or "review: <profile>"."""
    if item:
        text = f"review: {item.get('profile')}/{item.get('branch')}"
    else:
        text = f"review: {profile}" if profile else "review"
    text = dash_clean(text)[:120]
    return "".join(ch for ch in text if unicodedata.category(ch)[0] != "C")


def osc_title(text: str) -> str:
    return "\x1b]2;" + "".join(ch for ch in text if unicodedata.category(ch)[0] != "C") + "\x1b\\"


TITLE_PUSH, TITLE_POP = "\x1b[22;0t", "\x1b[23;0t"      # xterm's title stack: save, restore


def review_rex_fields(n: int) -> dict | None:
    """The `review` record: idle with how many items wait for the owner; None (clear it) when none do.
    Never blocked, done or error: Rex would notify about a screen that is just open."""
    return {"state": "idle", "msg": f"{n} to review"} if n > 0 else None


def review_rex(rex: RexStatus, n: int):
    fields = review_rex_fields(n)
    if fields:
        rex.report(fields, "review")
    else:
        rex.clear("review")


def dash_review_note(counts: dict | None, commits: int | None) -> str:
    """The dashboard's line for a profile with something to review."""
    if not counts:
        return ""
    ready, nf = counts.get("ready", 0) + counts.get("diverged", 0), counts.get("not_fetched", 0)
    if not ready and not nf:
        return ""
    parts = []
    if commits:
        parts.append(f"{commits} commit{'s' if commits != 1 else ''} ready to review")
    elif ready:
        parts.append(f"{ready} branch{'es' if ready != 1 else ''} ready to review")
    if nf:
        parts.append(f"{nf} not fetched")
    return " · ".join(parts) + "  (v reviews)"


def review_summary(cfg: Config, prof: Profile, states=_FETCH) -> dict | None:
    """For the dashboard: {"counts", "commits"} of a clone-mode profile, or None. Never raises."""
    if prof.d["mode"] != "clone":
        return None
    try:
        p = review_profile(prof, cfg.profile_names(), states)
    except (Exception, SystemExit):
        return None
    if p["error"]:
        return None
    commits = sum(i["ahead"] or 0 for i in p["items"] if i["status"] in ("ready", "diverged", "not_fetched"))
    return {"counts": p["counts"], "commits": commits}


# -- the full-screen UI. Plain functions over plain data (the items, a UI-state dict, the loaded diff), as for
# the dashboard: review_key turns a key into a new state and maybe an action, review_render draws lines of
# (text, style) segments. Only ReviewScreen touches curses, git and subprocesses.
REVIEW_MIN_W, REVIEW_MIN_H, REVIEW_WIDE, REVIEW_FILES_SIDE = 60, 15, 100, 120
REVIEW_TABS = ("Overview", "Commits", "Files and diff")
REVIEW_STYLE = {"file": "bold", "hunk": "cyan", "add": "green", "del": "red", "ctx": "", "note": "dim"}
REVIEW_TYPED_MAX = 64
REVIEW_HELP = [("↑ ↓  j k", "select an item, or scroll the tab (← → or a click: list / tab)"),
               ("Tab  1 2 3", "Overview, Commits, Files and diff"),
               ("PgUp PgDn", "page; Home End: first / last"), ("Enter", "on a commit: its diff in the Files tab"),
               ("a", "back to the whole diff"), ("n  N", "next / previous file"), ("]  [", "next / previous hunk"),
               ("/", "search the diff (Enter on an empty search repeats it)"), ("w", "wrap long lines"),
               ("f", "fetch a job's branch: agentbox fetch (asks first)"),
               ("m", "merge into the target (asks first; never rebases, resets, forces or pushes)"),
               ("d", "delete a merged review branch: git branch -d (asks first)"),
               ("o", "the diff in VS Code (git difftool, one file at a time)"),
               ("t", "a shell in the workspace, to run your install or tests"),
               ("r", "refresh"), ("?", "this help"), ("q  Ctrl-C", "quit")]


def review_key_of(item: dict | None):
    return None if not item else (item.get("profile"), item.get("kind"), item.get("branch"), (item.get("job") or {}).get("id"))


def review_new_ui(size=(80, 24), tab: bool = False) -> dict:
    """The UI state. `items` the list, `sel`/`top` its selection and scroll, `tab` 0-2, `focus` list | pane,
    per-item scrolls (`otop` overview, `csel`/`ctop` commits, `ftop` file list, `dtop` diff), `source` None (the
    target...branch diff) or a commit id, `mode` list | help | box | fetch | nofetch | merge | mergetyped |
    delete | search, `target` the item a question is about, `check` its review_merge_check, `typed` text typed
    so far, `query` the last search. `tab_ok`: `t` opens a Rex tab."""
    return {"items": [], "sel": 0, "top": 0, "size": tuple(size), "tab": 0, "focus": "list", "otop": 0, "csel": 0,
            "ctop": 0, "ftop": 0, "dtop": 0, "source": None, "wrap": False, "mode": "list", "target": None,
            "check": None, "typed": "", "query": "", "msg": "", "box": None, "busy": False, "error": "",
            "tab_ok": tab}


def review_layout(width: int, height: int, n: int) -> dict | None:
    """Rects (x, y, w, h) for the item list and the pane; None if too small. Row 0 header, last row footer."""
    if width < REVIEW_MIN_W or height < REVIEW_MIN_H:
        return None
    body = height - 2
    if width >= REVIEW_WIDE:
        lw = max(30, min(48, width // 3))
        return {"stacked": False, "list": (0, 1, lw, body), "pane": (lw + 1, 1, width - lw - 1, body)}
    lh = max(4, min(2 * max(n, 1), body // 3))
    return {"stacked": True, "list": (0, 1, width, lh), "pane": (0, lh + 2, width, body - lh - 1)}


def review_rects(rv: dict, nfiles: int) -> dict | None:
    """review_layout plus the pane's parts: the tab bar, the content and, for the diff tab, the file list
    and the diff."""
    lay = review_layout(*rv["size"], len(rv["items"]))
    if lay is None:
        return None
    px, py, pw, ph = lay["pane"]
    cx, cy, cw, ch = px, py + 1, pw, ph - 1
    if cw >= REVIEW_FILES_SIDE:
        fw = min(44, cw // 3)
        files, diff, side = (cx, cy, fw, ch), (cx + fw + 1, cy, cw - fw - 1, ch), True
    else:
        fh = max(1, min(max(nfiles, 1), max(3, ch // 4)))
        files, diff, side = (cx, cy, cw, fh), (cx, cy + fh + 1, cw, max(1, ch - fh - 1)), False
    return lay | {"tabs": (px, py, pw, 1), "content": (cx, cy, cw, ch), "files": files, "diff": diff, "side": side}


def review_tab_labels(counts: tuple | None = None) -> list[str]:
    """The tab bar's labels; counts = (commits, files) once the item's detail is loaded."""
    extra = ("", f" ({counts[0]})", f" ({counts[1]})") if counts else ("", "", "")
    return [f" {i + 1} {name}{extra[i]} " for i, name in enumerate(REVIEW_TABS)]


def review_tab_spans(labels: list[str]) -> list:
    """(x0, x1) of each label in the tab bar, relative to the pane: one space before the first, one between."""
    spans, x = [], 1
    for lb in labels:
        spans.append((x, x + len(lb)))
        x += len(lb) + 1
    return spans


def review_set_items(rv: dict, items: list) -> dict:
    """New data: keep the same item selected if it is still listed."""
    old = review_key_of(rv["items"][rv["sel"]]) if rv["items"] else None
    keys = [review_key_of(i) for i in items]
    if old in keys:
        sel = keys.index(old)
        return _rv_follow({**rv, "items": list(items), "sel": sel}, sel, keep=True)
    return _rv_follow({**rv, "items": list(items)}, min(rv["sel"], max(0, len(items) - 1)))


def _rv_item_reset(rv: dict) -> dict:
    return {**rv, "otop": 0, "csel": 0, "ctop": 0, "ftop": 0, "dtop": 0, "source": None}


def _rv_follow(rv: dict, sel: int, keep: bool = False) -> dict:
    """Select item `sel` and scroll the list to it (two rows per item). A new item starts at the top of
    every tab."""
    n = len(rv["items"])
    sel = max(0, min(sel, n - 1)) if n else 0
    lay = review_layout(*rv["size"], n)
    top = rv["top"]
    if lay:
        vis = max(1, lay["list"][3] // 2)
        top = min(top, sel) if sel < top else max(top, sel - vis + 1)
        top = max(0, min(top, max(0, n - vis)))
    out = {**rv, "sel": sel, "top": top}
    return out if keep or sel == rv["sel"] else _rv_item_reset(out)


def _cur_file(starts: list, dtop: int) -> int:
    i = 0
    for k, s in enumerate(starts):
        if s <= dtop:
            i = k
    return i


def _rv_diff_to(rv: dict, dtop: int, view: dict, rects) -> dict:
    """Scroll the diff to line dtop and keep the file it is in visible in the file list."""
    lines = len(view.get("lines") or [])
    dh = rects["diff"][3] if rects else 10
    dtop = max(0, min(dtop, max(0, lines - 1)))
    rv = {**rv, "dtop": dtop}
    if rects and view.get("starts"):
        cur, fh = _cur_file(view["starts"], dtop), max(1, rects["files"][3])
        ftop = rv["ftop"]
        ftop = cur if cur < ftop else (cur - fh + 1 if cur >= ftop + fh else ftop)
        rv["ftop"] = max(0, ftop)
    return rv if lines > dh or dtop <= max(0, lines - dh) else {**rv, "dtop": max(0, lines - dh)}


def review_search(lines: list, query: str, start: int, back: bool = False) -> int | None:
    """Index of the next line (after `start`, wrapping) whose text contains query, case-insensitively."""
    q = query.lower()
    n = len(lines)
    if not q or not n:
        return None
    order = [(start - k) % n for k in range(1, n + 1)] if back else [(start + k) % n for k in range(1, n + 1)]
    return next((i for i in order if q in dash_clean(lines[i][1]).lower()), None)


def review_merge_prompt(rv: dict, item: dict, chk: dict) -> dict:
    """After `m`: the y/N question for a fast-forward, the typed one for a merge commit, or the refusal."""
    if not chk.get("ok"):
        return {**rv, "mode": "box", "box": ("merge refused", [chk.get("reason") or "refused"]), "msg": "merge refused"}
    return {**rv, "mode": "merge" if chk["ff"] else "mergetyped", "target": item, "check": chk, "typed": ""}


def _rv_typed(rv: dict, key) -> tuple[dict, str | None]:
    """Typing into a question: (new state, "enter" | "cancel" | None)."""
    typed = rv.get("typed", "")
    if key == "enter":
        return rv, "enter"
    if key in ("esc", "ctrl-c"):
        return rv, "cancel"
    if key == "backspace":
        return {**rv, "typed": typed[:-1]}, None
    if isinstance(key, str) and len(key) == 1 and unicodedata.category(key)[0] != "C" and len(typed) < REVIEW_TYPED_MAX:
        return {**rv, "typed": typed + key}, None
    return rv, None


def review_key(rv: dict, key, ctx: dict | None = None) -> tuple[dict, tuple | None]:
    """(UI state, key, what is loaded) -> (new state, action or None). ctx: {"commits": [...], "view": the diff
    shown}. Keys as for dash_key, plus "left", "right", "tab", "btab". Actions: ("quit",), ("refresh",),
    ("redraw",), ("merge_check", item) (the loop checks the workspace, then calls review_merge_prompt),
    ("code", item), ("shell", item), and only after a question was answered: ("fetch", item) after y,
    ("merge", item, True) after y to a fast-forward, ("merge", item, False) after typing "merge" for a merge
    commit, ("delete", item) after y to a merged item."""
    ctx = ctx or {}
    view = ctx.get("view") or {}
    commits = ctx.get("commits") or []
    rv = {**rv, "msg": ""}
    items, mode = rv["items"], rv["mode"]
    n = len(items)
    item = items[rv["sel"]] if n else None
    if key == "resize":
        return _rv_follow(rv, rv["sel"], keep=True), ("redraw",)
    if mode in ("fetch", "merge", "delete"):
        target, done = rv["target"], {**rv, "mode": "list", "target": None, "check": None}
        if key in ("y", "Y") and target:
            return done, {"fetch": ("fetch", target), "merge": ("merge", target, True), "delete": ("delete", target)}[mode]
        return {**done, "msg": f"{mode} cancelled"}, None
    if mode == "mergetyped":
        rv, how = _rv_typed(rv, key)
        done = {**rv, "mode": "list", "target": None, "check": None, "typed": ""}
        if how == "enter":
            if rv["typed"] == "merge" and rv["target"]:
                return done, ("merge", rv["target"], False)
            return {**done, "msg": "merge cancelled: type merge to make a merge commit"}, None
        if how == "cancel":
            return {**done, "msg": "merge cancelled"}, None
        return rv, None
    rects = review_rects(rv, len(view.get("files") or []))
    if mode == "search":
        rv, how = _rv_typed(rv, key)
        if how == "cancel":
            return {**rv, "mode": "list", "typed": ""}, None
        if how != "enter":
            return rv, None
        q = rv["typed"] or rv["query"]
        rv = {**rv, "mode": "list", "typed": "", "query": q}
        hit = review_search(view.get("lines") or [], q, rv["dtop"])
        if hit is None:
            return {**rv, "msg": f"not found: {q}" if q else ""}, None
        return {**_rv_diff_to(rv, hit, view, rects), "msg": f"/{q}"}, None
    if mode in ("help", "box", "nofetch"):
        return {**rv, "mode": "list", "target": None, "box": None}, ("quit",) if key in ("q", "ctrl-c") else None
    if key in ("q", "Q", "ctrl-c"):
        return rv, ("quit",)
    if key == "r":
        return rv, ("refresh",)
    if key == "?":
        return {**rv, "mode": "help"}, None
    if key in ("tab", "btab"):
        return {**rv, "tab": (rv["tab"] + (1 if key == "tab" else -1)) % 3, "focus": "pane"}, None
    if key in ("1", "2", "3"):
        return {**rv, "tab": int(key) - 1, "focus": "pane"}, None
    if key in ("left", "h", "esc"):
        return {**rv, "focus": "list"}, None
    if key in ("right", "l"):
        return {**rv, "focus": "pane"}, None
    if key == "w":
        return {**rv, "wrap": not rv["wrap"], "msg": "wrap on" if not rv["wrap"] else "wrap off"}, None
    if isinstance(key, tuple):
        return _rv_mouse(rv, key, rects, view, commits, ctx.get("detail"))
    moves = {"up": -1, "k": -1, "down": 1, "j": 1}
    lay_list = rects["list"][3] // 2 if rects else 1
    if rv["focus"] == "list" or not item:
        page = {"pgup": -lay_list, "pgdn": lay_list}
        if key in moves or key in page:
            return _rv_follow(rv, rv["sel"] + {**moves, **page}[key]), None
        if key in ("home", "g"):
            return _rv_follow(rv, 0), None
        if key in ("end", "G"):
            return _rv_follow(rv, n - 1), None
        if key == "enter" and item:
            return {**rv, "focus": "pane"}, None
    else:
        ch = rects["content"][3] if rects else 10
        if rv["tab"] == 0:
            step = {**moves, "pgup": -ch, "pgdn": ch, "home": -10 ** 9, "g": -10 ** 9, "end": 10 ** 9, "G": 10 ** 9}
            if key in step:
                return {**rv, "otop": max(0, rv["otop"] + step[key])}, None
        elif rv["tab"] == 1:
            step = {**moves, "pgup": -ch, "pgdn": ch, "home": -10 ** 9, "g": -10 ** 9, "end": 10 ** 9, "G": 10 ** 9}
            if key in step:
                csel = max(0, min(rv["csel"] + step[key], len(commits) - 1))
                ctop = min(rv["ctop"], csel) if csel < rv["ctop"] else max(rv["ctop"], csel - ch + 1)
                return {**rv, "csel": csel, "ctop": max(0, ctop)}, None
            if key == "enter" and commits:
                c = commits[max(0, min(rv["csel"], len(commits) - 1))]
                return {**rv, "tab": 2, "source": c["hash"], "dtop": 0, "ftop": 0,
                        "msg": f"commit {c['hash'][:9]}: a shows the whole diff again"}, None
        else:
            dh = rects["diff"][3] if rects else 10
            step = {**moves, "pgup": -dh, "pgdn": dh, "home": -10 ** 9, "g": -10 ** 9, "end": 10 ** 9, "G": 10 ** 9}
            if key in step:
                return _rv_diff_to(rv, rv["dtop"] + step[key], view, rects), None
    if key in ("n", "N", "]", "["):
        if rv["tab"] != 2:
            return {**rv, "tab": 2, "focus": "pane"}, None
        starts, hunks, d = view.get("starts") or [], view.get("hunks") or [], rv["dtop"]
        if key == "n":
            nxt = next((s for s in starts if s > d), None)
        elif key == "N":
            nxt = next((s for s in reversed(starts) if s < d), None)
        elif key == "]":
            nxt = next((s for s in hunks if s > d), None)
        else:
            nxt = next((s for s in reversed(hunks) if s < d), None)
        if nxt is None:
            return {**rv, "msg": "no more files" if key in "nN" else "no more hunks"}, None
        return _rv_diff_to({**rv, "focus": "pane"}, nxt, view, rects), None
    if key == "/":
        return {**rv, "tab": 2, "focus": "pane", "mode": "search", "typed": ""}, None
    if key == "a":
        return ({**rv, "source": None, "dtop": 0, "ftop": 0, "msg": "the whole diff"}, None) if rv["source"] else (rv, None)
    if item is None:
        return rv, None
    st = item.get("status")
    if key == "f":
        if st != "not_fetched":
            return {**rv, "msg": "f fetches items that are not fetched yet"}, None
        if review_fetch_argv(item) is None:
            return {**rv, "msg": "this job's branch cannot be fetched from here"}, None
        if item.get("vm") in ("stopped", "missing"):
            return {**rv, "mode": "nofetch", "target": item}, None
        return {**rv, "mode": "fetch", "target": item}, None
    if key == "m":
        if st not in ("ready", "diverged"):
            return {**rv, "msg": f"nothing to merge: this item is {REVIEW_STATUSES[st][3]}"}, None
        return rv, ("merge_check", item)
    if key == "d":
        if st != "merged":
            return {**rv, "msg": "d deletes merged review branches only"}, None
        return {**rv, "mode": "delete", "target": item}, None
    if key == "o":
        if item.get("kind") != "branch":
            return {**rv, "msg": "fetch it first (f): there is no branch to open yet"}, None
        return rv, ("code", item)
    if key == "t":
        return rv, ("shell", item)
    return rv, None


def _rv_mouse(rv: dict, key, rects, view: dict, commits: list, ctx_detail=None) -> tuple[dict, tuple | None]:
    if not rects:
        return rv, None
    kind, *rest = key
    n = len(rv["items"])
    if kind == "click":
        x, y = rest
        lx, ly, lw, lh = rects["list"]
        if _inside(rects["list"], x, y):
            i = rv["top"] + (y - ly) // 2
            return (_rv_follow({**rv, "focus": "list"}, i), None) if i < n else ({**rv, "focus": "list"}, None)
        if _inside(rects["tabs"], x, y):
            counts = (len(commits), len(view.get("files") or [])) if ctx_detail else None
            for i, (a, b) in enumerate(review_tab_spans(review_tab_labels(counts))):
                if a <= x - rects["tabs"][0] < b:
                    return {**rv, "tab": i, "focus": "pane"}, None
            return rv, None
        if rv["tab"] == 2 and _inside(rects["files"], x, y):
            i = rv["ftop"] + y - rects["files"][1]
            starts = view.get("starts") or []
            if i < len(starts):
                return _rv_diff_to({**rv, "focus": "pane"}, starts[i], view, rects) | {"ftop": rv["ftop"]}, None
            return {**rv, "focus": "pane"}, None
        if rv["tab"] == 1 and _inside(rects["content"], x, y):
            i = rv["ctop"] + y - rects["content"][1]
            return ({**rv, "csel": i, "focus": "pane"} if i < len(commits) else {**rv, "focus": "pane"}), None
        if _inside(rects["pane"], x, y):
            return {**rv, "focus": "pane"}, None
        return rv, None
    if kind == "wheel":
        step, x, y = rest
        if _inside(rects["list"], x, y):
            vis = max(1, rects["list"][3] // 2)
            return {**rv, "top": max(0, min(rv["top"] + step, max(0, n - vis)))}, None
        if rv["tab"] == 2 and _inside(rects["files"], x, y):
            nf = len(view.get("files") or [])
            return {**rv, "ftop": max(0, min(rv["ftop"] + step, max(0, nf - rects["files"][3])))}, None
        if rv["tab"] == 2 and _inside(rects["pane"], x, y):
            return {**rv, "dtop": max(0, min(rv["dtop"] + 3 * step, max(0, len(view.get("lines") or []) - rects["diff"][3])))}, None
        if rv["tab"] == 1 and _inside(rects["pane"], x, y):
            ch = rects["content"][3]
            return {**rv, "ctop": max(0, min(rv["ctop"] + 3 * step, max(0, len(commits) - ch)))}, None
        if _inside(rects["pane"], x, y):
            return {**rv, "otop": max(0, rv["otop"] + 3 * step)}, None
    return rv, None


def _review_when(t, now: float) -> str:
    if not isinstance(t, (int, float)):
        return ""
    age = max(0, now - t)
    return f"{fmt_dur(age)} ago" if age < 86400 else time.strftime("%b %d", time.localtime(t))


def review_list(rv: dict, w: int, h: int, now: float, ascii_: bool) -> list:
    out = []
    items = rv["items"]
    for i in range(rv["top"], min(len(items), rv["top"] + h // 2)):
        it = items[i]
        g, ga, style, label, _ = REVIEW_STATUSES[it["status"]]
        sel = "sel" if i == rv["sel"] else ""
        if sel and rv["focus"] != "list":
            sel = "sel dim"
        right = f" {label} "
        nw = max(1, w - 4 - len(right))
        name, used = _clip(dash_clean(f"{it['profile']}/{it['branch']}"), nw)
        out.append(dash_line([(" ", sel), (ga if ascii_ else g, f"{style} {sel}".strip()), (" ", sel),
                              (name, f"bold {sel}".strip()), (" " * (nw - used + 1), sel),
                              (right, f"{style} {sel}".strip())], w, ascii_))
        when = _review_when(it.get("when"), now)
        title = dash_clean(it.get("title") or ("(no job recorded)" if not it.get("job") else "(no title)"))
        tw = max(1, w - 4 - len(when) - 1)
        t, used = _clip(title, tw)
        out.append(dash_line([("   ", sel), (t, f"dim {sel}".strip()), (" " * (tw - used + 1), sel),
                              (when, f"dim {sel}".strip())], w, ascii_))
    return out


def _fmt_cost(v) -> str:
    return f"${v:.2f}" if isinstance(v, (int, float)) and not isinstance(v, bool) else "-"


def _wrap_cells(text: str, width: int) -> list[str]:
    """Clean text, wrapped at words to `width` cells (a word wider than that is cut into pieces)."""
    out = []
    for para in ("" if text is None else str(text)).split("\n"):
        line = dash_clean(para)
        if not line.strip():
            out.append("")
            continue
        words, cur = line.split(" "), ""
        for wd in words:
            cand = f"{cur} {wd}" if cur else wd
            if dash_cells(cand) <= width:
                cur = cand
                continue
            if cur:
                out.append(cur)
            while dash_cells(wd) > width:
                part, _ = _clip(wd, width)
                out.append(part)
                wd = wd[len(part):]
            cur = wd
        out.append(cur)
    return out


def review_overview(item: dict, detail: dict | None, w: int, now: float, ascii_: bool = False) -> list:
    """Unclipped segment lists for the Overview tab."""
    job = item.get("job") or {}
    g, _, style, label, _ = REVIEW_STATUSES[item["status"]]
    L = [[(item.get("title") or ("(no job recorded for this branch)" if not job else "(no title)"), "bold")],
         [(label, style), ("   ", ""), (f"{item['profile']}/{item['branch']}", "")]]
    if job:
        start, end = _epoch(job.get("started_at")), _epoch(job.get("finished_at"))
        dur = fmt_dur(end - start, True) if start and end and end >= start else "-"
        code = job.get("exit_code")
        L += [[], [("job       ", "dim"), (job.get("id") or "-", "")],
              [("started   ", "dim"), (_dash_clock(job.get("started_at"), now), ""), ("   duration ", "dim"), (dur, ""),
               ("   exit ", "dim"), (str(code) if isinstance(code, int) else job.get("state") or "-",
                                       "red" if isinstance(code, int) and code else "")],
              [("cost      ", "dim"), (_fmt_cost(job.get("cost_usd")), ""), ("   turns ", "dim"), (_dash_count(job.get("turns")), ""),
               ("   tool calls ", "dim"), (_dash_count(job.get("tool_calls")), ""),
               ("   denials ", "dim"), (_dash_count(job.get("denials")), "yellow" if job.get("denials") else "")]]
    L.append([("branch    ", "dim"), (item.get("branch") or "-", "bold")]
             + ([("  from ", "dim"), (item["ref"], "")] if item.get("ref") else [])
             + ([("  tip ", "dim"), (item["tip"][:12], "")] if _commit(item.get("tip")) else []))
    L.append([("target    ", "dim"), (item.get("target") or "(detached HEAD)", "bold")]
             + ([("  at ", "dim"), (item["head"][:12], "")] if _commit(item.get("head")) else [])
             + [("  in ", "dim"), (item.get("workspace") or "", "dim")])
    L.append([])
    if item["kind"] == "branch" and detail:
        v = detail["view"]
        nc, nf = len(detail["commits"]), len(v["files"])
        L.append([(f"{nc}{'+' if nc >= REVIEW_LOG_MAX else ''} commit{'s' if nc != 1 else ''}, "
                   f"{nf} file{'s' if nf != 1 else ''} changed, ", "bold"),
                  (f"+{v['add']}", "green"), (" ", ""), (f"{'-' if ascii_ else '−'}{v['del']}", "red")])
        if detail.get("error"):
            L.append([(detail["error"], "red")])
    elif item["kind"] == "job":
        n = job.get("commits")
        L.append([(f"{n} commit{'s' if n != 1 else ''} in the job; " if isinstance(n, int) else "", "bold"),
                  ("not fetched yet: f runs agentbox fetch", "yellow")])
    if item["status"] == "diverged":
        L.append([("the target has moved on: a fast-forward is not possible (m offers a merge commit)", "yellow")])
    L += [[], [("the agent's own summary, not verified", "dim")]]
    summary = job.get("summary")
    if summary:
        L += [[(ln, "")] for ln in _wrap_cells(summary, max(10, w))]
    else:
        L.append([("(no summary recorded)", "dim")])
    return L


def review_commit_lines(commits: list, rv: dict, w: int, h: int, focus: bool, now: float) -> list:
    out = []
    if not commits:
        return [dash_line([(" no commits", "dim")], w)]
    for i in range(rv["ctop"], min(len(commits), rv["ctop"] + h)):
        c = commits[i]
        sel = ("sel" if focus else "sel dim") if i == rv["csel"] else ""
        when = time.strftime("%Y-%m-%d %H:%M", time.localtime(c["time"])) if c.get("time") else ""
        sw = max(1, w - 12 - len(when) - 1)
        s, used = _clip(dash_clean(c["subject"]), sw)
        out.append(dash_line([(" ", sel), (c["hash"][:9], f"yellow {sel}".strip()), ("  ", sel), (s, sel),
                              (" " * (sw - used), sel), (when + " ", f"dim {sel}".strip())], w))
    return out


def _review_hit(text: str, query: str, style: str) -> list:
    """Segments of text with each occurrence of query (case-insensitive) reversed."""
    out, low, q, i = [], text.lower(), query.lower(), 0
    if not q or len(low) != len(text):          # lower() changed the length (e.g. "İ"): no highlight
        return [(text, style)]
    while True:
        j = low.find(q, i)
        if j < 0:
            out.append((text[i:], style))
            return [s for s in out if s[0]]
        out += [(text[i:j], style), (text[j:j + len(q)], f"{style} sel".strip())]
        i = j + len(q)


def review_diff_lines(view: dict, rv: dict, w: int, h: int, ascii_: bool) -> list:
    lines = view.get("lines") or []
    if not lines:
        return [dash_line([(" no changes", "dim")], w)]
    out, i = [], rv["dtop"]
    q = rv.get("query") or ""
    while len(out) < h and i < len(lines):
        kind, text = lines[i]
        text = dash_clean(text)
        style = REVIEW_STYLE.get(kind, "")
        if rv["wrap"]:
            rest = text
            while len(out) < h:
                part, _ = _clip(rest, w)
                part = part or rest[:1]
                out.append(dash_line(_review_hit(part, q, style), w, ascii_))
                rest = rest[len(part):]
                if not rest:
                    break
        else:
            out.append(dash_line(_review_hit(text, q, style), w, ascii_))
        i += 1
    return out


def review_file_lines(view: dict, rv: dict, w: int, h: int, ascii_: bool) -> list:
    files = view.get("files") or []
    if not files:
        return [dash_line([(" no files changed", "dim")], w)]
    cur = _cur_file(view.get("starts") or [0], rv["dtop"])
    out = []
    for i in range(rv["ftop"], min(len(files), rv["ftop"] + h)):
        f = files[i]
        sel = "bold" if i == cur else ""
        mark = (">" if ascii_ else "▸") if i == cur else " "
        name = f"{f['old']} -> {f['path']}" if f.get("old") else f["path"]
        cnt = [("  binary ", "dim")] if f["binary"] else [(f"{'+' + str(f['add']):>6}", "green"), (f" {'-' + str(f['del']):<6} ", "red")]
        out.append(dash_line([(mark, sel)] + cnt + [(name, sel)], w, ascii_))
    return out


def review_fetch_text(item: dict) -> list:
    argv = review_fetch_argv(item) or []
    vm = item.get("vm")
    if vm in ("stopped", "missing"):
        return [[(f"The sandbox for {item['profile']} is {vm}. Fetch needs it running:", "")],
                [("sbx drops the sandbox's git remote when it stops.", "")],
                [("`agentbox up` starts it again; booting it from here is not offered,", "dim")],
                [("since that relaunches the agent last started with `sbx run`.", "dim")], [],
                [("any key closes this", "dim")]]
    return [[("This runs:", "")], [("  " + shlex.join(["agentbox", *argv]), "bold")], [],
            [("  fetches  ", "dim"), (item.get("ref") or "?", "bold"), (f"  (the branch job {(item.get('job') or {}).get('id') or '?'} ended on)", "dim")],
            [("  into     ", "dim"), (item.get("branch") or "?", "bold")], [],
            [("y", "bold"), (" to run it, any other key cancels", "")]]


def review_merge_text(item: dict, chk: dict, typed: str | None = None) -> list:
    cmd = shlex.join(["git", *(chk.get("argv") or [])])
    n, target, br = chk.get("count", 0), item.get("target") or "?", item.get("branch") or "?"
    body = [[("This runs, in ", ""), (item.get("workspace") or "?", "dim"), (":", "")], [("  " + cmd, "bold")], []]
    if typed is None:
        return body + [[(f"  fast-forwards {target} by {n} commit{'s' if n != 1 else ''} from {br}", "")], [],
                       [("y", "bold"), (" to run it, any other key cancels", "")]]
    return body + [[(f"{target} has moved on, so {br} cannot be fast-forwarded.", "yellow bold")],
                   [(f"  makes a merge commit on {target} with {n} commit{'s' if n != 1 else ''} from {br};", "")],
                   [("  on a conflict, git merge --abort runs at once and nothing changes.", "")], [],
                   [("Type merge, then Enter, to run it. Esc cancels.", "")], [("  > ", "bold"), (typed, "bold"), ("_", "")]]


def review_delete_text(item: dict) -> list:
    return [[("This runs, in ", ""), (item.get("workspace") or "?", "dim"), (":", "")],
            [("  " + shlex.join(["git", *(review_delete_argv(item.get("branch")) or [])]), "bold")], [],
            [(f"  {item.get('branch')} is merged into {item.get('target')}; -d refuses an unmerged branch", "dim")], [],
            [("y", "bold"), (" to run it, any other key cancels", "")]]


def review_render(rv: dict, ctx: dict | None, size, now: float | None = None, ascii_: bool = False) -> list:
    """The whole screen: size[1] lines of segments, each exactly size[0] cells wide. ctx: {"detail": the
    selected item's review_detail or None, "view": the diff shown, "data": the collection, "loading": bool}."""
    w, h = size
    if w <= 0 or h <= 0:
        return []
    ctx = ctx or {}
    now = time.time() if now is None else now
    rv = {**rv, "size": (w, h)}
    view = ctx.get("view") or review_view([], [])
    detail = ctx.get("detail")
    rects = review_rects(rv, len(view["files"]))
    if rects is None:
        msg = f"make the pane bigger: at least {REVIEW_MIN_W}x{REVIEW_MIN_H} (now {w}x{h})"
        lines = [dash_line([], w) for _ in range(h)]
        lines[h // 2] = dash_line([(" " * max(0, (w - len(msg)) // 2), ""), (msg, "yellow")], w, ascii_)
        return lines
    items = rv["items"]
    item = items[rv["sel"]] if items else None
    head = [(" agentbox review", "bold")]
    if item:
        head += [("   target ", "dim"), (item.get("target") or "(detached HEAD)", "bold"),
                 (f"   {item['profile']}: {item.get('workspace')}", "dim")]
    pending = sum(1 for i in items if i["status"] in ("ready", "not_fetched", "diverged"))
    if ctx.get("data") is not None:
        head.append((f"   {pending} to review", "yellow" if pending else "dim"))
    if rv.get("busy"):
        head.append(("   refreshing..." if ascii_ else "   refreshing…", "cyan"))
    if rv.get("error"):
        head.append((f"   {rv['error']}", "red bold"))
    lx, ly, lw, lh = rects["list"]
    px, py, pw, ph = rects["pane"]
    if items:
        left = review_list(rv, lw, lh, now, ascii_)
    else:
        errs = [p for p in (ctx.get("data") or {}).get("profiles") or [] if p.get("error")]
        left = [dash_line([(" collecting…" if ctx.get("data") is None else " nothing to review", "dim")], lw, ascii_)]
        if ctx.get("data") is not None and not (ctx["data"].get("profiles")):
            left.append(dash_line([(" (no clone-mode profiles)", "dim")], lw, ascii_))
        left += [dash_line([(f" {p['name']}: {p['error']}", "red")], lw, ascii_) for p in errs]
    left += [dash_line([], lw)] * (lh - len(left))
    # the pane
    focus = rv["focus"] == "pane"
    tabs = [(" ", "")]
    for i, lb in enumerate(review_tab_labels((len(detail["commits"]), len(view["files"])) if detail else None)):
        tabs += [(lb, ("sel" if focus else "bold") if i == rv["tab"] else "dim"), (" ", "")]
    cx, cy, cw, ch = rects["content"]
    if not item:
        content = []
    elif rv["tab"] == 0:
        ov = review_overview(item, detail, cw - 2, now, ascii_)
        otop = max(0, min(rv["otop"], max(0, len(ov) - ch)))
        content = [dash_line([(" ", "")] + seg, cw, ascii_) for seg in ov[otop:otop + ch]]
    elif rv["tab"] == 1:
        if item["kind"] != "branch":
            content = [dash_line([(" not fetched yet: f fetches the job's branch", "dim")], cw, ascii_)]
        else:
            content = review_commit_lines((detail or {}).get("commits") or [], rv, cw, ch, focus, now)
    else:
        if item["kind"] != "branch":
            content = [dash_line([(" not fetched yet: f fetches the job's branch", "dim")], cw, ascii_)]
        else:
            fx, fy, fw, fh = rects["files"]
            dx, dy, dw, dh = rects["diff"]
            fl = review_file_lines(view, rv, fw, fh, ascii_)
            fl += [dash_line([], fw)] * (fh - len(fl))
            dl = review_diff_lines(view, rv, dw, dh, ascii_)
            dl += [dash_line([], dw)] * (dh - len(dl))
            rule, bar_ = ("-", "|") if ascii_ else ("─", "│")
            if rects["side"]:
                content = [fl[i] + [(bar_, "dim")] + dl[i] for i in range(ch)]
            else:
                src = f" commit {rv['source'][:9]} (a: whole diff) " if rv.get("source") else \
                    f" {item.get('target') or 'HEAD'}...{item['branch']} "
                src = _clip(dash_clean(src), max(0, cw - 2))[0]
                content = fl + [dash_line([(rule * 2 + src + rule * max(0, cw - 2 - dash_cells(src)), "dim")], cw, ascii_)] + dl
    content += [dash_line([], cw)] * (ch - len(content))
    right = [dash_line(tabs, pw, ascii_)] + content[:ch]
    if rects["stacked"]:
        rule = "-" if ascii_ else "─"
        n = len(items)
        vis = max(1, lh // 2)
        span = f" {rv['top'] + 1}-{min(n, rv['top'] + vis)} of {n} " if n > vis else ""
        body = left + [dash_line([(rule * 2 + span + rule * max(0, w - 2 - len(span)), "dim")], w, ascii_)] + right
    else:
        bar_ = "|" if ascii_ else "│"
        body = [left[i] + [(bar_, "dim")] + right[i] for i in range(h - 2)]
    # overlays
    box = None
    mode, tgt = rv.get("mode"), rv.get("target")
    if mode == "help":
        help_ = [("Up Dn  j k", d) if ascii_ and i == 0 else (k, d) for i, (k, d) in enumerate(REVIEW_HELP)]
        kw = max(dash_cells(k) for k, _ in help_)
        box = _dash_box("keys", [[(f"{k:<{kw}}  ", "bold"), (d, "")] for k, d in help_]
                        + [[], [("review never runs your install or tests: t opens a shell for them", "dim")],
                           [("any key closes this", "dim")]], w, ascii_)
    elif mode in ("fetch", "nofetch") and tgt:
        box = _dash_box("fetch", review_fetch_text(tgt), w, ascii_)
    elif mode in ("merge", "mergetyped") and tgt and rv.get("check"):
        box = _dash_box("merge", review_merge_text(tgt, rv["check"], rv.get("typed", "") if mode == "mergetyped" else None),
                        w, ascii_)
    elif mode == "delete" and tgt:
        box = _dash_box("delete", review_delete_text(tgt), w, ascii_)
    elif mode == "box" and rv.get("box"):
        title, blines = rv["box"]
        box = _dash_box(title, [[(ln, "")] for ln in blines] + [[], [("any key closes this", "dim")]], w, ascii_)
    if box:
        top = max(0, (len(body) - len(box)) // 2)
        bw = sum(dash_cells(t) for t, _ in box[0])
        for i, ln in enumerate(box[:len(body)]):
            body[top + i] = dash_line([(" " * max(0, (w - bw) // 2), "")] + ln, w, ascii_)
    # footer
    if rv.get("msg"):
        foot = [(" " + rv["msg"], "yellow")]
    elif mode in ("fetch", "merge", "delete"):
        foot = [(" y", "bold"), (f" {mode}   ", ""), ("any other key", "bold"), (" cancel", "")]
    elif mode == "mergetyped":
        foot = [(" type merge, ", ""), ("Enter", "bold"), (" merge   ", ""), ("Esc", "bold"), (" cancel", "")]
    elif mode == "search":
        foot = [(" /", "bold"), (rv.get("typed", ""), ""), ("_", ""), ("   Enter", "bold"), (" find   ", "dim"),
                ("Esc", "bold"), (" cancel", "dim")]
    elif mode in ("help", "box", "nofetch"):
        foot = [(" any key", "bold"), (" close", "")]
    else:
        st = item["status"] if item else None
        keys = [("j/k" if ascii_ else "↑↓", "select" if rv["focus"] == "list" else "scroll"), ("Tab", "tabs")]
        keys += {"not_fetched": [("f", "fetch")], "ready": [("m", "merge")], "diverged": [("m", "merge")],
                 "merged": [("d", "delete")]}.get(st, [])
        if rv["tab"] == 2:
            keys += [("n/N", "file"), ("]/[", "hunk"), ("/", "search"), ("w", "wrap")]
        keys += [("o", "VS Code"), ("t", "shell"), ("r", "refresh"), ("?", "help"), ("q", "quit")]
        foot = [s for k, d in keys for s in ((f" {k}", "bold"), (f" {d}  ", "dim"))]
    return [dash_line(head, w, ascii_)] + body + [dash_line(foot, w, ascii_)]


class ReviewScreen(DashScreen):
    """The curses side of `agentbox review`: draw review_render's lines, turn input into review_key's keys,
    load what the selected item shows, run the actions."""

    def __init__(self, scr, curses, collect, rex: RexStatus, ascii_: bool, profile: str | None,
                 interval: float = 30.0, out=None):
        super().__init__(scr, curses, collect, interval, rex, ascii_)
        self.profile, self.cache, self.title, self.out = profile, {}, None, out or sys.stdout

    def set_title(self, item):
        text = review_title(item, self.profile)
        if text != self.title:
            self.title = text
            with contextlib.suppress(OSError, ValueError):
                self.out.write(osc_title(text))
                self.out.flush()

    def loaded(self, rv: dict) -> dict:
        """ctx for review_key and review_render: the selected item's detail and the diff on show."""
        item = rv["items"][rv["sel"]] if rv["items"] else None
        if not item or item["kind"] != "branch":
            return {"detail": None, "view": review_view([], []), "commits": [], "data": self.data}
        key = review_key_of(item) + (item.get("tip"), item.get("head"))
        if key not in self.cache:
            if len(self.cache) > 16:
                self.cache.clear()
            self.cache[key] = review_detail(item)
        detail = self.cache[key]
        view = detail["view"]
        if rv.get("source"):
            ck = key + (rv["source"],)
            if ck not in self.cache:
                self.cache[ck] = review_commit_view(item, rv["source"])
            view = self.cache[ck]
        return {"detail": detail, "view": view, "commits": detail["commits"], "data": self.data}

    def read_key(self):
        key = super().read_key()
        return {"\t": "tab"}.get(key, key) if isinstance(key, str) else key

    def run(self) -> int:
        self.setup()
        rv, next_at = review_new_ui(tab=self.rexbin is not None), 0.0
        while True:
            res = self.coll.take()
            if res and res[0] == "ok":
                self.data = res[1]
                self.cache.clear()
                items = review_items(self.data)
                rv = review_set_items({**rv, "error": ""}, items)
                review_rex(self.rex, sum(1 for i in items if i["status"] in ("ready", "not_fetched", "diverged")))
            elif res:
                rv = {**rv, "error": f"refresh failed: {res[1]}"}
            if res:
                next_at = time.monotonic() + self.interval
            if not self.coll.running and time.monotonic() >= next_at:
                self.coll.start()
            h, w = self.scr.getmaxyx()
            rv = {**rv, "busy": self.coll.running, "size": (w, h)}
            ctx = self.loaded(rv)
            self.set_title(rv["items"][rv["sel"]] if rv["items"] else None)
            self.draw(review_render(rv, ctx, (w, h), ascii_=self.ascii))
            key = self.read_key()
            if key is None:
                continue
            if key == "resize":
                with contextlib.suppress(AttributeError, self.c.error):
                    self.c.update_lines_cols()
                h, w = self.scr.getmaxyx()
                rv = {**rv, "size": (w, h)}
            rv, action = review_key(rv, key, ctx)
            if not action:
                continue
            kind, item = action[0], (action[1] if len(action) > 1 else None)
            if kind == "quit":
                return EXIT_OK
            if kind == "refresh":
                next_at = 0.0
            elif kind == "merge_check":
                rv = review_merge_prompt(rv, item, review_merge_check(item))
            elif kind == "merge":
                res_ = review_merge(item, action[2])
                rv = {**rv, "msg": res_["msg"]}
                if res_["lines"]:
                    rv |= {"mode": "box", "box": ("merged" if res_["ok"] else "merge", res_["lines"])}
                next_at = 0.0
            elif kind == "delete":
                rv = {**rv, "msg": review_delete(item)["msg"]}
                next_at = 0.0
            elif kind == "fetch":
                rv = {**rv, "msg": self.run_fetch(item)}
                next_at = 0.0
            elif kind == "code":
                rv = {**rv, "msg": self.open_code(item)}
            elif kind == "shell":
                rv = {**rv, "msg": self.open_shell(item)}

    def run_fetch(self, item: dict) -> str:
        argv = review_fetch_argv(item)
        if argv is None:
            return ""
        with self.suspended():
            print(f"\n$ {shlex.join(['agentbox', *argv])}", flush=True)
            rc = subprocess.run(agentbox_argv(argv), env={**os.environ, "AGENTBOX_NO_OSC": "1"}).returncode
            if rc != -signal.SIGINT:
                with contextlib.suppress(EOFError, KeyboardInterrupt):
                    input(f"\n[agentbox fetch exited {rc}; press Enter to return to the review] ")
        return "fetched" if rc == 0 else f"agentbox fetch exited {rc}"

    def open_code(self, item: dict) -> str:
        code = shutil.which("code")
        if not code:
            return "VS Code's `code` is not on PATH: not opened (install it from VS Code's command palette)"
        argv = review_code_argv(code, item)
        if argv is None:
            return "nothing to open"
        env = {**os.environ, "LC_ALL": "C", "GIT_TERMINAL_PROMPT": "0", "GIT_OPTIONAL_LOCKS": "0"}
        try:
            subprocess.Popen(argv, env=env, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL, start_new_session=True)
        except OSError as e:
            return f"could not run git difftool: {e.strerror or e}"
        return "opening the diff in VS Code, one file at a time: close a file's tab for the next"

    def open_shell(self, item: dict) -> str:
        ws, name = item.get("workspace"), item.get("profile")
        if not ws or not os.path.isdir(ws):
            return "the workspace is not there"
        if self.rexbin:
            argv = rex_shell_argv(self.rexbin, ws, name, login_shell())
            if argv is None:
                return "could not open a shell tab"
            try:
                r = subprocess.run(argv, stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=10)
            except (OSError, subprocess.TimeoutExpired) as e:
                return f"could not run rex: {e}"
            return "opened a shell in a new Rex tab" if r.returncode == 0 else f"rex run exited {r.returncode}"
        shell = os.environ.get("SHELL") if _executable(os.environ.get("SHELL")) else login_shell()
        with self.suspended():
            print(f"\n{ws}: a shell for your install or tests; exit it to return to the review", flush=True)
            subprocess.run([shell, "-i"], cwd=ws)
        return "back from the shell"


def review_ui(collect, rex: RexStatus, profile: str | None) -> int:
    """`agentbox review`. Saves the terminal title, sets it while running, restores it on the way out, and
    clears the `review` Rex record."""
    import curses
    import locale
    locale.setlocale(locale.LC_ALL, "")
    ascii_ = "utf" not in (locale.getpreferredencoding(False) or "").lower().replace("-", "")
    os.environ.setdefault("ESCDELAY", "25")
    real_err, sys.stderr = sys.stderr, io.StringIO()
    sys.stdout.write(TITLE_PUSH)
    sys.stdout.flush()
    try:
        return curses.wrapper(lambda scr: ReviewScreen(scr, curses, collect, rex, ascii_, profile).run())
    except KeyboardInterrupt:
        return EXIT_OK
    finally:
        sys.stderr = real_err
        rex.clear("review")
        sys.stdout.write(TITLE_POP)
        sys.stdout.flush()


def cmd_review(cfg: Config, name: str | None, as_json: bool = False) -> int:
    if name:
        prof = cfg.profile(name)
        if prof.d["mode"] != "clone":
            die(f"profile '{name}' is in direct mode: the agent edits {prof.primary} itself, so there is no branch"
                f" to review. See `agentbox audit {name}`", EXIT_USAGE)
    if as_json:
        emit_json(review_public(review_collect(cfg, name)))
        return EXIT_OK
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        die("review needs a terminal; `agentbox review --json` lists the items otherwise", EXIT_USAGE)
    return review_ui(lambda: review_collect(cfg, name), RexStatus(rex_wanted()), name)


def describe_tool(t: dict) -> dict:
    return {"description": t.get("description", ""),
            "params": t.get("params", {}),
            "extra_args": bool(t.get("extra_args")),
            "timeout": int(t.get("timeout", 60))}


def cmd_tools(prof: Profile, as_json: bool = False) -> int:
    cfg = prof.cfg
    if not as_json:
        print(tool_summary(cfg, prof.tool_names) or "(no host tools)")
        return EXIT_OK
    tools = []
    for n in prof.tool_names:
        if n not in cfg.tools:
            die(f"profile '{prof.name}' references unknown tool '{n}'", EXIT_USAGE)
        t = cfg.tools[n]
        tools.append({"name": n, **describe_tool(t),
                      "confirm": bool(t.get("confirm", prof.d.get("confirm_host_tools", False)))})
    emit_json({"profile": prof.name, "tools": tools})
    return EXIT_OK


# Value prefixes of real credentials. The VM classifies each token-like variable itself
# (see TOKEN_PROBE), so a value never leaves it: only name, class and length come back.
REAL_TOKEN_PREFIXES = ("ghp_", "gho_", "ghu_", "ghs_", "ghr_", "github_pat_", "sk-ant-", "sk-",
                       "xoxa-", "xoxb-", "xoxp-", "AKIA", "glpat-")
TOKEN_PROBE = (
    "env | while IFS== read -r n v; do "
    "case \"$n\" in *[Kk][Ee][Yy]*|*[Tt][Oo][Kk][Ee][Nn]*|*[Ss][Ee][Cc][Rr][Ee][Tt]*|*[Pp][Aa][Ss][Ss][Ww]*) ;; "
    "*) continue;; esac; "
    "[ \"$n\" = HOSTTOOLS_TOKEN ] && continue; "
    "case \"$v\" in " + "|".join(f"{p}*" for p in REAL_TOKEN_PREFIXES) + ") c=real;; *) c=placeholder;; esac; "
    "echo \"TOKENVAR $n $c ${#v}\"; done")
TOKEN_HINT = ("check `sbx secret ls` for a global secret, the profile's `env`, and the sbx agent template;"
              " a placeholder is expected for proxy-injected credentials")


def classify_token_value(value: str) -> str:
    """Host-side twin of TOKEN_PROBE's classifier (the probe runs in the VM)."""
    return "real" if value.startswith(REAL_TOKEN_PREFIXES) else "placeholder"


def parse_token_vars(out: str) -> list[tuple[str, str, int]]:
    """TOKEN_PROBE output -> [(name, "real"|"placeholder", length)]; malformed lines are dropped."""
    found = []
    for line in out.splitlines():
        m = re.fullmatch(r"TOKENVAR ([A-Za-z_][A-Za-z0-9_]*) (real|placeholder) (\d+)", line.strip())
        if m:
            found.append((m.group(1), m.group(2), int(m.group(3))))
    return found


# ssh-add output meaning "nothing answered": the socket sbx always creates has no agent behind it.
SSH_ADD_NO_AGENT = ("could not open a connection", "communication with agent failed",
                    "error connecting", "no such file", "not found", "ssh-add-missing")


def classify_ssh_add(rc: int, out: str) -> str:
    """Classify `ssh-add -l` run inside the sandbox: "none" (no agent answers, good),
    "agent" (a live agent is reachable, bad) or "unknown". Output is never echoed:
    it may hold key fingerprints."""
    low = out.lower()
    if rc == 0:
        return "agent"                  # keys were listed
    if "the agent has no identities" in low:
        return "agent"                  # a live agent, just empty
    if any(m in low for m in SSH_ADD_NO_AGENT):
        return "none"
    return "unknown"


class Report:
    """doctor results: printed as human text as they arrive, or collected for --json."""

    def __init__(self, as_json: bool):
        self.as_json, self.ok, self.items, self.scope = as_json, True, [], None

    def say(self, text: str = ""):
        if not self.as_json:
            print(safe_text(text))

    def add(self, status: str, msg: str, hint: str = "", details=(), data=None):
        item = {"profile": self.scope, "status": status, "message": msg}
        if hint:
            item["hint"] = hint
        if details:
            item["details"] = list(details)
        if data:
            item["data"] = data
        self.items.append(item)

    def chk(self, cond, msg, hint="") -> bool:
        self.ok &= bool(cond)
        self.add("pass" if cond else "fail", msg, "" if cond else hint)
        self.say(("  ok   " if cond else "  FAIL ") + msg + ("" if cond else f"\n         -> {hint}"))
        return bool(cond)

    def note(self, kind: str, msg: str, hint: str = "", details=(), data=None):
        """kind: info | warn. Never fails the run."""
        self.add(kind, msg, hint, details, data)
        self.say(f"  {kind} {msg}" + "".join(f"\n         {d}" for d in details)
                 + (f"\n         -> {hint}" if hint else ""))

    def skip(self, msg: str):
        self.add("skip", msg)

    def result(self) -> dict:
        return {"ok": self.ok, "checks": self.items}


# ------------------------------------------------------------ local models (host side)
OLLAMA_CONTEXT_HINT = ("Ollama's context length is a server setting: set OLLAMA_CONTEXT_LENGTH=32768 (or more) in the"
                       " environment of `ollama serve` (the Mac app: Settings > Context length), or `PARAMETER num_ctx"
                       " 32768` in a Modelfile. Prompts past it are cut silently, and an agent's system prompt and tool"
                       " definitions alone take thousands of tokens. Match local_model.context to it.")


def ollama_api(port: int, path: str, body: dict | None = None, timeout: float = 3.0):
    """JSON from Ollama's native API on the host's 127.0.0.1 (never through a proxy). Raises OSError or
    ValueError. The answers are the model server's, so treat them as data."""
    req = urllib.request.Request(f"http://127.0.0.1:{int(port)}{path}",
                                 data=json.dumps(body).encode() if body is not None else None,
                                 headers={"Content-Type": "application/json"} if body is not None else {})
    opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
    with opener.open(req, timeout=timeout) as r:
        return json.loads(r.read(4 << 20))


def ollama_tag_names(tags) -> list[str]:
    models = tags.get("models") if isinstance(tags, dict) else None
    return [m["name"] for m in models if isinstance(m, dict) and isinstance(m.get("name"), str)] \
        if isinstance(models, list) else []


def ollama_has_model(names: list[str], model: str) -> bool:
    return model in names or (":" not in model.rsplit("/", 1)[-1] and f"{model}:latest" in names)


def ollama_capabilities(show) -> list[str]:
    caps = show.get("capabilities") if isinstance(show, dict) else None
    return [c for c in caps if isinstance(c, str)] if isinstance(caps, list) else []


def ollama_context(show, ps, model: str) -> tuple[int | None, int | None]:
    """(the model's own maximum context, the context Ollama really gives it or None if unknown).
    The real one is in /api/ps while the model is loaded, or in the model's num_ctx parameter."""
    info_ = show.get("model_info") if isinstance(show, dict) else None
    native = next((v for k, v in info_.items() if k.endswith(".context_length") and _count(v)), None) \
        if isinstance(info_, dict) else None
    real = None
    for m in (ps.get("models") if isinstance(ps, dict) and isinstance(ps.get("models"), list) else []):
        if isinstance(m, dict) and m.get("name") in (model, f"{model}:latest") and _count(m.get("context_length")):
            real = m["context_length"]
    params = show.get("parameters") if isinstance(show, dict) else None
    if real is None and isinstance(params, str):
        hit = re.search(r"(?m)^\s*num_ctx\s+(\d{1,9})\s*$", params)
        real = int(hit.group(1)) if hit else None
    return native, real


def ollama_tool_models(port: int) -> list[str] | None:
    """The host's Ollama models (what `ollama list` shows) that report the `tools` capability; None if
    Ollama does not answer."""
    try:
        names = ollama_tag_names(ollama_api(port, "/api/tags"))
    except (OSError, ValueError):
        return None
    out = []
    for n in names[:50]:
        try:
            if "tools" in ollama_capabilities(ollama_api(port, "/api/show", {"model": n})):
                out.append(n)
        except (OSError, ValueError):
            continue
    return out


def doctor_local_model(rep: "Report", prof: Profile):
    """From the host: is the model server up, does it have the model, can the model call tools, and is
    the context long enough for an agent."""
    lm = prof.local_model
    port, model = lm["port"], lm["model"]
    rep.note("info", f"local model {model} via {lm['provider']} on host port {port}: the sandbox may reach"
                     f" localhost:{port} on this machine (and nothing else on it, unless host_tools are set)")
    try:
        tags = ollama_api(port, "/api/tags")
    except (OSError, ValueError) as e:
        rep.chk(False, f"Ollama answers on 127.0.0.1:{port}",
                f"start Ollama (the app, or `ollama serve`); if it listens elsewhere, fix local_model.port ({e})")
        return
    rep.chk(True, f"Ollama answers on 127.0.0.1:{port}")
    names = ollama_tag_names(tags)
    if not rep.chk(ollama_has_model(names, model), f"Ollama has {model}",
                   f"`ollama pull {model}` (it has: {_capped(names, 10) or 'no models'})"):
        return
    try:
        show = ollama_api(port, "/api/show", {"model": model})
    except (OSError, ValueError) as e:
        rep.chk(False, f"Ollama describes {model}", f"`ollama show {model}` ({e})")
        return
    caps = ollama_capabilities(show)
    rep.chk("tools" in caps, f"{model} supports tool calls",
            f"opencode needs a model with the `tools` capability (it reports: {', '.join(caps) or 'none'});"
            " `agentbox provision` lists the ones you have")
    try:
        ps = ollama_api(port, "/api/ps")
    except (OSError, ValueError):
        ps = None
    native, real = ollama_context(show, ps, model)
    if native is not None and native < LOCAL_MODEL_MIN_CONTEXT:
        rep.note("warn", f"{model} has a context window of {native} tokens, under {LOCAL_MODEL_MIN_CONTEXT}:"
                         " too small for agent work", "pick a model with a longer context")
    if real is None:
        rep.note("info", f"could not see the context length Ollama gives {model} (it shows once the model is loaded)",
                 OLLAMA_CONTEXT_HINT)
    elif real < LOCAL_MODEL_MIN_CONTEXT:
        rep.note("warn", f"Ollama runs {model} with a {real}-token context, under {LOCAL_MODEL_MIN_CONTEXT}",
                 OLLAMA_CONTEXT_HINT)
    elif real < lm["context"]:
        rep.note("warn", f"Ollama runs {model} with a {real}-token context, but local_model.context is"
                         f" {lm['context']}: opencode will overfill it", OLLAMA_CONTEXT_HINT)
    else:
        rep.note("info", f"Ollama runs {model} with a {real}-token context")


def cmd_doctor(cfg: Config, name: str | None, as_json: bool = False, start: bool = False) -> int:
    rep = Report(as_json)
    chk = rep.chk

    rep.say("host")
    v = sbx(cfg, "version", check=False, capture=True)
    chk(v.returncode == 0, f"sbx present: {(v.stdout or '').strip().splitlines()[0] if v.stdout else '?'}",
        "brew trust docker/tap && brew install docker/tap/sbx && sbx login")
    rep.note("info", f"config: {CONFIG_FILE}")
    if cfg.settings["forward_ssh_agent"]:
        rep.note("warn", "forward_ssh_agent = true: the agent can use your SSH keys (push, ssh to servers)")
    names = [name] if name else cfg.profile_names()
    for n in names:
        rep.scope = n
        merged = cfg.merged(n)
        problems = [(p, "fix local_model in agentbox.toml (README: \"Local models with opencode\")")
                    for p in local_model_problems(cfg, merged)]
        problems += [(p, "fix permission_mode in agentbox.toml (README: \"Permission mode\")")
                     for p in permission_mode_problems(cfg, n, merged)]
        if problems:
            rep.say(f"\nprofile {n}")
            for problem, hint in problems:
                chk(False, problem, hint)
            continue
        prof = cfg.profile(n)
        if not prof.enabled:
            rep.say(f"\nprofile {n} ({prof.sandbox}): skipped (disabled)")
            rep.skip("skipped (disabled)")
            continue
        rep.say(f"\nprofile {n} ({prof.sandbox})")
        if prof.permission_mode == "bypass":
            rep.note("warn", "permission_mode = \"bypass\": Claude runs with --dangerously-skip-permissions, so the"
                     " sandbox is the only boundary", "remove it to use Claude Code's auto mode as a second layer")
        elif prof.permission_mode:
            rep.note("info", "permission_mode: auto (Claude Code's auto mode, inside the sandbox)")
        for r in prof.roots:
            chk(r.exists(), f"workspace {r}", "fix the path in agentbox.toml")
            chk(not is_within(CONFIG_FILE.resolve(), r), "config is outside the workspace",
                "move agentbox.toml out of the workspace")
            if (r / ".git").exists():
                # read config with Python only - never run git against an agent-writable repo
                findings = risky_git_config(r)
                if findings:
                    rep.note("warn", f"{r}: git config entries that can run commands (check them before using git on the host):",
                             details=findings)
                rep.note("info", f"{r}: hooks in .git/hooks run on the host when you commit; a global"
                         " core.hooksPath helps, but a repo-level core.hooksPath overrides it - `agentbox audit` flags that")
        for ss in prof.skillsets:
            state, drift = skill_drift(prof, ss)
            where = (f"{ss.path} - {len(ss.skills)} skill(s): {_capped(ss.skills)}; ref {ss.ref or 'none'}; "
                     + (f"HEAD {ss.commit} on {ss.branch or 'a detached HEAD'}" if ss.commit else "not a git repo")
                     + f"; drift: {state}")
            rep.note("info", f"skill set {ss.name}: {where}",
                     data={"set": ss.name, "path": str(ss.path), "ref": ss.ref, "commit": ss.commit,
                           "branch": ss.branch, "skills": ss.skills, "drift": state})
            for w in drift:
                rep.note("warn", w, "if you did not mean to change it: check the old commit/branch out again;"
                         " pin it with `ref`")
            for problem in ss.problems:
                chk(False, f"skill set {ss.name}: {problem}", "fix the folder or [skillsets.%s] in agentbox.toml" % ss.name)
        for problem in prof.skill_problems():
            if problem.startswith("skill '"):
                chk(False, problem, "rename or remove one of them in the skill sets")
        if prof.skillsets and not prof.skill_problems():
            chk(True, "skill sets pass the safety rules: " + ", ".join(ss.name for ss in prof.skillsets))
        # `sbx kit validate` does not take v3 source kits; `kit inspect` loads (and, for a kit with a
        # recipe, builds) one and fails on a bad descriptor. Declaration-only mixins need no builder.
        for k in prof.kit_paths():
            rv = sbx(cfg, "kit", "inspect", str(k), check=False, capture=True)
            chk(rv.returncode == 0, f"kit {k.name} loads", (rv.stderr or rv.stdout or "").strip()[:400])
        kit_dir, _ = render_local_kit(prof, get_token(prof))
        rv = sbx(cfg, "kit", "inspect", kit_dir, check=False, capture=True)
        chk(rv.returncode == 0, "generated kit loads", (rv.stderr or rv.stdout or "").strip()[:400])
        if prof.local_model:
            doctor_local_model(rep, prof)
        if prof.tool_names:
            try:
                Bridge(prof)
                chk(True, f"host tools preflight: {', '.join(prof.tool_names)}")
            except SystemExit:
                chk(False, "host tools preflight", "see message above")
        vm = sandbox_state(prof) if sandbox_exists(prof) else "missing"
        if vm == "missing":
            rep.say("  (sandbox not created yet - in-sandbox checks skipped)")
            rep.skip("sandbox not created yet - in-sandbox checks skipped")
        elif vm != "running" and not (start and vm == "stopped"):
            # `sbx exec` would boot it; a diagnostic shouldn't change what it inspects
            why = "sandbox stopped" if vm == "stopped" else "sandbox state unknown"
            rep.say(f"  (in-sandbox checks skipped ({why}){'; --start boots it' if vm == 'stopped' else ''})")
            rep.skip(f"skipped ({why})")
        else:
            probe = (TOKEN_PROBE + "; "
                     "command -v hosttool >/dev/null && hosttool ping || echo hosttool=absent")
            r = sbx(cfg, "exec", prof.sandbox, "sh", "-c", probe, check=False, capture=True)
            out = r.stdout or ""
            lines = [ln for ln in out.strip().splitlines() if not ln.startswith("TOKENVAR ")]
            rep.say("  inside sandbox:\n    " + "\n    ".join(lines))
            for ln in lines:
                rep.add("info", f"inside sandbox: {ln}")
            for tname, cls, length in parse_token_vars(out):
                data = {"name": tname, "class": cls, "length": length}
                if cls == "real":
                    rep.note("warn", f"{tname}: looks like a real credential ({length} chars)", TOKEN_HINT, data=data)
                else:
                    rep.note("info", f"{tname}: placeholder/unknown ({length} chars)", data=data)
            if not cfg.settings["forward_ssh_agent"]:
                # sbx always creates /run/ssh-agent.sock and sets SSH_AUTH_SOCK, so ask the
                # socket itself. Only the classification is printed, never ssh-add's output.
                ra = sbx(cfg, "exec", prof.sandbox, "sh", "-c",
                         "command -v ssh-add >/dev/null 2>&1 || { echo ssh-add-missing; exit 127; }; "
                         "ssh-add -l 2>&1; exit $?", check=False, capture=True)
                chk(classify_ssh_add(ra.returncode, ra.stdout or "") == "none", "no SSH agent forwarded",
                    "restart the sbx daemon from a shell without SSH_AUTH_SOCK: `env -u SSH_AUTH_SOCK sbx daemon stop; env -u SSH_AUTH_SOCK sbx daemon start`")
            if prof.d["skills"] and not prof.skill_problems():
                rs = sbx(cfg, "exec", prof.sandbox, "sh", "-c", skills_check_script(prof.skill_links()),
                         check=False, capture=True)
                for word, sk, why in parse_skill_lines(rs.stdout or "", ("SKILLOK", "SKILLBAD")):
                    hint = ("the folder is not mounted: a new skill set needs `agentbox fresh %s`" if why == "not-mounted"
                            else "`agentbox up %s` links it (a folder of that name in ~/.claude/skills blocks the link)") % n
                    chk(word == "SKILLOK", f"skill {sk} is linked to the mounted set" if word == "SKILLOK"
                        else f"skill {sk} is not linked ({why})", hint)
            if prof.tool_names:
                chk('"ok": true' in out or "pong" in out, "hosttool reaches the bridge",
                    f"is the bridge up? `agentbox up {n}`; check `sbx policy log` for localhost:{prof.port}")
    rep.scope = None
    rep.say("\n" + ("all good" if rep.ok else "problems found"))
    if as_json:
        emit_json(rep.result())
    return EXIT_OK if rep.ok else EXIT_FAIL


# --------------------------------------------------------------- provision
# `agentbox provision <name>`: a guided way to add a profile. It reads the workspace (files only: it
# never runs anything from it, git included), suggests kits and allow-list entries with the reason
# for each, shows the TOML it would add and appends it to the config. The user's file is never
# rewritten: it is backed up, the block is appended, and the whole file is parsed again.
HOST_RE = re.compile(r"^[A-Za-z0-9*][A-Za-z0-9.*-]{0,252}(:\d{1,5})?$")
GITHUB_GIT_RE = re.compile(r"git\+https://(?:www\.)?github\.com", re.I)
GIT_LOCKFILES = ("package.json", "package-lock.json", "yarn.lock", "pnpm-lock.yaml", "poetry.lock",
                 "Pipfile.lock", "uv.lock", "pyproject.toml")
GITHUB_HOSTS = ("github.com", "codeload.github.com", "objects.githubusercontent.com")
MAX_INSTRUCTIONS = 20000
CONTROL_CHARS = re.compile("[\x00-\x08\x0b-\x1f\x7f]")


def toml_str(s: str) -> str:
    """A TOML basic string. json.dumps without ensure_ascii escapes quotes, backslashes and C0
    controls with sequences TOML shares; DEL is the one control it leaves raw, and TOML forbids it."""
    try:
        s.encode("utf-8")
    except UnicodeEncodeError:
        raise ValueError("text that is not valid Unicode (undecodable bytes in a path?)")
    return json.dumps(s, ensure_ascii=False).replace("\x7f", "\\u007f")


def toml_list(items) -> str:
    return "[" + ", ".join(toml_str(x) for x in items) + "]"


def toml_comment(s: str) -> str:
    return "# " + safe_text(s).replace("\n", " ")


def _read_small(p: Path, limit: int = 1 << 20) -> str:
    """Text of a regular file (never a symlink, FIFO or device), at most `limit` bytes; "" otherwise."""
    try:
        if not stat.S_ISREG(os.lstat(p).st_mode):
            return ""
        with open(p, "rb") as f:
            return f.read(limit).decode("utf-8", "replace")
    except OSError:
        return ""


def kit_installed(name: str) -> bool:
    return is_kit_dir(KITS_DIR / name) and not is_v2_kit_dir(KITS_DIR / name)


def detect_workspace(ws: Path) -> dict:
    """What the workspace looks like, from file names and text only. Values are fixed strings."""
    try:
        top = {e.name for e in os.scandir(ws)}
    except OSError:
        top = set()
    py = [n for n in ("pyproject.toml", "setup.py") if n in top] + \
         (["requirements*.txt"] if any(fnmatch.fnmatch(n, "requirements*.txt") for n in top) else [])
    node = ["package.json"] if "package.json" in top else []
    arm = [f"{n} mentions arm-none-eabi" for n in ("CMakeLists.txt", "Makefile", "makefile", "GNUmakefile")
           if n in top and "arm-none-eabi" in _read_small(ws / n)]
    if not arm:
        seen = 0
        skip = DEFAULT_SETTINGS["audit_skip_dirs"]
        for dirpath, dirnames, filenames in os.walk(ws, followlinks=False):
            depth = len(Path(dirpath).relative_to(ws).parts)
            dirnames[:] = [d for d in dirnames if d != ".git" and not any(fnmatch.fnmatch(d, g) for g in skip)] \
                if depth < 4 else []
            seen += len(filenames)
            if any(f.endswith(".ld") for f in filenames):
                arm.append("linker script (*.ld) found")
                break
            if seen > 20000:
                break
    git_urls = []
    for n in sorted(top):
        if (n in GIT_LOCKFILES or fnmatch.fnmatch(n, "requirements*.txt")) and GITHUB_GIT_RE.search(_read_small(ws / n)):
            git_urls.append("requirements*.txt" if n.startswith("requirements") else n)
    return {"python": py, "node": node, "arm": arm, "git_urls": git_urls}


def suggest_settings(found: dict, agent: str, defaults: dict) -> tuple[list, list]:
    """([(kit, reason)], [(allow host, reason)]); kits that are not installed and entries [defaults]
    already has are left out."""
    kits, allow = [], []
    have_k, have_a = set(defaults.get("kits", [])), set(defaults.get("allow", []))
    if found["python"] or found["node"]:
        kits.append(("python-node", ", ".join(found["python"] + found["node"]) + " found"))
    if found["arm"]:
        kits.append(("embedded-arm", found["arm"][0]))
    if agent == "claude":
        kits.append(("claude-team", "model routing and subagents for Claude profiles"))
    kits = [(k, r) for k, r in kits if kit_installed(k) and k not in have_k]
    if found["python"]:
        allow += [("pypi.org", "Python packages (" + ", ".join(found["python"]) + ")"),
                  ("files.pythonhosted.org", "Python package downloads")]
    if found["node"]:
        allow.append(("registry.npmjs.org", "Node packages (package.json)"))
    if found["git_urls"]:
        allow += [(h, "git+https GitHub URL in " + ", ".join(found["git_urls"])) for h in GITHUB_HOSTS]
    return kits, [(h, r) for h, r in allow if h not in have_a]


def agent_config_warnings(root: Path) -> list[str]:
    """Files in a workspace that an agent in the sandbox loads or can change, and that run code or
    steer an agent on the host. Read-only; the caller prints them with safe_text."""
    out = []
    for n in ("CLAUDE.md", "AGENTS.md"):
        if os.path.lexists(root / n):
            out.append(f"{n}: the agent loads it as instructions and can edit it")
    cdir = root / ".claude"
    try:
        names = sorted(e.name for e in os.scandir(cdir) if fnmatch.fnmatch(e.name, "settings*.json"))
    except OSError:
        names = []
    for n in names:
        try:
            data = json.loads(_read_small(cdir / n))
        except (ValueError, RecursionError):
            data = None
        hooks = isinstance(data, dict) and bool(data.get("hooks"))
        out.append(f".claude/{n}: " + ("DEFINES HOOKS (commands that run whenever Claude Code starts here, "
                                      "also on your Mac)" if hooks else "no hooks")
                   + (" - could not be parsed" if data is None else "") + "; the agent can edit it")
    if os.path.lexists(root / ".mcp.json"):
        out.append(".mcp.json: MCP servers are started as commands by the agent that loads it; the agent can edit it")
    for n in ("tasks.json", "launch.json"):
        if os.path.lexists(root / ".vscode" / n):
            out.append(f".vscode/{n}: VS Code runs these on your Mac when you use them; the agent can edit it")
    gd = git_dir_of(root)
    try:
        hooks = sorted(e.name for e in os.scandir(gd / "hooks") if e.is_file() and not e.name.endswith(".sample")) if gd else []
    except OSError:
        hooks = []
    if hooks:
        out.append(f".git/hooks: {_capped(hooks, 10)} - hooks run on the host when you commit")
    risky = risky_git_config(root)
    if risky:
        extra = " (a repo-level core.hooksPath overrides any global one)" if any("hookspath" in r.lower() for r in risky) else ""
        out.append("git config entries that can run commands" + extra + ": " + "; ".join(risky[:10]))
    return out


def workspace_problems(cfg: Config, p: Path) -> list[str]:
    """Why a folder must not be mounted: it holds (or sits inside) what must stay out of the agent's reach."""
    bad = []
    for what, x in (("the agentbox config", CONFIG_FILE), ("the kits dir", KITS_DIR),
                    ("the state dir", cfg.state_root), ("~/.claude", HOME / ".claude")):
        if is_within(x.resolve(), p):
            bad.append(f"contains {what} ({x})")
    for what, x in (("the config dir", CONFIG_DIR), ("~/.claude", HOME / ".claude")):
        if is_within(p, x.resolve()):
            bad.append(f"is inside {what} ({x})")
    return bad


def profile_block(name: str, d: dict, notes: dict) -> str:
    """The TOML to append. `d` holds only what to write; `notes` maps a key to its reason lines."""
    lines = [toml_comment(f"added by `agentbox provision` on {time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())}"),
             f"[profiles.{name}]"]
    for key in ("agent", "workspace", "mode"):
        lines.append(f"{key} = {toml_str(d[key])}")
    for key in ("extra_workspaces", "kits", "skills", "allow"):
        if d.get(key):
            lines += [toml_comment(n) for n in notes.get(key, [])]
            lines.append(f"{key} = {toml_list(d[key])}")
    lm = d.get("local_model")
    if lm:
        lines += [toml_comment(n) for n in notes.get("local_model", [])]
        lines.append(f"local_model = {{ provider = {toml_str(lm['provider'])}, model = {toml_str(lm['model'])},"
                     f" port = {int(lm['port'])} }}")
    if d.get("instructions"):
        lines.append("instructions = '''\n" + d["instructions"] + "'''")
    return "\n".join(lines) + "\n"


def check_instructions(text: str) -> str:
    text = text.replace("\r\n", "\n")
    if "'''" in text:
        raise ValueError("instructions must not contain ''' (it would end the TOML literal string)")
    if CONTROL_CHARS.search(text):
        raise ValueError("instructions must not contain control characters (other than newline and tab)")
    if len(text) > MAX_INSTRUCTIONS:
        raise ValueError(f"instructions are over {MAX_INSTRUCTIONS} characters")
    return text


def append_profile(name: str, block: str, expected: dict) -> Path:
    """Back up the config (0600), append the block after a blank line, parse the whole file again and
    check the new table says what we meant. Any failure restores the original bytes and dies."""
    orig = CONFIG_FILE.read_bytes()
    stamp = time.strftime("%Y%m%dT%H%M%SZ", time.gmtime())
    backup = CONFIG_FILE.with_name(f"{CONFIG_FILE.name}.bak-{stamp}")
    for n in range(1, 100):
        try:
            fd = os.open(backup, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
            break
        except FileExistsError:
            backup = CONFIG_FILE.with_name(f"{CONFIG_FILE.name}.bak-{stamp}-{n}")
    else:
        die("could not create a backup file", EXIT_FAIL)
    with os.fdopen(fd, "wb") as f:
        f.write(orig)

    def restore(why: str):
        CONFIG_FILE.write_bytes(orig)
        die(f"{why}; {CONFIG_FILE} restored from the backup {backup}")

    sep = b"" if not orig or orig.endswith(b"\n") else b"\n"
    with open(CONFIG_FILE, "ab") as f:
        f.write(sep + b"\n" + block.encode("utf-8"))
    try:
        parsed = tomllib.loads(CONFIG_FILE.read_text(encoding="utf-8"))
    except (tomllib.TOMLDecodeError, UnicodeDecodeError) as e:
        restore(f"the config no longer parses ({e})")
    got = parsed.get("profiles", {}).get(name)
    if not isinstance(got, dict) or any(got.get(k) != v for k, v in expected.items()):
        restore("the new profile does not read back as intended")
    return backup


def cmd_provision(cfg: Config, args) -> int:
    name, yes = args.name, args.yes

    def fail(msg):
        die(msg, EXIT_USAGE)

    if not yes and not sys.stdin.isatty():
        fail("no terminal to ask on: pass --yes to take the defaults (and flags for anything else)")

    def pick(label, given, default, validate, flag):
        """Value from the flag, the default (--yes) or the user; validate(text) -> value or ValueError."""
        if given is not None or yes:
            raw = given if given is not None else default
            if raw is None:
                fail(f"{label} is required: pass {flag}")
            try:
                return validate(raw)
            except ValueError as e:
                fail(f"{flag}: {e}")
        while True:
            try:
                raw = input(f"{label}" + (f" [{default}]" if default not in (None, "") else "") + ": ").strip()
            except EOFError:
                fail("input ended")
            raw = raw or (default if default is not None else "")
            try:
                return validate(raw)
            except ValueError as e:
                print(f"  {safe_text(e)}")

    def say(text=""):
        print(safe_text(text))

    # --- name
    if not NAME_RE.match(name):
        fail(f"profile name '{safe_text(name)}' must match {NAME_RE.pattern}")
    if name in cfg.raw.get("profiles", {}):
        fail(f"profile '{name}' already exists in {CONFIG_FILE}")
    sandbox = f"{cfg.settings['name_prefix']}-{name}"
    states = sandbox_states(cfg)
    if states is None:
        info("WARNING: `sbx ls --json` failed: could not check for an existing sandbox of that name")
    elif sandbox in states:
        fail(f"a sandbox named {sandbox} already exists ({states[sandbox]}): pick another name, or `sbx rm {sandbox}`")
    defaults = cfg.raw.get("defaults", {}) if isinstance(cfg.raw.get("defaults"), dict) else {}

    # --- workspace
    def v_workspace(raw):
        p = xp(raw)
        if not p.is_dir():
            raise ValueError(f"{p} is not a folder")
        bad = workspace_problems(cfg, p)
        if bad:
            raise ValueError(f"{p} " + "; ".join(bad))
        toml_str(str(p))
        return p
    cwd = Path.cwd()
    ws = pick("Workspace", args.workspace, str(cwd) if git_dir_of(cwd) is not None else None, v_workspace, "--workspace")

    # --- agent
    def v_agent(raw):
        if raw not in BUILTIN_AGENTS and not kit_installed(raw):
            raise ValueError(f"'{raw}' is neither a built-in agent nor a kit in {KITS_DIR}")
        return raw
    agent = pick("Agent (claude|copilot|codex|gemini|opencode|shell|<kit>)", args.agent, "claude", v_agent, "--agent")

    # --- local model (opencode only, for now)
    local_model = None
    if args.local_model is not None and agent not in LOCAL_MODEL_AGENTS:
        fail(f"--local-model works with --agent {' or '.join(sorted(LOCAL_MODEL_AGENTS))} only (agent is '{agent}')")
    if agent in LOCAL_MODEL_AGENTS:
        want = args.local_model is not None
        if not want and not yes:
            say("\nopencode can use a model served by Ollama on this machine. The sandbox then may reach that one\n"
                "port on your localhost (and nothing else on it). Small local models are much weaker agents than Claude.")
            want = input("Use a local Ollama model? [y/N]: ").strip().lower() in ("y", "yes")
        if want:
            def v_port(raw):
                try:
                    port = int(str(raw))
                except ValueError:
                    raise ValueError("must be a number")
                if not 1 <= port <= 65535:
                    raise ValueError("must be from 1 to 65535")
                return port
            port = pick("Ollama port", args.local_model_port, LOCAL_MODEL_PROVIDERS["ollama"], v_port,
                        "--local-model-port")
            tool_models = ollama_tool_models(port)
            if tool_models is None:
                say(f"  Ollama does not answer on 127.0.0.1:{port} (start it to see your models; `doctor` checks again)")
            elif tool_models:
                for m in tool_models:
                    say(f"  suggest {m}: installed, supports tool calls")
            else:
                say("  none of your Ollama models reports tool support: `ollama pull` one that does")

            def v_model(raw):
                if not LOCAL_MODEL_RE.match(raw):
                    raise ValueError(f"'{raw}' is not an Ollama model name")
                return raw
            model = pick("Model", args.local_model, (tool_models or [None])[0], v_model, "--local-model")
            local_model = {"provider": "ollama", "model": model, "port": port}
            problems = local_model_problems(cfg, {"agent": agent, "local_model": local_model})
            if problems:
                fail("; ".join(problems))

    # --- what the workspace looks like
    found = detect_workspace(ws)
    kit_sug, allow_sug = suggest_settings(found, agent, defaults)
    warnings = [(r, w) for r in [ws] for w in agent_config_warnings(r)]

    # --- mode
    if args.mode is None and not yes:
        say("\nHost tools (flashing, debugging on your Mac) need mode = direct; otherwise clone is safer.")
        hosttools = input("Will this profile use host tools? [y/N]: ").strip().lower() in ("y", "yes")
    else:
        hosttools = False
    def v_mode(m):
        if m not in ("clone", "direct"):
            raise ValueError("must be clone or direct")
        return m
    mode = pick("Mode (clone|direct)", args.mode, "direct" if hosttools else "clone", v_mode, "--mode")
    if mode == "direct":
        say("\nmode = direct: the agent edits your host tree and .git/ directly. A hook, build file or config it\n"
            f"changes can run on your Mac later, so run `agentbox audit {name}` after every session.")

    # --- lists
    def _checked(validate, x, flag):
        try:
            return validate(x)
        except ValueError as e:
            fail(f"{flag}: {e}")

    def pick_list(label, given, sug, validate, flag):
        if given is not None:
            return [_checked(validate, x, flag) for x in given]
        for v, why in sug:
            say(f"  suggest {v}: {why}")
        default = [v for v, _ in sug]
        if yes:
            return default
        raw = input(f"{label} (Enter = {', '.join(default) or 'none'}; 'none'; or comma-separated): ").strip()
        if not raw:
            return default
        return [] if raw.lower() == "none" else [_checked(validate, x.strip(), flag) for x in raw.split(",") if x.strip()]

    def v_kit(k):
        if not kit_installed(k) and not is_kit_dir(xp(k)):
            raise ValueError(f"kit '{k}' not found in {KITS_DIR}")
        return k

    def v_host(h):
        if not HOST_RE.match(h):
            raise ValueError(f"'{h}' is not a host name")
        return h

    def v_skill(s):
        if s not in cfg.skillsets:
            raise ValueError(f"unknown skill set '{s}'. Known: {', '.join(cfg.skillsets) or '(none)'}")
        return s

    say("\nKits:")
    kits = pick_list("Kits", args.kit, kit_sug, v_kit, "--kit")
    say("\nNetwork (extra hosts the sandbox may reach):")
    allow = pick_list("Allow", args.allow, allow_sug, v_host, "--allow")
    skill_default = [x for x in defaults.get("skills", []) if isinstance(x, str)]
    if args.skills is not None:
        skills = [_checked(v_skill, x, "--skills") for x in args.skills]
    elif yes or not cfg.skillsets:
        skills = []
    else:
        say("\nSkill sets" + (f" ([defaults] already applies: {', '.join(skill_default)})" if skill_default else "") + ":")
        for sname in cfg.skillsets:
            say(f"  available {sname}: {len(inspect_skillset(cfg, sname).skills)} skill(s)")
        raw = input("Skill sets (comma-separated, Enter = none): ").strip()
        skills = [_checked(v_skill, x.strip(), "--skills") for x in raw.split(",") if x.strip()]

    def v_extra(spec):
        p, ro = parse_workspace_spec(spec)
        if not p.is_dir():
            raise ValueError(f"{p} is not a folder")
        bad = workspace_problems(cfg, p)
        if bad:
            raise ValueError(f"{p} " + "; ".join(bad))
        return f"{p}{':ro' if ro else ''}"
    if args.extra is not None:
        extras = [_checked(v_extra, x, "--extra") for x in args.extra]
    elif yes:
        extras = []
    else:
        raw = input("Extra folders (comma-separated; add :ro for read-only; Enter = none): ").strip()
        extras = [_checked(v_extra, x.strip(), "--extra") for x in raw.split(",") if x.strip()]
    for p, _ in (parse_workspace_spec(x) for x in extras):
        warnings += [(p, w) for w in agent_config_warnings(p)]

    if args.instructions is not None:
        instr = _checked(check_instructions, args.instructions, "--instructions")
    elif yes:
        instr = ""
    else:
        instr = _checked(check_instructions, input("Instructions for the agent (one line, Enter = none): ").strip(), "--instructions")

    # --- warnings, then the block
    if warnings:
        say("\nWARNING - files here that an agent in the sandbox loads or could change (not blocking):")
        for root, w in warnings:
            say(f"  {root}: {w}")
    d = {"agent": agent, "workspace": str(ws), "mode": mode, "extra_workspaces": extras,
         "kits": [k for k in kits if k not in defaults.get("kits", [])],
         "skills": [s for s in skills if s not in skill_default],
         "allow": [h for h in allow if h not in defaults.get("allow", [])], "instructions": instr}
    notes = {"kits": [f"{k}: {r}" for k, r in kit_sug if k in d["kits"]],
             "allow": [f"{h}: {r}" for h, r in allow_sug if h in d["allow"]],
             "local_model": ["opencode uses this Ollama model on the host; the sandbox may reach that port"
                             " (`agentbox doctor` checks it)"]}
    if local_model:
        d["local_model"] = local_model
    try:
        block = profile_block(name, d, notes)
    except ValueError as e:
        fail(str(e))
    say("\nThis profile will be added to " + str(CONFIG_FILE) + ":\n")
    say(block)
    say("host_tools are not set up here: add `host_tools` and `host_tools_port` by hand "
        "(README, section 5 \"Host tools\"). No port was chosen.")
    if args.dry_run:
        say("\n--dry-run: nothing was changed.")
        return EXIT_OK
    if not yes and input("Add this profile? [y/N]: ").strip().lower() not in ("y", "yes"):
        say("Nothing changed.")
        return EXIT_OK

    # --- write, re-read, build the Profile
    expected = {k: v for k, v in d.items() if v not in ("", [])}
    backup = append_profile(name, block, expected)
    try:
        cfg2 = Config()
        prof = cfg2.profile(name)
    except SystemExit:
        CONFIG_FILE.write_bytes(backup.read_bytes())
        die(f"the new profile does not pass the normal checks; {CONFIG_FILE} restored from {backup}")
    say(f"\nAdded profile '{name}' (backup of the old config: {backup}).\n\nChecks (agentbox doctor {name}):")
    rc = cmd_doctor(cfg2, name)
    say(f"\nNext:\n  agentbox up {name}\n  agentbox run {name} --prompt-file task.md --detach")
    if args.up:
        if rc != 0:
            info("not starting the sandbox: doctor found problems")
            return rc
        if prof.d["skills"]:
            prof.require_skills()
        return cmd_up(prof, argparse.Namespace(agent_args=[]))
    return rc


# ------------------------------------------------------------ skill for agents on the host
# The guide ships with agentbox (share/skill/guide.md) and `skill show` prints it. `skill setup` only
# writes a small SKILL.md stub that tells the agent to run `skill show`, so upgrading agentbox updates
# what agents are told without touching their skill folders. A stub carries SKILL_MARKER; a file
# without it was not written by agentbox and is never overwritten or removed ("foreign").
SKILL_GUIDE = SHARE_DIR / "skill" / "guide.md"
SKILL_MARKER = "<!-- agentbox-skill-stub:"
SKILL_STUB = f"""---
name: agentbox
description: Drive agentbox from the host - set up sandbox profiles, write task briefs, start and watch \
sandboxed agent jobs, fetch their commits for review. Use when the user mentions agentbox, a sandbox, sbx, \
or asks to "run this in a box".
---
{SKILL_MARKER} written by `agentbox skill setup`; edits are overwritten, `agentbox skill remove` deletes it -->

# agentbox

Before doing anything with agentbox, run this and follow what it prints:

```bash
agentbox skill show
```

It prints the owner's ground rules and how to use agentbox from the host, for the installed version.
If `agentbox` is not on PATH, try `~/.local/bin/agentbox skill show`.
"""


def skill_locations() -> list[tuple[str, Path]]:
    """(label, SKILL.md path) per place an agent looks for user skills; read from the environment on each call."""
    home = Path.home()
    claude = os.environ.get("CLAUDE_CONFIG_DIR")
    locs = [("claude", Path(claude).expanduser() if claude else home / ".claude"),
            ("agents", home / ".agents")]               # Codex, OpenCode, Pi
    codex = os.environ.get("CODEX_HOME")
    if codex:                                           # Codex also reads $CODEX_HOME/skills
        locs.append(("codex", Path(codex).expanduser()))
    return [(label, base / "skills" / "agentbox" / "SKILL.md") for label, base in locs]


def skill_state(path: Path) -> str:
    """current | outdated | missing | foreign. A symlink (the file or its folder) is never ours."""
    if path.parent.is_symlink() or path.is_symlink():
        return "foreign"
    if not path.exists():
        return "missing"
    try:
        text = path.read_text(errors="replace") if path.is_file() else ""
    except OSError:
        return "foreign"
    if SKILL_MARKER not in text:
        return "foreign"
    return "current" if text == SKILL_STUB else "outdated"


def skill_rows() -> list[dict]:
    return [{"agent": label, "path": str(p), "state": skill_state(p)} for label, p in skill_locations()]


def write_skill_stub(path: Path):
    path.parent.mkdir(parents=True, exist_ok=True)
    write_text_atomic(path, SKILL_STUB, mode=0o644)     # agents read it; nothing in it is private


def cmd_skill(args) -> int:
    if args.action == "show":
        try:
            sys.stdout.write(SKILL_GUIDE.read_text())
        except OSError as e:
            die(f"cannot read the guide at {SKILL_GUIDE}: {e.strerror} - reinstall agentbox")
        return EXIT_OK
    if args.action == "status":
        rows = skill_rows()
        if args.json:
            emit_json({"guide": str(SKILL_GUIDE), "locations": rows})
        else:
            for r in rows:
                print(f"{r['agent']:<7} {r['state']:<9} {r['path']}")
        return EXIT_OK
    rc = EXIT_OK
    for label, path in skill_locations():
        state = skill_state(path)
        if state == "foreign":
            info(f"{label}: left alone (foreign: not written by agentbox) {path}")
        elif args.action == "setup":
            if state == "current":
                print(f"{label}: current {path}")
                continue
            try:
                write_skill_stub(path)
            except OSError as e:
                info(f"{label}: cannot write {path}: {e.strerror}")
                rc = EXIT_FAIL
                continue
            print(f"{label}: {'installed' if state == 'missing' else 'updated'} {path}")
        elif state == "missing":
            print(f"{label}: not installed {path}")
        else:
            path.unlink()
            with contextlib.suppress(OSError):
                path.parent.rmdir()             # only if empty: other files there aren't ours
            print(f"{label}: removed {path}")
    return rc


def main():
    ap = argparse.ArgumentParser(prog="agentbox", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    p = sub.add_parser("up"); p.add_argument("profile"); p.add_argument("agent_args", nargs="*")
    for c in ("shell", "audit", "stop", "bridge"):
        sub.add_parser(c).add_argument("profile")
    p = sub.add_parser("tools"); p.add_argument("profile"); p.add_argument("--json", action="store_true")
    p = sub.add_parser("down"); p.add_argument("profile"); p.add_argument("--keep-state", action="store_true")
    p.add_argument("--force", action="store_true", help="also drop clone-mode work the host lacks, kill a running headless job, skip sbx's"
                   " confirmation and pass --force to `sbx rm`, which deletes the sandbox even if in use"
                   " (an open VS Code / SSH session)")
    p = sub.add_parser("template", help="prebuild a sandbox image with the profile's kits installed")
    p.add_argument("profile")
    p.add_argument("--remove", action="store_true", help="delete the profile's prebuilt template")
    p = sub.add_parser("fresh"); p.add_argument("profile"); p.add_argument("agent_args", nargs="*")
    p.add_argument("--force", action="store_true", help="as for `down --force`: drop clone-mode work the host"
                   " lacks, kill a running job, skip confirmation, delete the sandbox even if in use")
    p = sub.add_parser("run"); p.add_argument("profile")
    g = p.add_mutually_exclusive_group(required=True)
    g.add_argument("--prompt-file", metavar="F", help="file holding the prompt ('-' = stdin)")
    g.add_argument("--prompt", metavar="TEXT", help="prompt text (visible in your host's process list; prefer --prompt-file)")
    p.add_argument("--detach", action="store_true", help="start the job and return")
    p.add_argument("--expect-commits", type=int, metavar="N", help="show 'commits k/N' in `progress`")
    p.add_argument("--no-progress", action="store_true",
                   help="do not give the agent the jobprogress reporter or the prompt paragraph about it")
    p.add_argument("--keepalive", action=argparse.BooleanOptionalAction, default=None,
                   help="hold an exec session open while the job runs (default: on; sbx stops idle sandboxes)")
    p.add_argument("--agent-args", nargs=argparse.REMAINDER, default=[], help="extra agent arguments (rest of the line)")
    p = sub.add_parser("wait"); p.add_argument("profile"); p.add_argument("--job")
    p.add_argument("--timeout", type=float, metavar="S")
    p = sub.add_parser("logs"); p.add_argument("profile"); p.add_argument("--job")
    p.add_argument("-f", "--follow", action="store_true"); p.add_argument("--raw", action="store_true")
    p.add_argument("--start", action="store_true", help="boot the sandbox if it is stopped")
    p = sub.add_parser("resume"); p.add_argument("profile"); p.add_argument("--job")
    p = sub.add_parser("progress"); p.add_argument("profile"); p.add_argument("--job")
    p.add_argument("--watch", action="store_true", help="redraw until the job ends; exit with its status")
    p.add_argument("--interval", type=float, default=5.0, metavar="S", help="seconds between --watch updates (default 5)")
    p.add_argument("--json", action="store_true", help="print the job.progress object of `status --json`")
    p = sub.add_parser("fetch", help="clone mode: fetch the agent's commits into a review branch (never merges)")
    p.add_argument("profile")
    p.add_argument("--ref", metavar="REF", help="branch to fetch from the sandbox (default: the branch the latest"
                   " job ended on, else main)")
    p.add_argument("--branch", metavar="B", help="review branch to fetch into (default: review/<profile>-<ref> for"
                   " a job's branch, review/<profile> for main)")
    p.add_argument("--start", action="store_true", help="boot the sandbox if it is stopped")
    p.add_argument("--force", action="store_true", help="overwrite the review branch even if not a fast-forward")
    p.add_argument("--json", action="store_true")
    sub.add_parser("keepalive", help=argparse.SUPPRESS).add_argument("profile")
    p = sub.add_parser("code"); p.add_argument("profile"); p.add_argument("path", nargs="?")
    p = sub.add_parser("status"); p.add_argument("--json", action="store_true")
    p = sub.add_parser("dashboard", help="live overview of the running sandboxes: uptime, idle, tokens, cpu, memory")
    p.add_argument("--watch", action="store_true", help="redraw until interrupted")
    p.add_argument("-i", "--interactive", action="store_true",
                   help="full-screen view of every profile: select one, watch its job, read its log, fetch (? for keys)")
    p.add_argument("--interval", type=float, default=5.0, metavar="S",
                   help="seconds between --watch / --interactive updates (default 5)")
    p.add_argument("--json", action="store_true")
    p = sub.add_parser("history", help="the jobs each profile ran, newest first: branch, cost, the brief's title")
    p.add_argument("profile", nargs="?"); p.add_argument("--json", action="store_true")
    p = sub.add_parser("review", help="clone mode: review the agents' branches like a pull request, and merge them"
                       " (the owner's tool; agents never run it)")
    p.add_argument("profile", nargs="?")
    p.add_argument("--json", action="store_true", help="the items and their statuses, no diff")
    p = sub.add_parser("doctor"); p.add_argument("profile", nargs="?"); p.add_argument("--json", action="store_true")
    p.add_argument("--start", action="store_true", help="also check inside a stopped sandbox (boots it)")
    p = sub.add_parser("provision", help="guided setup of a new profile"); p.add_argument("name")
    p.add_argument("--workspace"); p.add_argument("--agent"); p.add_argument("--mode", choices=("clone", "direct"))
    for flag in ("kit", "skills", "allow", "extra"):
        p.add_argument(f"--{flag}", action="append")
    p.add_argument("--instructions")
    p.add_argument("--local-model", metavar="MODEL", help="opencode: use this Ollama model on the host")
    p.add_argument("--local-model-port", metavar="PORT", help="the host's Ollama port (default 11434)")
    p.add_argument("--yes", action="store_true", help="take every default, never prompt")
    p.add_argument("--dry-run", action="store_true", help="print the TOML block, change nothing")
    p.add_argument("--up", action="store_true", help="start the sandbox afterwards")
    p = sub.add_parser("rex", help="the agentbox actions in Rex's command palette (~/.config/rex/init.lua)")
    p.add_argument("action", choices=("setup", "status", "remove"),
                   help="setup: add our block to init.lua; status; remove: delete our block")
    p.add_argument("--json", action="store_true", help="status: one JSON document")
    p = sub.add_parser("vscode", help="the agentbox dashboard extension for the host's VS Code")
    p.add_argument("action", choices=("install", "status", "uninstall"),
                   help="install (or update) it, show whether it is current, or remove it")
    p.add_argument("--json", action="store_true", help="status: one JSON document")
    p = sub.add_parser("skill", help="the agentbox skill for agents on this machine (Claude Code, Codex, OpenCode, Pi)")
    p.add_argument("action", choices=("show", "setup", "status", "remove"),
                   help="show: print the guide; setup: install SKILL.md stubs; status; remove: delete our stubs")
    p.add_argument("--json", action="store_true", help="status: one JSON document")
    a = ap.parse_args()

    if a.cmd == "rex":       # host-side only: touches no sandbox
        if a.json and a.action != "status":
            die("--json is only for `rex status`", EXIT_USAGE)
        sys.exit(cmd_rex(a))
    if a.cmd == "vscode":    # host-side only: touches no sandbox
        if a.json and a.action != "status":
            die("--json is only for `vscode status`", EXIT_USAGE)
        sys.exit(cmd_vscode(a))
    if a.cmd == "skill":     # host-side only: needs no config and touches no sandbox
        if a.json and a.action != "status":
            die("--json is only for `skill status`", EXIT_USAGE)
        sys.exit(cmd_skill(a))
    os.umask(0o077)          # everything agentbox creates (token, kit, logs) is owner-only
    cfg = Config()
    secure_state(cfg)
    if a.cmd == "status":
        sys.exit(cmd_status(cfg, a.json))
    if a.cmd == "dashboard":
        sys.exit(cmd_dashboard(cfg, a))
    if a.cmd == "doctor":
        sys.exit(cmd_doctor(cfg, a.profile, a.json, a.start))
    if a.cmd == "history":
        sys.exit(cmd_history(cfg, a.profile, a.json))
    if a.cmd == "review":
        sys.exit(cmd_review(cfg, a.profile, a.json))
    if a.cmd == "provision":
        sys.exit(cmd_provision(cfg, a))
    prof = cfg.profile(a.profile)
    if a.cmd in ("up", "code", "fresh", "run", "resume") and not prof.enabled:
        die(f"profile '{a.profile}' is disabled (enabled = false in agentbox.toml); enable it to use `{a.cmd}`", EXIT_USAGE)
    if a.cmd in ("up", "fresh", "code", "run", "resume", "shell") and prof.d["skills"]:
        prof.require_skills()               # before `fresh` tears anything down
    if a.cmd == "up":
        sys.exit(cmd_up(prof, a))
    if a.cmd == "fresh":
        a.keep_state = False
        a.keep_sessions = True          # a fresh VM, the same conversations
        cmd_down(prof, a)
        sys.exit(cmd_up(cfg.profile(a.profile), a))
    if a.cmd == "down":
        sys.exit(cmd_down(prof, a))
    if a.cmd == "code":
        sys.exit(cmd_code(prof, a))
    if a.cmd == "audit":
        sys.exit(cmd_audit(prof))
    if a.cmd == "run":
        sys.exit(cmd_run(prof, a))
    if a.cmd == "wait":
        sys.exit(cmd_wait(prof, a))
    if a.cmd == "logs":
        sys.exit(cmd_logs(prof, a))
    if a.cmd == "resume":
        sys.exit(cmd_resume(prof, a))
    if a.cmd == "progress":
        sys.exit(cmd_progress(prof, a))
    if a.cmd == "fetch":
        sys.exit(cmd_fetch(prof, a))
    if a.cmd == "template":
        sys.exit(cmd_template(prof, a))
    if a.cmd == "keepalive":
        sys.exit(cmd_keepalive(prof))
    if a.cmd == "shell":
        if not sandbox_exists(prof):
            die(f"sandbox {prof.sandbox} not found - run `agentbox up {prof.name}` first", EXIT_NO_SANDBOX)
        start_bridge(prof)
        sync_skills(prof)
        sys.exit(sbx(cfg, "exec", "-it", prof.sandbox, "bash", check=False).returncode)
    if a.cmd == "stop":
        stop_bridge(prof)
        stop_keepalive(prof)
        if not sandbox_exists(prof):
            die(f"sandbox {prof.sandbox} not found", EXIT_NO_SANDBOX)
        sys.exit(sbx(cfg, "stop", prof.sandbox, check=False).returncode)
    if a.cmd == "tools":
        sys.exit(cmd_tools(prof, a.json))
    if a.cmd == "bridge":
        Bridge(prof).serve()


if __name__ == "__main__":
    main()
