    "name_prefix": "ab",
    "state_dir": "~/.local/state/agentbox",
    "forward_ssh_agent": False,
    "verbose": False,
    "vscode": "code",           # VS Code CLI; falls back to the app bundle on macOS
    "audit_globs": [
        ".git/config", ".git/hooks/*", ".gitmodules", ".gitattributes",
        "Makefile", "makefile", "GNUmakefile", "*.mk", "**/*.mk",
        "CMakeLists.txt", "**/CMakeLists.txt", "CMakePresets.json",
        "CMakeUserPresets.json", "*.cmake", "**/*.cmake",
        ".vscode/*", ".idea/*", ".idea/**/*", ".envrc", ".env", ".env.*",
        ".github/workflows/*", ".gitlab-ci.yml", ".pre-commit-config.yaml",
        ".gdbinit", "**/.gdbinit", "*.cfg", "openocd*.cfg",
        ".claude/*", ".claude/**/*", ".mcp.json", "CLAUDE.md", "AGENTS.md",
        ".junie/*", ".junie/**/*", ".github/copilot-instructions.md",
        "sbxenv.yaml", ".sbxenv.yaml", ".sbx/**/*", ".devcontainer/*",
        "package.json", "pyproject.toml", "setup.py", "tasks.py", "justfile",
    ],
    "audit_skip_dirs": ["build", "Build", "cmake-build-*", "node_modules",
                        ".venv", "venv", "dist", "target", "Debug", "Release"],
}

DEFAULT_PROFILE = {
    "enabled": True,            # false = template: doctor/status skip it, up/code/fresh refuse it
    "agent": "claude",
    "workspace": None,
    "extra_workspaces": [],
    "mode": "direct",           # direct | clone
    "template": "",
    "kits": [],
    "skills": [],               # [skillsets.*] names; read-only host folders of agent skills
    "allow": [],
    "deny": [],
    "env": {},
    "secrets": [],
    "host_tools": [],
    "host_tools_port": 0,
    "publish": [],
    "agent_args": [],
    "instructions": "",
    "vscode": False,            # allow the hosts VS Code's remote server + extensions need
    "confirm_host_tools": False,  # ask on the host (macOS dialog) before every host-tool call
    "stall_after": 300,         # `progress`/`status`: a running job with no event for this many seconds is STALLED
    "keepalive": True,          # headless jobs: hold an `sbx exec` session open while a job runs (sbx stops idle sandboxes)
}

