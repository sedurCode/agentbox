# PATH for host tools: fixed, never the caller's. System directories come first so a user-writable
# directory (~/.local/bin: pip --user, pipx, cargo...) can never shadow git, make or python3; it is last.
# Directories that don't exist are skipped.
HOST_TOOL_PATH = ":".join(d for d in (
    "/opt/homebrew/bin", "/home/linuxbrew/.linuxbrew/bin", "/usr/local/bin", "/usr/bin", "/bin",
    "/usr/sbin", "/sbin", "/snap/bin", str(HOME / ".local" / "bin")) if os.path.isdir(d))
MERGED_LISTS = ("allow", "deny", "kits", "skills")   # defaults + profile are unioned

